#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "تازگی گردآوری داده‌ها و نمودارهای دستگاه را بررسی کنید. تلاش دوباره، توقف گردآوری را برای اجرای زمان‌بندی‌شده بعدی آزاد می‌کند؛ اکنون با BMC ارتباط برقرار نمی‌کند."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "فایل خالی یا بزرگ‌تر از 1 MiB است."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "خواندن فایل انجام نشد."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "فایل ردیف سرستون ندارد."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "فایل دارای ستونی با نام «%s» است. فایل‌های درون‌بری نباید حاوی اسرار باشند؛ در عوض نام یک اعتبارنامه ذخیره‌شده را در ستون credential بنویسید. هیچ موردی درون‌بری نشد."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "سرستون باید تنها این ستون‌ها را، هر کدام یک بار، شامل name، address و credential نام ببرد: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "فایل بیش از %d ردیف دارد."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "خط %d: انتظار %d فیلد می‌رفت، %d فیلد یافت شد."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "اعتبارنامه: هیچ اعتبارنامه ذخیره‌شده‌ای با نام «%s» وجود ندارد."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "خط %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "خط %d: نشانی %s درگاه %d از قبل با نام %s ثبت شده است."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "خط %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "سطر %d: نام %s از قبل استفاده شده است."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "سطر %d: هیچ دستگاه Cacti با شناسه %d وجود ندارد."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "سطر %d: دستگاه %d از قبل دارای BMC با نام %s است."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "از سطر %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "فایل هیچ ردیف BMC ندارد."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "نام: بین 1 تا 100 نویسه بدون نویسه‌های کنترلی وارد کنید."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "نشانی: فقط یک نام میزبان یا نشانی IP بدون طرحواره، درگاه، مسیر یا نام کاربری وارد کنید. نشانی‌های حلقه بازگشتی، پیوند-محلی، چندپخشی و نامشخص پذیرفته نمی‌شوند."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "درگاه: یک درگاه TCP از 1 تا 65535 وارد کنید."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "نظرسنج: در این نسخه فقط نظرسنج اصلی می‌تواند BMCها را گردآوری کند."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "دستگاه: یک دستگاه Cacti یا گزینه هیچ‌کدام را انتخاب کنید."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "اعتبارنامه: یک اعتبارنامه ذخیره‌شده انتخاب کنید."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "راستی‌آزمایی TLS: یکی از حالت‌های فهرست‌شده را انتخاب کنید."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "فایل بسته CA: یک مسیر مطلق بدون نویسه‌های کنترلی و حداکثر 512 نویسه وارد کنید."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "پین کلید عمومی: درهم‌سازی SHA-256 با کدگذاری base64 کلید عمومی BMC را وارد کنید؛ در صورت تمایل می‌توانید پیشوند sha256// را در ابتدا قرار دهید."

