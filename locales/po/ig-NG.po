msgstr "E hichapụrụ BMC ahụ na data ya echekwara na cache. A hapụrụ ngwaọrụ Cacti ya n'ọnọdụ ya."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "E wepụrụ nkwụsịtụ na ọdịda ndị e jidere; onye nchịkọta na-agụ BMC na ọsọ ya na-esote."

#: redfish_bmcs.php
