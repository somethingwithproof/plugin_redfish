msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Onye nchịkọta dị na poller %d agwụla oge tupu a gụọ BMC ọ bụla; ndị fọdụrụ ga-amaliteghachi na ọsọ na-esote. Tinye ndị ọrụ ma ọ bụ bulie oke oge."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Onye nchịkọta dị na poller %d rụrụ ọrụ ikpeazụ %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: agbanyụrụ nkwenye TLS. Onye ọ bụla nọ n'ụzọ nwere ike ịgụ okporo ụzọ ya, gụnyere okwuntụghe BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: na-eji nkwenye Basic n'ihi na BMC anaghị enye ọrụ oge nnọkọ; arịrịọ ọ bụla na-ebu okwuntụghe ahụ."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: o nwere ike ịbụ na a hapụrụ oge nnọkọ mepere emepe na BMC; ọsọ na-esote na-ehichapụ ya mgbe ọ banyechara."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: nbanye oge nnọkọ %d n'usoro tụfuru nzaghachi ha, ya mere nbanye kwụsịrị. Lelee ndepụta oge nnọkọ BMC, wee jiri Nwaa ọzọ ugbu a."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC jụrụ asambodo njirimara ahụ. A naghị anwa ya ọzọ ruo mgbe asambodo njirimara ahụ gbanwere."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: asambodo njirimara ya na-efu ma ọ bụ enweghị okwuntụghe echekwara."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: njikọ %d dị na nzaghachi ya tụrụ aka ebe ọzọ ma e leghaara ha anya."

