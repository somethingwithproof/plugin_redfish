#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "E hichapụrụ ngwaọrụ nke BMC a. Họrọ ngwaọrụ ọzọ, ma ọ bụ ọ dịghị, na fọm BMC mbụ."

#: redfish_bmcs.php
#, php-format
