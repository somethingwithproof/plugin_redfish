#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Aha: tinye mkpụrụedemede 1 ruo 100 na-enweghị mkpụrụedemede njikwa."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adreesị: tinye naanị aha host ma ọ bụ adreesị IP, na-enweghị scheme, port, ụzọ, ma ọ bụ aha onye ọrụ. A na-ajụ adreesị loopback, link-local, multicast, na ndị a na-akọwaghị."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: tinye port TCP site na 1 ruo 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: naanị poller bụ isi nwere ike ịnakọta BMC na mbipụta a."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Ngwaọrụ: họrọ ngwaọrụ Cacti ma ọ bụ ọ dịghị."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Asambodo njirimara: họrọ asambodo njirimara echekwara."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Nkwenye TLS: họrọ otu n'ime ọnọdụ ndị e depụtara."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Faịlụ ngwugwu CA: tinye ụzọ zuru oke na-enweghị mkpụrụedemede njikwa, ọ kachasị mkpụrụedemede 512."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin igodo ọha: tinye hash SHA-256 base64 nke igodo ọha BMC, nwee ike itinye sha256// n'ihu ya."

