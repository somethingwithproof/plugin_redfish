#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Перевірте актуальність збору даних і графіки пристрою. Повторна спроба знімає призупинення збору для наступного запланованого запуску; зараз підключення до BMC не виконується."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Файл порожній або перевищує 1 МіБ."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Не вдалося прочитати файл."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Файл не містить рядка заголовка."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Файл містить стовпець із назвою \"%s\". Файли імпорту не повинні містити секретів; натомість укажіть назву збережених облікових даних у стовпці credential. Нічого не імпортовано."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Заголовок повинен містити лише ці стовпці, по одному разу кожен, включно з name, address та credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Файл містить понад %d рядків."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Рядок %d: очікувалося %d полів, знайдено %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Облікові дані: немає збережених облікових даних із назвою \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Рядок %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Рядок %d: адреса %s порт %d вже зареєстрована як %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "рядок %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Рядок %d: назва %s уже використовується."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Рядок %d: немає пристрою Cacti з ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Рядок %d: пристрій %d уже має BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "рядка %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Файл не містить рядків BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Назва: введіть від 1 до 100 символів без керівних символів."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Адреса: введіть лише ім'я хоста або IP-адресу без схеми, порту, шляху чи імені користувача. Петльові (loopback), канально-локальні (link-local), багатоадресні (multicast) та невизначені адреси відхиляються."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Порт: введіть порт TCP від 1 до 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Опитувач: у цьому випуску збирати дані з BMC може лише основний опитувач."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Пристрій: виберіть пристрій Cacti або не вказуйте жодного."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Облікові дані: виберіть збережені облікові дані."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Перевірка TLS: виберіть один із наведених режимів."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Файл пакета CA: введіть абсолютний шлях без керівних символів завдовжки не більше 512 символів."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Закріплений відкритий ключ: введіть геш SHA-256 відкритого ключа BMC у форматі base64, за потреби з префіксом sha256//."

