#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Збирачу на опитувачі %d забракло часу, перш ніж усі BMC були опитані; решта продовжить роботу під час наступного запуску. Додайте робочі процеси або збільште ліміт часу."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Збирач на опитувачі %d востаннє запускався %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: перевірку TLS вимкнено. Будь-хто на маршруті може переглядати трафік, зокрема пароль BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: використовує автентифікацію Basic, оскільки BMC не підтримує службу сеансів; кожен запит містить пароль."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: на BMC міг залишитися відкритий сеанс; під час наступного запуску його буде видалено після входу."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d входів до сеансу поспіль не отримали відповіді, тому входи зупинено. Перевірте список сеансів BMC, а потім натисніть «Повторити зараз»."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC відхилив облікові дані. Повторні спроби не виконуватимуться, доки облікові дані не буде змінено."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: його облікові дані відсутні або не мають збереженого пароля."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d посилань у його відповідях вказували на інше місце й були проігноровані."

