msgstr "Ім'я користувача"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Облікових даних ще немає. Створіть запис з обліковим записом BMC лише для читання."

#: lib/CredentialsPage.php
msgid "None stored"
