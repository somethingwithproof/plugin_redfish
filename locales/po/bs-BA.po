#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Datoteka ključa trezora se ne može koristiti: %s. Sačuvane lozinke se ne mogu čitati niti upisivati dok se to ne popravi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Sakupljač na polleru %d trajao je %.0f sekundi, što premašuje vremenski budžet od %d sekundi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Sakupljaču na polleru %d isteklo je vrijeme prije nego što su svi BMC-ovi očitani; preostali se nastavljaju pri sljedećem pokretanju. Dodajte radnike ili povećajte vremenski budžet."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Sakupljač na polleru %d posljednji put je pokrenut %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS provjera je isključena. Svako na mrežnoj putanji može čitati njegov saobraćaj, uključujući lozinku BMC-a."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: koristi Basic autentifikaciju jer BMC ne nudi servis sesija; svaki zahtjev sadrži lozinku."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: na BMC-u je možda ostala otvorena sesija; sljedeće pokretanje će je obrisati nakon prijave."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d uzastopnih prijava sesije ostalo je bez odgovora, pa su prijave zaustavljene. Provjerite spisak sesija na BMC-u, a zatim upotrijebite Pokušaj ponovo sada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC je odbio akreditiv. Neće se ponovo pokušavati dok se akreditiv ne izmijeni."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: njegov akreditiv nedostaje ili nema sačuvanu lozinku."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d linkova u njegovim odgovorima upućivalo je drugdje i zanemareno je."

