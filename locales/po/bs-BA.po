#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Provjerite svježinu prikupljanja i grafove uređaja. Ponovni pokušaj uklanja blokadu prikupljanja za sljedeće zakazano pokretanje; ne kontaktira BMC odmah."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Datoteka je prazna ili veća od 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Datoteku nije moguće pročitati."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Datoteka nema red zaglavlja."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Datoteka sadrži kolonu pod nazivom \"%s\". Datoteke za uvoz ne smiju sadržavati tajne; umjesto toga navedite naziv sačuvanog akreditiva u koloni credential. Ništa nije uvezeno."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Zaglavlje mora sadržavati samo ove kolone, svaku po jednom, uključujući name, address i credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Datoteka ima više od %d redova."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Linija %d: očekivano je %d polja, pronađeno %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Akreditiv: ne postoji sačuvani akreditiv pod nazivom \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Linija %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Linija %d: adresa %s, port %d je već registrovana kao %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "linija %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Linija %d: naziv %s se već koristi."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Linija %d: nijedan Cacti uređaj nema ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Linija %d: uređaj %d već ima BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "iz linije %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Datoteka nema redova sa BMC zapisima."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Naziv: unesite od 1 do 100 znakova bez kontrolnih znakova."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adresa: unesite samo ime hosta ili IP adresu, bez šeme, porta, putanje ili korisničkog imena. Loopback, link-local, multicast i neodređene adrese se odbijaju."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: unesite TCP port od 1 do 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: samo glavni poller može prikupljati BMC podatke u ovom izdanju."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Uređaj: odaberite Cacti uređaj ili nijedan."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Akreditiv: odaberite sačuvani akreditiv."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS provjera: odaberite jedan od navedenih načina rada."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Datoteka CA paketa: unesite apsolutnu putanju bez kontrolnih znakova, najviše 512 znakova."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Prikvačeni javni ključ: unesite base64 SHA-256 sažetak javnog ključa BMC-a, opcionalno sa prefiksom sha256//."

