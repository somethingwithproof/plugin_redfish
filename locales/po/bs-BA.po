#: lib/Settings.php
#, php-format
msgid "%s Default %d, from %d to %d."
msgstr "%s Podrazumijevano %d, od %d do %d."

#: lib/Settings.php
msgid "Credential Vault"
msgstr "Trezor akreditiva"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "Datoteka ključa trezora"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "Apsolutna putanja do 32-bajtnog ključa koji šifruje sačuvane lozinke BMC-ova. Kreirajte ga sami, izvan korijenskog web direktorija, čitljivog samo za korisnika web servera i pollera, u direktoriju u koji mogu pisati samo root i taj korisnik; dodatak ga nikada ne kreira niti upisuje. Napravite sigurnosnu kopiju zajedno sa bazom podataka: bez njega se sačuvane lozinke moraju ponovo unijeti."

#: lib/Settings.php
msgid "Collector"
msgstr "Sakupljač"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "Interval prikupljanja"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "Broj sekundi između očitavanja svakog BMC-a."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "Interval ponovnog otkrivanja"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "Broj sekundi između potpunih otkrivanja resursa svakog BMC-a. BMC se također odmah ponovo otkriva kada poznati resurs nestane ili promijeni tip."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "Vremenski budžet sakupljača"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "Broj sekundi koji jedno pokretanje sakupljača smije utrošiti prije nego što prestane započinjati nove BMC-ove. Držite vrijednost ispod intervala pollera; nedovršeni BMC-ovi se nastavljaju pri sljedećem pokretanju."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "Broj BMC-ova koji se očitavaju paralelno. Svaki BMC u jednom trenutku očitava jedan radnik."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "Radnici sakupljača"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Istek vremena povezivanja"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "Broj sekundi dozvoljen za TCP vezu i TLS rukovanje sa BMC-om."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "Istek vremena zahtjeva"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "Broj sekundi dozvoljen za jedan cijeli zahtjev prema BMC-u, uključujući povezivanje."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "Najveći dozvoljeni broj KiB u tijelu jednog odgovora BMC-a; veći odgovor se odbija."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "Maksimalna veličina odgovora"

#: lib/Settings.php
msgid "Freshness"
msgstr "Svježina"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "Broj intervala prikupljanja nakon kojih se očitavanje prikazuje kao zakasnjelo."

#: lib/Settings.php
msgid "Delayed After"
msgstr "Zakasnjelo nakon"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "Broj intervala prikupljanja nakon kojih je očitavanje zastarjelo i očitava se kao nepoznato. Uvijek najmanje za jedan više od Zakasnjelo nakon."

#: lib/Settings.php
msgid "Stale After"
msgstr "Zastarjelo nakon"

#: lib/Settings.php
msgid "Uninstall"
msgstr "Deinstalacija"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zadrži tabele dodatka pri deinstalaciji"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "Kada je označeno, deinstalacija dodatka zadržava registar BMC-ova, šifrovane lozinke i keš očitavanja. Odznačite opciju da bi ih deinstalacija uklonila. Deinstalacija nikada ne dira Cacti uređaje, grafove ili BMC-ove, uključujući uređaje koje je dodatak kreirao."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "Provjeri pomoću sistemskog CA spremišta"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "Provjeri pomoću datoteke CA paketa"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "Prikvačeni javni ključ (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "Ne provjeravaj (nesigurno)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "Nemate pristup Cacti uređaju ovog BMC-a."

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "BMC nije bilo moguće sačuvati."

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "BMC je sačuvan."

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "BMC i njegovi keširani podaci su obrisani. Njegov Cacti uređaj je ostavljen netaknut."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "Odgađanje i zadržane greške su očišćene; sakupljač će očitati BMC pri sljedećem pokretanju."

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "Dodavanje uređaja i grafova zahtijeva Cacti dozvolu za upravljanje uređajima."

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "Uređaj ovog BMC-a je obrisan. Najprije odaberite drugi uređaj, ili nijedan, u obrascu BMC-a."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "Upiti podataka su ponovo indeksirani i dodano je %d grafova."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "Uređaj je kreiran zajedno sa svojim Redfish grafovima."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Instalacija Redfish šablona zahtijeva Cacti dozvolu za uvoz šablona."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Redfish šabloni su instalirani."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "Redfish šablone nije bilo moguće instalirati. Stranica stanja prikazuje razlog."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "Uvoz nije bilo moguće sačuvati; ništa nije uvezeno."

#: redfish_bmcs.php
#, php-format
msgid "%d BMCs were imported."
msgstr "Uvezeno je %d BMC-ova."

#: redfish_credentials.php
msgid "This credential is used by a BMC on a Cacti device you do not have access to, so it cannot be changed here."
msgstr "Ovaj akreditiv koristi BMC na Cacti uređaju kojem nemate pristup, pa se ovdje ne može izmijeniti."

#: redfish_credentials.php
msgid "Name: another credential already uses this name."
msgstr "Naziv: drugi akreditiv već koristi ovaj naziv."

#: redfish_credentials.php
msgid "User Name: enter 1 to 255 characters without control characters."
msgstr "Korisničko ime: unesite od 1 do 255 znakova bez kontrolnih znakova."

#: redfish_credentials.php
msgid "Password: enter the password of the BMC account."
msgstr "Lozinka: unesite lozinku BMC naloga."

#: redfish_credentials.php
#, php-format
msgid "The credential was saved, but the password was not stored: %s"
msgstr "Akreditiv je sačuvan, ali lozinka nije pohranjena: %s"

#: redfish_credentials.php
msgid "The credential could not be saved."
msgstr "Akreditiv nije bilo moguće sačuvati."

#: redfish_credentials.php
msgid "The credential was saved."
msgstr "Akreditiv je sačuvan."

#: redfish_credentials.php
msgid "The credential and its stored password were deleted."
msgstr "Akreditiv i njegova sačuvana lozinka su obrisani."

#: redfish_credentials.php
msgid "The credential was not deleted. A credential in use by a BMC cannot be deleted."
msgstr "Akreditiv nije obrisan. Akreditiv koji koristi neki BMC ne može se obrisati."

#: redfish_operator.php
msgid "Retry collection"
msgstr "Ponovi prikupljanje"

#: redfish_operator.php
msgid "Monitoring view"
msgstr "Prikaz nadzora"

