#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Hamarino ny fahavaozan'ny fanangonana sy ny kisarin'ny fitaovana. Ny fiverenana manandrana dia manala ny fanakanana ny fanangonana ho an'ny fandehanana voalahatra manaraka; tsy mifandray amin'ny BMC izao izy."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Foana ny rakitra na lehibe noho ny 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Tsy azo novakina ny rakitra."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Tsy misy andalana lohapejy ny rakitra."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Misy tsanganana mitondra ny anarana \"%s\" ny rakitra. Tsy tokony hitondra tsiambaratelo ny rakitra ampidirina; tanisao ao amin'ny tsanganana mari-pahazoan-dalana ny anaran'ny mari-pahazoan-dalana voatahiry. Tsy nisy nampidirina."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Ny lohapejy dia tsy maintsy mitanisa ireto tsanganana ireto ihany, indray mandeha avy, anisan'izany ny name, address, ary credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Misy andalana mihoatra ny %d ny rakitra."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Andalana %d: saha %d no nandrasana, %d no hita."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Mari-pahazoan-dalana: tsy misy mari-pahazoan-dalana voatahiry mitondra ny anarana \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Andalana %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Andalana %d: ny adiresy %s seranana %d dia efa voasoratra anarana ho %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "andalana %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Andalana %d: efa ampiasaina ny anarana %s."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Andalana %d: tsy misy fitaovana Cacti manana ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Andalana %d: ny fitaovana %d dia efa manana ny BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "amin'ny andalana %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Tsy misy andalana BMC ny rakitra."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Anarana: ampidiro litera na marika 1 hatramin'ny 100 tsy misy marika fanaraha-maso."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adiresy: ampidiro ny anaran'ny mpampiantrano na ny adiresy IP ihany, tsy misy rafitra, seranana, lalana, na anaran'ny mpampiasa. Lavina ny adiresy loopback, link-local, multicast, ary ny adiresy tsy voafaritra."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Seranana: ampidiro ny seranana TCP manomboka amin'ny 1 ka hatramin'ny 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: ny poller fototra ihany no afaka manangona BMC amin'ity kinova ity."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Fitaovana: misafidiana fitaovana Cacti na tsy misy."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Fahazoan-dalana: misafidiana fahazoan-dalana voatahiry."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Fanamarinana TLS: misafidiana iray amin'ireo fomba voatanisa."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Rakitra CA Bundle: ampidiro ny lalana feno tsy misy mari-tsoratra fanaraha-maso, farafahabetsany 512 tarehintsoratra."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin-n'ny fanalahidy ho an'ny besinimaro: ampidiro ny hash base64 SHA-256 an'ny fanalahidin'ny BMC ho an'ny besinimaro, azo asiana tovona aloha sha256//."

