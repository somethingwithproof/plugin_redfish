#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Tsy azo ampiasaina ny rakitra fanalahidin'ny fitehirizana: %s. Tsy azo vakiana na soratana ny tenimiafina voatahiry raha tsy voamboatra izany."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Ny mpanangona ao amin'ny poller %d dia naka %.0f segondra, mihoatra ny fetra natokana ho azy %d segondra."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Lany fotoana ny mpanangona ao amin'ny poller %d talohan'ny namakiana ny BMC rehetra; hitohy amin'ny fandehanana manaraka ny ambiny. Manampia mpiasa na ampitomboy ny fetram-potoana."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Ny mpanangona ao amin'ny poller %d dia nandeha farany %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: maty ny fanamarinana TLS. Ny olona rehetra eny an-dalana dia afaka mamaky ny fifamoivoizany, ao anatin'izany ny tenimiafin'ny BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: mampiasa fanamarinana Basic satria tsy manolotra tolotra fivoriana ny BMC; ny fangatahana tsirairay dia mitondra ny tenimiafina."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: mety nisy fivoriana navela nisokatra tao amin'ny BMC; hamafa azy ny fandehanana manaraka rehefa avy miditra."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: fidirana fivoriana %d nisesy no very valiny, ka nijanona ny fidirana. Jereo ny lisitry ny fivorian'ny BMC, dia ampiasao ny Andramo indray izao."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: nolavin'ny BMC ny fahazoan-dalana. Tsy andramana indray izany raha tsy miova ny fahazoan-dalana."

