msgstr "Zeile %d: Der Name %s wird bereits verwendet."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Zeile %d: Kein Cacti-Gerät hat die ID %d."

