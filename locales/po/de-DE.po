#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Die Vault-Schlüsseldatei kann nicht verwendet werden: %s. Gespeicherte Passwörter können nicht gelesen oder geschrieben werden, bis das Problem behoben ist."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Der Kollektor auf Poller %d benötigte %.0f Sekunden und damit mehr als sein Zeitbudget von %d Sekunden."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Dem Kollektor auf Poller %d ist die Zeit abgelaufen, bevor jeder BMC ausgelesen werden konnte; die übrigen werden beim nächsten Durchlauf fortgesetzt. Fügen Sie Worker hinzu oder erhöhen Sie das Zeitbudget."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Der Kollektor auf Poller %d lief zuletzt %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: Die TLS-Überprüfung ist deaktiviert. Jeder auf dem Übertragungsweg kann den Datenverkehr einschließlich des BMC-Passworts mitlesen."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: verwendet Basic-Authentifizierung, da der BMC keinen Sitzungsdienst anbietet; jede Anfrage überträgt das Passwort."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: Möglicherweise wurde eine Sitzung auf dem BMC offen gelassen; der nächste Durchlauf löscht sie nach der Anmeldung."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: Bei %d Sitzungsanmeldungen in Folge ging die Antwort verloren, daher wurden weitere Anmeldungen gestoppt. Prüfen Sie die BMC-Sitzungsliste und verwenden Sie anschließend „Jetzt erneut versuchen“."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: Der BMC hat die Zugangsdaten abgelehnt. Es erfolgt kein weiterer Versuch, bis sich die Zugangsdaten ändern."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: Die Zugangsdaten fehlen oder enthalten kein gespeichertes Passwort."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d Links in den Antworten verwiesen auf andere Ziele und wurden ignoriert."

