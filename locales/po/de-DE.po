#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Prüfen Sie die Aktualität der Erfassung und die Gerätediagramme. „Erneut versuchen“ hebt eine Erfassungssperre für den nächsten geplanten Durchlauf auf; der BMC wird jetzt nicht kontaktiert."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Die Datei ist leer oder größer als 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Die Datei konnte nicht gelesen werden."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Die Datei hat keine Kopfzeile."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Die Datei enthält eine Spalte namens „%s“. Importdateien dürfen keine Geheimnisse enthalten; geben Sie stattdessen gespeicherte Anmeldedaten in der Spalte „credential“ an. Es wurde nichts importiert."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Die Kopfzeile darf nur diese Spalten jeweils einmal nennen, einschließlich name, address und credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Die Datei hat mehr als %d Zeilen."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Zeile %d: %d Felder erwartet, %d gefunden."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Anmeldedaten: Es sind keine gespeicherten Anmeldedaten mit dem Namen „%s“ vorhanden."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Zeile %d: %s"

