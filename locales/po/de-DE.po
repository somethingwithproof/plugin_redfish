#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Name: Geben Sie 1 bis 100 Zeichen ohne Steuerzeichen ein."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adresse: Geben Sie nur einen Hostnamen oder eine IP-Adresse ohne Schema, Port, Pfad oder Benutzernamen ein. Loopback-, Link-Local-, Multicast- und nicht spezifizierte Adressen werden abgelehnt."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: Geben Sie einen TCP-Port von 1 bis 65535 ein."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: In dieser Version kann nur der Haupt-Poller BMCs erfassen."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Gerät: Wählen Sie ein Cacti-Gerät oder keines."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Anmeldedaten: Wählen Sie gespeicherte Anmeldedaten aus."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS-Überprüfung: Wählen Sie einen der aufgeführten Modi aus."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA-Bundle-Datei: Geben Sie einen absoluten Pfad ohne Steuerzeichen mit maximal 512 Zeichen ein."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Public-Key-Pin: Geben Sie den Base64-SHA-256-Hash des öffentlichen BMC-Schlüssels ein, optional mit dem Präfix sha256//."

