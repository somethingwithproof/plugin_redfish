#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Provjerite svježinu prikupljanja i grafikone uređaja. Ponovni pokušaj oslobađa zadržavanje prikupljanja za sljedeće zakazano izvođenje; ne obraća se BMC-u odmah."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Datoteka je prazna ili prelazi 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Datoteku nije bilo moguće pročitati."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Datoteka ne sadrži redak zaglavlja."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Datoteka sadrži stupac pod nazivom \"%s\". Datoteke za uvoz ne smiju sadržavati tajne podatke; umjesto toga navedite naziv spremljene vjerodajnice u stupcu credential. Ništa nije uvezeno."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Zaglavlje smije navesti samo ove stupce, svaki jednom, uključujući name, address i credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Datoteka ima više od %d redaka."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Redak %d: očekivano polja: %d, pronađeno: %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Vjerodajnica: nijedna spremljena vjerodajnica ne nosi naziv \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Redak %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Redak %d: adresa %s, ulaz %d već je registrirana pod nazivom %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "redak %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Redak %d: naziv %s već je zauzet."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Redak %d: ne postoji Cacti uređaj s oznakom ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Redak %d: uređaj %d već ima pridružen BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "retka %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Datoteka ne sadrži retke za BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Naziv: unesite od 1 do 100 znakova bez upravljačkih znakova."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adresa: unesite isključivo naziv poslužitelja ili IP adresu, bez sheme, ulaza, putanje ili korisničkog imena. Loopback, link-local, multicast i neodređene adrese odbijaju se."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Ulaz (port): unesite TCP broj od 1 do 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Ispitivač (poller): u ovom izdanju samo glavni ispitivač može prikupljati BMC podatke."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Uređaj: odaberite Cacti uređaj ili bez pridruživanja."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Vjerodajnica: odaberite spremljenu vjerodajnicu."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Provjera TLS-a: odaberite jedan od navedenih načina."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Datoteka paketa CA certifikata: unesite apsolutnu putanju bez upravljačkih znakova, najviše 512 znakova."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Prikvačivanje javnog ključa: unesite base64 SHA-256 otisak javnog ključa BMC-a, po izboru s prefiksom sha256//."

