msgstr "Koriste"

#: lib/CredentialsPage.php
msgid "User Name"
msgstr "Korisničko ime"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Još nema vjerodajnica. Stvorite jednu s BMC računom samo za čitanje."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "Nije pohranjena"

#: lib/CredentialsPage.php
