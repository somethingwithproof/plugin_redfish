#: lib/Settings.php
#, php-format
msgid "%s Default %d, from %d to %d."
msgstr "%s Zadano %d, od %d do %d."

#: lib/Settings.php
msgid "Credential Vault"
msgstr "Trezor vjerodajnica"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "Datoteka ključa trezora"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "Apsolutna putanja do 32-bajtnog ključa koji šifrira pohranjene zaporke BMC jedinica. Stvorite ga sami izvan korijenske mape web-poslužitelja, čitljivog isključivo korisniku web-poslužitelja i ispitivača, u mapi u koju smiju pisati samo root i taj korisnik; priključak ga nikada ne stvara ni ne zapisuje. Napravite sigurnosnu kopiju zajedno s bazom podataka: bez njega sve pohranjene zaporke moraju se ponovno unijeti."

#: lib/Settings.php
msgid "Collector"
msgstr "Prikupljač"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "Razmak prikupljanja"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "Broj sekundi između čitanja svake BMC jedinice."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "Razmak ponovnog otkrivanja"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "Broj sekundi između potpunih otkrivanja resursa svake BMC jedinice. BMC se također odmah ponovno otkriva kada poznati resurs nestane ili promijeni vrstu."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "Vremenski proračun prikupljača"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "Broj sekundi koji jedno izvođenje prikupljača smije utrošiti prije nego prestane započinjati nove BMC jedinice. Održavajte vrijednost ispod razmaka ispitivača; nedovršene BMC jedinice nastavljaju se u sljedećem izvođenju."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "Broj BMC jedinica koje se čitaju usporedno. Svaku BMC jedinicu istodobno čita samo jedan izvršitelj."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "Izvršitelji prikupljača"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Istek vremena povezivanja"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "Broj sekundi dopušten za uspostavu TCP veze i TLS rukovanje s BMC-om."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "Istek vremena zahtjeva"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "Broj sekundi dopušten za cijeli pojedinačni zahtjev prema BMC-u, uključujući povezivanje."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "Najveći dopušteni broj KiB u tijelu jednog odgovora BMC-a; veći odgovor odbija se."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "Najveća veličina odgovora"

#: lib/Settings.php
msgid "Freshness"
msgstr "Svježina"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "Broj razmaka prikupljanja nakon kojih se očitanje prikazuje kao zakašnjelo."

#: lib/Settings.php
msgid "Delayed After"
msgstr "Zakašnjelo nakon"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "Broj razmaka prikupljanja nakon kojih očitanje postaje zastarjelo i bilježi se kao nepoznato. Uvijek najmanje za jedan više od Zakašnjelo nakon."

#: lib/Settings.php
msgid "Stale After"
msgstr "Zastarjelo nakon"

#: lib/Settings.php
msgid "Uninstall"
msgstr "Deinstalacija"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zadrži tablice priključka pri deinstalaciji"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "Ako je označeno, deinstalacija priključka zadržava popis BMC jedinica, šifrirane zaporke i predmemoriju očitanja. Poništite odabir kako bi ih deinstalacija uklonila. Deinstalacija nikada ne dira Cacti uređaje, grafikone ni BMC jedinice, uključujući uređaje koje je priključak stvorio."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "Provjeri pomoću sustavske pohrane CA certifikata"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "Provjeri pomoću datoteke paketa CA certifikata"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "Prikvačeni javni ključ (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "Ne provjeravaj (nesigurno)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "Nemate pravo pristupa Cacti uređaju ove BMC jedinice."

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "BMC nije bilo moguće spremiti."

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "BMC je spremljen."

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "BMC i njegovi podaci u predmemoriji izbrisani su. Njegov Cacti uređaj ostavljen je nepromijenjen."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "Odgode i zadržane pogreške poništene su; prikupljač će pročitati BMC u sljedećem izvođenju."

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "Dodavanje uređaja i grafikona zahtijeva Cacti ovlast za upravljanje uređajima."

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "Uređaj ove BMC jedinice izbrisan je. Najprije odaberite drugi uređaj, ili ništa, u obrascu BMC-a."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "Upiti podataka ponovno su indeksirani i dodano je %d grafikona."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "Uređaj je stvoren zajedno sa svojim Redfish grafikonima."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Instalacija Redfish predložaka zahtijeva Cacti ovlast za uvoz predložaka."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Redfish predlošci su instalirani."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "Redfish predloške nije bilo moguće instalirati. Stranica zdravlja prikazuje razlog."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "Uvoz nije bilo moguće spremiti; ništa nije uvezeno."

#: redfish_bmcs.php
#, php-format
msgid "%d BMCs were imported."
msgstr "Uvezeno je %d BMC jedinica."

#: redfish_credentials.php
msgid "This credential is used by a BMC on a Cacti device you do not have access to, so it cannot be changed here."
msgstr "Ovu vjerodajnicu koristi BMC na Cacti uređaju kojem nemate pristup pa se ovdje ne može izmijeniti."

#: redfish_credentials.php
msgid "Name: another credential already uses this name."
msgstr "Naziv: druga vjerodajnica već upotrebljava ovaj naziv."

#: redfish_credentials.php
msgid "User Name: enter 1 to 255 characters without control characters."
msgstr "Korisničko ime: unesite od 1 do 255 znakova bez upravljačkih znakova."

#: redfish_credentials.php
msgid "Password: enter the password of the BMC account."
msgstr "Zaporka: unesite zaporku BMC računa."

#: redfish_credentials.php
#, php-format
msgid "The credential was saved, but the password was not stored: %s"
msgstr "Vjerodajnica je spremljena, ali zaporka nije pohranjena: %s"

#: redfish_credentials.php
msgid "The credential could not be saved."
msgstr "Vjerodajnicu nije bilo moguće spremiti."

#: redfish_credentials.php
msgid "The credential was saved."
msgstr "Vjerodajnica je spremljena."

#: redfish_credentials.php
msgid "The credential and its stored password were deleted."
msgstr "Vjerodajnica i njezina pohranjena zaporka izbrisane su."

#: redfish_credentials.php
msgid "The credential was not deleted. A credential in use by a BMC cannot be deleted."
msgstr "Vjerodajnica nije izbrisana. Vjerodajnica koju koristi neki BMC ne može se izbrisati."

