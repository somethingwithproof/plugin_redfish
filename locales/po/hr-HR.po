#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Datoteka ključa trezora ne može se upotrijebiti: %s. Pohranjene zaporke ne mogu se čitati ni spremati dok se pogreška ne otkloni."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Prikupljač na ispitivaču %d trajao je %.0f sekundi, više od dodijeljenog proračuna od %d sekundi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Prikupljaču na ispitivaču %d ponestalo je vremena prije nego što su pročitane sve BMC jedinice; preostale će se obraditi u sljedećem izvođenju. Dodajte izvršitelje ili povećajte vremenski proračun."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Prikupljač na ispitivaču %d zadnji je put izveden %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: provjera TLS-a isključena je. Svatko na mrežnoj putanji može čitati njegov promet, uključujući zaporku BMC-a."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: koristi Basic provjeru autentičnosti jer BMC ne nudi uslugu sjednica; svaki zahtjev prenosi zaporku."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: sjednica je možda ostala otvorena na BMC-u; sljedeće izvođenje izbrisat će je nakon prijave."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d uzastopnih prijava sjednice ostalo je bez odgovora pa su prijave zaustavljene. Provjerite popis sjednica na BMC-u, a zatim odaberite Pokušaj odmah ponovno."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC je odbio vjerodajnicu. Ponovni pokušaj neće se izvoditi dok se vjerodajnica ne izmijeni."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: njegova vjerodajnica nedostaje ili nema pohranjenu zaporku."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d poveznica u njegovim odgovorima upućivalo je na drugo odredište i zanemareno je."

#: lib/Html.php
#, php-format
msgid "%d seconds ago"
msgstr "prije %d sek."

