msgstr "Instalacja szablonów Redfish wymaga uprawnienia Importowanie szablonów w Cacti."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Szablony Redfish są zainstalowane."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "Nie można zainstalować szablonów Redfish. Przyczyna jest widoczna na stronie stanu."

#: redfish_bmcs.php
