#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Sprawdź aktualność zbierania danych i wykresy urządzenia. Ponowna próba zwalnia wstrzymanie zbierania dla następnego zaplanowanego uruchomienia; nie nawiązuje teraz połączenia z BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Plik jest pusty lub większy niż 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Nie udało się odczytać pliku."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Plik nie zawiera wiersza nagłówka."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Plik zawiera kolumnę o nazwie „%s”. Pliki importu nie mogą zawierać sekretów; zamiast tego podaj nazwę zapisanego poświadczenia w kolumnie credential. Nic nie zostało zaimportowane."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Nagłówek musi zawierać wyłącznie te kolumny, każdą jednokrotnie, w tym name, address oraz credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Plik zawiera więcej niż %d wierszy."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Wiersz %d: oczekiwano %d pól, znaleziono %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Poświadczenie: żadne zapisane poświadczenie nie nosi nazwy „%s”."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Wiersz %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Wiersz %d: adres %s port %d jest już zarejestrowany jako %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "wiersz %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Wiersz %d: nazwa %s jest już używana."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Wiersz %d: brak urządzenia Cacti o ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Wiersz %d: urządzenie %d ma już przypisany kontroler BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "wiersza %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Plik nie zawiera żadnych wierszy BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nazwa: wprowadź od 1 do 100 znaków bez znaków sterujących."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adres: podaj wyłącznie nazwę hosta lub adres IP, bez schematu, portu, ścieżki ani nazwy użytkownika. Adresy pętli zwrotnej (loopback), link-local, multicast oraz nieokreślone są odrzucane."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: podaj port TCP z zakresu od 1 do 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: w tej wersji tylko główny poller może zbierać dane z kontrolerów BMC."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Urządzenie: wybierz urządzenie Cacti lub brak."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Dane uwierzytelniające: wybierz zapisane dane uwierzytelniające."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Weryfikacja TLS: wybierz jeden z wymienionych trybów."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Plik pakietu CA: podaj ścieżkę bezwzględną bez znaków sterujących, maksymalnie 512 znaków."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Przypięcie klucza publicznego: podaj skrót SHA-256 w formacie base64 klucza publicznego BMC, opcjonalnie z prefiksem sha256//."

