#: lib/BmcsPage.php
msgid "Everything is already in place. Confirming indexes the data queries again and adds graphs for new members only."
msgstr "Wszystko jest już skonfigurowane. Potwierdzenie ponownie indeksuje zapytania o dane i dodaje wykresy tylko dla nowych elementów."

#: lib/BmcsPage.php
msgid "Confirming adds:"
msgstr "Potwierdzenie dodaje:"

#: lib/BmcsPage.php
msgid "Existing devices, graphs, and thresholds are not changed."
msgstr "Istniejące urządzenia, wykresy i progi nie ulegną zmianie."

#: lib/BmcsPage.php
msgid "Confirm"
msgstr "Potwierdź"

#: lib/BmcsPage.php
