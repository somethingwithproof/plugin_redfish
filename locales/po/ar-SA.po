#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "تحقق من حداثة الجمع ورسوم الجهاز. تعيد المحاولة رفع تعليق الجمع للتشغيل المجدول التالي؛ ولا تتصل بوحدة BMC الآن."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "الملف فارغ أو أكبر من 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "تعذرت قراءة الملف."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "لا يحتوي الملف على صف عناوين."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "يحتوي الملف على عمود باسم «%s». يجب ألا تتضمن ملفات الاستيراد أسرارًا؛ ضع اسم بيانات اعتماد محفوظة في عمود credential. لم يُستورد شيء."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "يجب أن يقتصر العنوان على الأعمدة التالية، مرة واحدة لكل منها، بما فيها name وaddress وcredential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "يتجاوز الملف %d صفًا."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "السطر %d: المتوقع %d حقول، والموجود %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "بيانات الاعتماد: لا توجد بيانات اعتماد محفوظة باسم «%s»."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "السطر %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "السطر %d: العنوان %s والمنفذ %d مسجلان بالفعل باسم %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "السطر %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "السطر %d: الاسم %s مستخدم بالفعل."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "السطر %d: لا يوجد جهاز Cacti بالمعرّف %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "السطر %d: للجهاز %d وحدة BMC‏ %s بالفعل."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "من السطر %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "لا يحتوي الملف على صفوف BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "الاسم: أدخل من 1 إلى 100 حرف دون أحرف تحكم."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "العنوان: أدخل اسم مضيف أو عنوان IP فقط، دون مخطط أو منفذ أو مسار أو اسم مستخدم. تُرفض عناوين الاسترجاع والمحلية للرابط والبث المتعدد وغير المحددة."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "المنفذ: أدخل منفذ TCP بين 1 و65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "المستطلِع: في هذا الإصدار يمكن للمستطلِع الرئيسي فقط جمع بيانات BMC."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "الجهاز: اختر جهاز Cacti أو لا شيء."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "بيانات الاعتماد: اختر بيانات اعتماد محفوظة."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "التحقق من TLS: اختر وضعًا من القائمة."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "ملف حزمة CA: أدخل مسارًا مطلقًا لا يتجاوز 512 حرفًا دون أحرف تحكم."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "تثبيت المفتاح العام: أدخل تجزئة SHA-256 بترميز base64 للمفتاح العام لوحدة BMC، مع البادئة sha256// اختياريًا."

