msgid "The Redfish plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Die Redfish-inprop vereis PHP %s of nuwer. Hierdie bediener loop PHP %s, dus is die inprop nie geïnstalleer of geaktiveer nie."

#: setup.php
#, php-format
msgid "The Redfish plugin requires the PHP extensions %s, which this server does not load, so the plugin was not installed or enabled."
msgstr "Die Redfish-inprop vereis die PHP-uitbreidings %s, wat hierdie bediener nie laai nie, dus is die inprop nie geïnstalleer of geaktiveer nie."

