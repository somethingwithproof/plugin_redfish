#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Die kluissleutellêer kan nie gebruik word nie: %s. Gestoorde wagwoorde kan nie gelees of geskryf word voordat dit reggestel is nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Die versamelaar op poller %d het %.0f sekondes geneem, meer as sy begroting van %d sekondes."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Die versamelaar op poller %d se tyd het uitgeloop voordat elke BMC gelees is; die res hervat met die volgende lopie. Voeg werkers by of verhoog die begroting."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Die versamelaar op poller %d het laas %s geloop."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS-verifikasie is af. Enigiemand op die pad kan sy verkeer lees, insluitend die BMC-wagwoord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: gebruik Basic-verifikasie omdat die BMC geen sessiediens bied nie; elke versoek dra die wagwoord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: 'n sessie is moontlik op die BMC oop gelaat; die volgende lopie skrap dit nadat dit aangemeld het."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d sessie-aanmeldings agtereenvolgens het hul antwoord verloor, dus het aanmeldings gestop. Gaan die BMC-sessielys na en gebruik dan Probeer nou weer."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: die BMC het die geloofsbrief verwerp. Dit word nie weer probeer voordat die geloofsbrief verander nie."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: sy geloofsbrief ontbreek of het geen gestoorde wagwoord nie."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d skakels in sy antwoorde het elders gewys en is geïgnoreer."

