#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Kontroleer versamelingsvarsheid en die toestelgrafieke. Probeer weer stel 'n versamelingshou vir die volgende geskeduleerde lopie vry; dit kontak nie die BMC nou nie."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Die lêer is leeg of groter as 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Die lêer kon nie gelees word nie."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Die lêer het geen opskrifry nie."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Die lêer het 'n kolom genaamd \"%s\". Invoerlêers mag nie geheime bevat nie; noem eerder 'n gestoorde aanmeldbewys in die credential-kolom. Niks is ingevoer nie."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Die opskrif moet slegs hierdie kolomme noem, elk een keer, insluitend name, address en credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Die lêer het meer as %d rye."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Reël %d: %d velde verwag, %d gevind."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Aanmeldbewys: geen gestoorde aanmeldbewys heet \"%s\" nie."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Reël %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Reël %d: die adres %s poort %d is reeds geregistreer as %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "reël %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Reël %d: die naam %s word reeds gebruik."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Reël %d: geen Cacti-toestel het ID %d nie."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Reël %d: toestel %d het reeds die BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "van reël %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Die lêer het geen BMC-rye nie."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Naam: voer 1 tot 100 karakters sonder beheerkarakters in."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adres: voer slegs 'n gasheernaam of 'n IP-adres in, sonder 'n skema, poort, pad of gebruikersnaam. Teruglus-, skakelplaaslike, multisaai- en ongespesifiseerde adresse word geweier."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Poort: voer 'n TCP-poort van 1 tot 65535 in."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: slegs die hoof-poller kan BMC's in hierdie vrystelling versamel."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Toestel: kies 'n Cacti-toestel of geen."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Geloofsbrief: kies 'n gestoorde geloofsbrief."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS-verifikasie: kies een van die gelyste modusse."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA-bundellêer: voer 'n absolute pad sonder beheerkarakters in, hoogstens 512 karakters."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Publieke-sleutelspeld: voer die base64 SHA-256-huts van die BMC se publieke sleutel in, opsioneel voorafgegaan deur sha256//."

