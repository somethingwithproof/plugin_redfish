#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nom : saisissez de 1 à 100 caractères sans caractères de contrôle."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adresse : saisissez uniquement un nom d'hôte ou une adresse IP, sans schéma, port, chemin ni nom d'utilisateur. Les adresses de bouclage, lien-local, multicast et non spécifiées sont refusées."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port : saisissez un port TCP compris entre 1 et 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller : seul le poller principal peut collecter les BMC dans cette version."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Équipement : choisissez un équipement Cacti ou aucun."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Identifiant : choisissez un identifiant enregistré."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Vérification TLS : choisissez l'un des modes répertoriés."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Fichier bundle CA : saisissez un chemin absolu sans caractères de contrôle, de 512 caractères maximum."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Épinglage de clé publique : saisissez le condensat SHA-256 en base64 de la clé publique du BMC, éventuellement préfixé par sha256//."

