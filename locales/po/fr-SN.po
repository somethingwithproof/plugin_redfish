#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Vérifiez la fraîcheur de la collecte et les graphiques de l'équipement. Réessayer lève une suspension de collecte pour la prochaine exécution planifiée ; cela ne contacte pas le BMC maintenant."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Le fichier est vide ou sa taille dépasse 1 Mio."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Le fichier n'a pas pu être lu."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Le fichier ne contient aucune ligne d'en-tête."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Le fichier contient une colonne nommée « %s ». Les fichiers d'importation ne doivent pas contenir de secrets ; indiquez plutôt le nom d'un identifiant enregistré dans la colonne des identifiants. Rien n'a été importé."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "L'en-tête doit nommer uniquement ces colonnes, chacune une seule fois, en incluant name, address et credential : %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Le fichier contient plus de %d lignes."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Ligne %d : %d champs attendus, %d trouvés."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Identifiant : aucun identifiant enregistré ne se nomme « %s »."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Ligne %d : %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Ligne %d : l'adresse %s port %d est déjà enregistrée sous le nom %s."

