msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Le fichier de clé du coffre-fort ne peut pas être utilisé : %s. Les mots de passe enregistrés ne peuvent être ni lus ni écrits tant que ce problème n'est pas résolu."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Le collecteur sur le poller %d a pris %.0f secondes, soit plus que son budget de %d secondes."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Le collecteur sur le poller %d a manqué de temps avant que chaque BMC ne soit lu ; les autres reprendront lors de la prochaine exécution. Ajoutez des processus de travail ou augmentez le budget."

#: lib/HealthWarnings.php
