msgstr "La dernière exécution du collecteur sur le poller %d remonte à %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s : la vérification TLS est désactivée. Toute personne sur le chemin réseau peut lire son trafic, y compris le mot de passe du BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s : utilise l'authentification Basic car le BMC ne propose aucun service de session ; chaque requête transporte le mot de passe."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s : une session est peut-être restée ouverte sur le BMC ; la prochaine exécution la supprimera après la connexion."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s : %d connexions de session consécutives ont perdu leur réponse, les connexions ont donc été arrêtées. Vérifiez la liste des sessions du BMC, puis utilisez Réessayer maintenant."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s : le BMC a rejeté l'identifiant. Aucune nouvelle tentative ne sera effectuée tant que l'identifiant n'aura pas changé."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s : son identifiant est manquant ou ne possède aucun mot de passe enregistré."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s : %d liens dans ses réponses pointaient ailleurs et ont été ignorés."

