msgstr "Ligne %d : le nom %s est déjà utilisé."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Ligne %d : aucun équipement Cacti ne porte l'ID %d."

