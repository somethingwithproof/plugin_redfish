msgstr "زیادہ سے زیادہ جواب کا حجم"

#: lib/Settings.php
msgid "Freshness"
msgstr "تازگی"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "جمع کرنے کے وہ وقفے جن کے بعد ریڈنگ کو تاخیر شدہ دکھایا جاتا ہے۔"

#: lib/Settings.php
msgid "Delayed After"
msgstr "اس کے بعد تاخیر شدہ"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "جمع کرنے کے وہ وقفے جن کے بعد ریڈنگ پرانی ہو جاتی ہے اور نامعلوم کے طور پر پڑھی جاتی ہے۔ یہ ہمیشہ 'اس کے بعد تاخیر شدہ' سے کم از کم ایک زیادہ ہوتا ہے۔"

#: lib/Settings.php
msgid "Stale After"
msgstr "اس کے بعد پرانا قرار دیں"

#: lib/Settings.php
msgid "Uninstall"
msgstr "ان انسٹال کریں"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "ان انسٹال پر پلگ ان ٹیبلز برقرار رکھیں"

