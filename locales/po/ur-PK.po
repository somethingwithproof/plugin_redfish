msgstr "CSV فائل"

#: lib/BmcsPage.php
#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "کالموں والی ہیڈر قطار: %s۔ محفوظ کردہ اسناد کا نام دیں؛ فائل میں کبھی پاس ورڈ نہ ڈالیں۔ ہر قطار کا درست ہونا ضروری ہے ورنہ کچھ بھی درآمد نہیں ہوگا۔"

#: lib/BmcsPage.php
msgid "Import"
msgstr "درآمد کریں"

#: lib/BmcsPage.php
msgid "Choose a credential"
msgstr "کوئی اسناد منتخب کریں"

#: lib/BmcsPage.php
msgid "None"
msgstr "کوئی نہیں"

#: lib/BmcsPage.php
#, php-format
msgid "Deleted device (ID %d)"
msgstr "حذف شدہ ڈیوائس (ID %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "نیا Redfish BMC"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "Redfish BMC: %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "BMC کا ہوسٹ نام یا IP پتہ، https:// یا کسی راستے کے بغیر۔"

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "جب 'تصدیق نہ کریں' سیٹ کیا جاتا ہے تو اسے لاگ کیا جاتا ہے اور جب تک یہ برقرار رہتا ہے صحت کے صفحے پر انتباہ کے طور پر دکھایا جاتا ہے۔"

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "CA بنڈل فائل"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "CA بنڈل موڈ کے لیے: پولر پر کسی ایسی PEM فائل کا مکمل راستہ جس میں دوسرے ترمیم نہ کر سکیں۔"

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "پن شدہ موڈ کے لیے: BMC پبلک کی کا base64 SHA-256، بطور sha256//... یا سادہ ہیش۔ تبدیل شدہ کلید اس وقت تک ناکام رہتی ہے جب تک اسے اپ ڈیٹ نہ کیا جائے۔"

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "پبلک کی پن"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "بنیادی توثیق فال بیک کی اجازت دیں"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "صرف اس وقت استعمال ہوتا ہے جب BMC کوئی سیشن سروس فراہم نہ کرے۔ اس کے بعد ہر درخواست میں پاس ورڈ شامل ہوتا ہے؛ اس کے استعمال کے دوران صحت کا صفحہ انتباہ دکھاتا ہے۔"

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "اس سرور کی Cacti ڈیوائس جس کا یہ BMC انتظام کرتا ہے۔ فہرست سے پلگ ان کے ذریعے ڈیوائس بنوانے کے لیے اسے 'کوئی نہیں' پر چھوڑ دیں۔"

#: lib/BmcsPage.php lib/CredentialsPage.php
msgid "Save"
msgstr "محفوظ کریں"

#: lib/BmcsPage.php
#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "پتہ: %s پورٹ %d پہلے ہی %s کے طور پر رجسٹرڈ ہے۔"

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "پتہ: یہ پتہ اور پورٹ پہلے ہی رجسٹرڈ ہیں۔"

#: lib/BmcsPage.php
msgid "Name: another BMC already uses this name."
msgstr "نام: ایک اور BMC پہلے ہی یہ نام استعمال کر رہا ہے۔"

#: lib/BmcsPage.php
msgid "Device: no Cacti device has this ID."
msgstr "ڈیوائس: کسی Cacti ڈیوائس کا یہ ID نہیں ہے۔"

#: lib/BmcsPage.php
msgid "Device: another BMC is already mapped to this device."
msgstr "ڈیوائس: ایک اور BMC پہلے ہی اس ڈیوائس سے منسلک ہے۔"

#: lib/CredentialsPage.php lib/Pages.php
msgid "Redfish Credentials"
msgstr "Redfish اسناد"

#: lib/CredentialsPage.php
msgid "Password"
msgstr "پاس ورڈ"

#: lib/CredentialsPage.php
msgid "Used By"
msgstr "استعمال کنندہ"

#: lib/CredentialsPage.php
msgid "User Name"
msgstr "صارف کا نام"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "ابھی تک کوئی اسناد نہیں ہیں۔ صرف پڑھنے کے BMC اکاؤنٹ کے ساتھ ایک بنائیں۔"

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "کچھ محفوظ نہیں"

#: lib/CredentialsPage.php
msgid "Stored"
msgstr "محفوظ شدہ"

#: lib/CredentialsPage.php
#, php-format
msgid "%d BMCs"
msgstr "%d BMCs"

#: lib/CredentialsPage.php
msgid "New Redfish Credential"
msgstr "نئی Redfish اسناد"

#: lib/CredentialsPage.php
#, php-format
msgid "Redfish Credential: %s"
msgstr "Redfish اسناد: %s"

#: lib/CredentialsPage.php
msgid "A BMC account with the ReadOnly role. The plugin never needs a role that can change BMC state."
msgstr "ReadOnly کردار والا BMC اکاؤنٹ۔ پلگ ان کو کبھی ایسے کردار کی ضرورت نہیں ہوتی جو BMC کی حالت بدل سکے۔"

#: lib/CredentialsPage.php
msgid "A password is stored. Leave blank to keep it."
msgstr "ایک پاس ورڈ محفوظ ہے۔ اسے برقرار رکھنے کے لیے خالی چھوڑ دیں۔"

#: lib/CredentialsPage.php
msgid "Stored encrypted with the vault key."
msgstr "والٹ کی کے ساتھ خفیہ طور پر محفوظ کردہ۔"

#: lib/DeviceProvisioner.php
msgid "The Redfish templates are not installed completely. Reinstall them from the Redfish BMCs page."
msgstr "Redfish ٹیمپلیٹس مکمل طور پر انسٹال نہیں ہیں۔ انہیں Redfish BMCs کے صفحے سے دوبارہ انسٹال کریں۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off. Its host name is a reserved name that is never contacted."
msgstr "ایک ڈیوائس \"%s\" جو %s ڈیوائس ٹیمپلیٹ سے بنائی گئی ہے، پولر %d کے ذریعے پول کی جاتی ہے، اور دستیابی کی جانچ بند ہے۔ اس کا ہوسٹ نام ایک مخصوص نام ہے جس سے کبھی رابطہ نہیں کیا جاتا۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", with a graph for each of the %d members known now."
msgstr "ڈیٹا کیوری \"%s\"، جس میں ابھی معلوم ہونے والے %d اراکین میں سے ہر ایک کے لیے ایک گراف ہے۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d fans or power supplies that were present are no longer reported. They count as failed until you confirm; confirming accepts the members the BMC reports now."
msgstr "%d پنکھے یا پاور سپلائز جو پہلے موجود تھیں اب رپورٹ نہیں ہو رہیں۔ آپ کی تصدیق تک انہیں ناکام شمار کیا جاتا ہے؛ تصدیق کرنے سے وہ اراکین قبول ہو جاتے ہیں جنہیں BMC اب رپورٹ کرتا ہے۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "The graph \"%s\", with its \"%s\" data source."
msgstr "گراف \"%s\"، اس کے \"%s\" ڈیٹا سورس کے ساتھ۔"

#: lib/DeviceProvisioner.php
msgid "The BMC is already mapped to a device."
msgstr "BMC پہلے ہی ایک ڈیوائس سے منسلک ہے۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Redfish plugin for BMC %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "BMC %s کے لیے Redfish پلگ ان کے ذریعے بنایا گیا۔ اس کی قدریں پلگ ان کیشے سے آتی ہیں؛ ہوسٹ نام ایک مخصوص نام ہے جس سے کبھی رابطہ نہیں کیا جاتا۔"

#: lib/DeviceProvisioner.php
msgid "Cacti refused to create the device. See the Cacti log."
msgstr "Cacti نے ڈیوائس بنانے سے انکار کر دیا۔ Cacti لاگ دیکھیں۔"

#: lib/DeviceProvisioner.php
msgid "The new device would be hidden from you by your device permissions, so it was removed again. Ask an administrator to grant access, or map the BMC to a device you can see."
msgstr "نئی ڈیوائس آپ کی ڈیوائس کی اجازتوں کی وجہ سے آپ سے پوشیدہ رہتی، اس لیے اسے دوبارہ ہٹا دیا گیا۔ منتظم سے رسائی دینے کو کہیں، یا BMC کو کسی ایسی ڈیوائس سے منسلک کریں جسے آپ دیکھ سکیں۔"

#: lib/DeviceProvisioner.php
msgid "The BMC was mapped to a device by someone else meanwhile, or could not be mapped, so the new device was removed again. Reload the page and check its mapping."
msgstr "اس دوران کسی اور نے BMC کو کسی ڈیوائس سے منسلک کر دیا، یا اسے منسلک نہیں کیا جا سکا، اس لیے نئی ڈیوائس دوبارہ ہٹا دی گئی۔ صفحہ دوبارہ لوڈ کریں اور اس کی میپنگ چیک کریں۔"

#: lib/DeviceWarnings.php
