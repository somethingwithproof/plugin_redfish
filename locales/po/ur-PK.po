#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "کلیکشن کی تازگی اور ڈیوائس گرافس چیک کریں۔ دوبارہ کوشش اگلے طے شدہ رن کے لیے کلیکشن ہولڈ کو ختم کر دیتا ہے؛ یہ ابھی BMC سے رابطہ نہیں کرتا۔"

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "فائل خالی ہے یا 1 MiB سے بڑی ہے۔"

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "فائل پڑھی نہیں جا سکی۔"

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "فائل میں کوئی ہیڈر قطار نہیں ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "فائل میں \"%s\" نامی ایک کالم ہے۔ درآمد کی جانے والی فائلوں میں خفیہ معلومات نہیں ہونی چاہئیں؛ اس کے بجائے credential کالم میں محفوظ کردہ کریڈینشل کا نام درج کریں۔ کچھ بھی درآمد نہیں کیا گیا۔"

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "ہیڈر میں صرف ان کالموں کے نام، ہر ایک صرف ایک بار، شامل ہونے چاہئیں، بشمول name، address، اور credential: %s۔"

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "فائل میں %d سے زیادہ قطاریں ہیں۔"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "سطر %d: %d فیلڈز متوقع تھے، %d ملے۔"

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "کریڈینشل: \"%s\" نام کا کوئی محفوظ کردہ کریڈینشل موجود نہیں ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "سطر %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "سطر %d: پتہ %s پورٹ %d پہلے ہی %s کے طور پر رجسٹرڈ ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "سطر %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "لائن %d: نام %s پہلے ہی استعمال میں ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "لائن %d: کسی Cacti ڈیوائس کا ID %d نہیں ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "لائن %d: ڈیوائس %d میں پہلے ہی BMC %s موجود ہے۔"

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "لائن %d کا"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "فائل میں کوئی BMC قطاریں نہیں ہیں۔"

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "نام: کنٹرول کریکٹرز کے بغیر 1 سے 100 حروف درج کریں۔"

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "پتہ: صرف ہوسٹ کا نام یا IP پتہ درج کریں، بغیر کسی اسکیم، پورٹ، راستے، یا صارف نام کے۔ لوپ بیک، لنک لوکل، ملٹی کاسٹ، اور غیر متعین پتے مسترد کر دیے جاتے ہیں۔"

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "پورٹ: 1 سے 65535 تک کوئی TCP پورٹ درج کریں۔"

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "پولر: اس ریلیز میں صرف مرکزی پولر ہی BMCs جمع کر سکتا ہے۔"

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "ڈیوائس: کوئی Cacti ڈیوائس منتخب کریں یا کوئی نہیں منتخب کریں۔"

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "اسناد: محفوظ کردہ اسناد میں سے کسی کا انتخاب کریں۔"

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS تصدیق: درج کردہ طریقوں میں سے ایک منتخب کریں۔"

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA بنڈل فائل: کنٹرول حروف کے بغیر ایک مکمل راستہ درج کریں، زیادہ سے زیادہ 512 حروف۔"

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "پبلک کی پن: BMC پبلک کی کا base64 SHA-256 ہیش درج کریں، اختیاری طور پر sha256// سابقے کے ساتھ۔"

