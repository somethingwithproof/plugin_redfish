#: lib/BmcsPage.php
msgid "Everything is already in place. Confirming indexes the data queries again and adds graphs for new members only."
msgstr "سب کچھ پہلے ہی اپنی جگہ پر موجود ہے۔ تصدیق کرنے سے ڈیٹا کیوریز دوبارہ انڈیکس ہو جاتی ہیں اور صرف نئے اراکین کے لیے گراف شامل ہوتے ہیں۔"

#: lib/BmcsPage.php
msgid "Confirming adds:"
msgstr "تصدیق کرنے سے شامل ہوتا ہے:"

#: lib/BmcsPage.php
msgid "Existing devices, graphs, and thresholds are not changed."
msgstr "موجودہ ڈیوائسز، گراف، اور حدیں تبدیل نہیں کی جاتیں۔"

#: lib/BmcsPage.php
