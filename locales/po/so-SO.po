#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Faylka furaha khasnadda lama isticmaali karo: %s. Erayada sirta ah ee kaydsan lama akhrin karo lamana qori karo ilaa laga hagaajiyo."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Ururiyaha ku jira poller %d wuxuu qaatay %.0f ilbiriqsi, taas oo ka badan miisaaniyaddiisa oo ah %d ilbiriqsi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Ururiyaha ku jira poller %d wakhtiga ayaa ka dhammaaday ka hor intaan BMC kasta la akhrin; inta hartay waxay sii socon doontaa orodka xiga. Ku dar hawlwadeenno ama kordhi miisaaniyadda."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Ururiyaha ku jira poller %d wuxuu ugu dambayn shaqeeyay %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: xaqiijinta TLS way dansan tahay. Qof kasta oo waddada ku jira wuu akhrin karaa taraafikada, oo ay ku jirto erayga sirta ah ee BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: wuxuu isticmaalaa xaqiijinta Basic sababtoo ah BMC ma bixiyo adeeg fadhi; codsi kasta wuxuu qaadaa erayga sirta ah."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: fadhi ayaa laga yaabaa inuu ku furnaa BMC; orodka xiga wuu tirtiri doonaa ka dib marka la soo galo."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d gelitaan fadhi oo isku xigta ayaa lumiyay jawaabtooda, sidaas darteed gelitaannadu way istaageen. Hubi liiska fadhiga BMC, ka dibna isticmaal Isku day Hadda."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC wuu diiday aqoonsiga. Mar kale lama isku dayayo ilaa aqoonsigu isbeddelo."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: aqoonsigiisu waa maqan yahay ama ma laha eray sir ah oo kaydsan."

#: lib/HealthWarnings.php
#, php-format
