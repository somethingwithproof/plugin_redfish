#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Hubi cusboonaanta ururinta iyo garaafyada qalabka. Isku-dayga mar kale wuxuu sii daayaa hakinta ururinta ee socodka xiga ee loo qorsheeyay; hadda lama xiriiro BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Faylku waa madhan yahay ama wuxuu ka weyn yahay 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Faylka lama akhrin karin."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Faylku ma laha saf madax ah."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Faylku wuxuu leeyahay tiir lagu magacaabo \"%s\". Faylasha la soo geliyo waa inaysan xambaarin siraha; beddelkeeda ku magacaw aqoonsi kaydsan tiirka aqoonsiga. Waxba lama soo gelin."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Madaxu waa inuu magacaabaa tiirarkan oo keliya, midkiiba hal mar, oo ay ku jiraan name, address, iyo credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Faylku wuxuu leeyahay wax ka badan %d saf."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Safka %d: waxaa la filayay %d goobood, waxaa la helay %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Aqoonsiga: ma jiro aqoonsi kaydsan oo lagu magacaabo \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Safka %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Safka %d: ciwaanka %s dekedda %d waxay horay ugu diiwaangashan tahay %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "safka %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Safka %d: magaca %s horay ayaa loo isticmaalay."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Safka %d: ma jiro qalab Cacti ah oo leh ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Safka %d: qalabka %d wuxuu horay u leeyahay BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "ee safka %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Faylku ma laha safaf BMC ah."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Magaca: geli 1 ilaa 100 xaraf oo aan lahayn xarfaha xakamaynta."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Cinwaanka: geli magaca martigeliyaha ama cinwaanka IP oo keliya, iyada oo aan lahayn hab-maamuus, deked, waddo, ama magaca isticmaalaha. Cinwaanada loopback, link-local, multicast, iyo kuwa aan la cayimin waa la diidaa."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Dekedda: geli dekedda TCP laga bilaabo 1 ilaa 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: poller-ka ugu weyn oo keliya ayaa soo ururin kara BMCs sii-dayntan."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Qalabka: dooro qalab Cacti ah ama waxba ha dooran."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Aqoonsiga: dooro aqoonsi kaydsan."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Xaqiijinta TLS: dooro mid ka mid ah hababka ku qoran."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Faylka Xirmada CA: geli waddo buuxda oo aan lahayn xarfaha xakamaynta, ugu badnaan 512 xaraf."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Biinka Furaha Dadweynaha: geli hash-ka base64 SHA-256 ee furaha dadweynaha BMC, iyadoo si ikhtiyaari ah looga horreysiin karo sha256//."

