#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Mkusanyaji kwenye poller %d alichukua sekunde %.0f, zaidi ya bajeti yake ya sekunde %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Mkusanyaji kwenye poller %d aliishiwa na muda kabla ya kila BMC kusomwa; zilizobaki zitaendelea kwenye uendeshaji ujao. Ongeza wafanyakazi au pandisha bajeti."

