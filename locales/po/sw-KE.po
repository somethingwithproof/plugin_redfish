#: lib/Settings.php
#, php-format
msgid "%s Default %d, from %d to %d."
msgstr "%s Chaguo-msingi %d, kuanzia %d hadi %d."

#: lib/Settings.php
msgid "Credential Vault"
msgstr "Vault ya Vitambulisho"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "Faili ya Ufunguo wa Vault"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "Njia kamili kwenda kwenye ufunguo wa baiti 32 unaosimba manenosiri ya BMC yaliyohifadhiwa. Iunde mwenyewe, nje ya mzizi wa wavuti, inayoweza kusomwa tu na seva ya wavuti na mtumiaji wa poller, katika saraka ambayo ni root na mtumiaji huyo pekee wanaweza kuandika; programu-jalizi haiiundi wala kuiandika kamwe. Hifadhi nakala yake pamoja na hifadhidata: bila hiyo, manenosiri yaliyohifadhiwa lazima yawekwe tena."

#: lib/Settings.php
msgid "Collector"
msgstr "Kikusanyaji"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "Kipindi cha Ukusanyaji"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "Sekunde kati ya usomaji wa kila BMC."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "Kipindi cha Ugunduzi Upya"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "Sekunde kati ya ugunduzi kamili wa rasilimali wa kila BMC. BMC pia hugunduliwa upya mara moja wakati rasilimali inayojulikana inapotoweka au kubadilisha aina."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "Bajeti ya Muda ya Kikusanyaji"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "Sekunde ambazo uendeshaji mmoja wa mkusanyaji unaweza kutumia kabla haujasimamisha kuanza BMC mpya. Iweke chini ya kipindi cha poller; BMC ambazo hazijakamilika zitaendelea kwenye uendeshaji ujao."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "BMC zinazosomwa kwa sambamba. Kila BMC inasomwa na mfanyakazi mmoja kwa wakati mmoja."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "Wafanyakazi wa Mkusanyaji"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Muda wa Mwisho wa Kuunganisha"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "Sekunde zinazoruhusiwa kwa muunganisho wa TCP na makubaliano ya TLS kwa BMC."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "Muda wa Mwisho wa Ombi"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "Sekunde zinazoruhusiwa kwa ombi moja kamili kwa BMC, ikiwa ni pamoja na muunganisho."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "KiB zinazokubaliwa katika mwili mmoja wa majibu ya BMC; majibu makubwa zaidi yanakataliwa."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "Ukubwa wa Juu wa Majibu"

#: lib/Settings.php
msgid "Freshness"
msgstr "Upya"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "Vipindi vya ukusanyaji ambavyo baada yake usomaji huonyeshwa kama uliochelewa."

#: lib/Settings.php
msgid "Delayed After"
msgstr "Imechelewa Baada Ya"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "Vipindi vya ukusanyaji ambavyo baada yake usomaji unakuwa umepitwa na wakati na unasoma kama haujulikani. Daima angalau moja zaidi ya Imechelewa Baada Ya."

#: lib/Settings.php
msgid "Stale After"
msgstr "Ipitwe na Wakati Baada ya"

#: lib/Settings.php
msgid "Uninstall"
msgstr "Sakinusha"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Weka Majedwali ya Programu-jalizi Wakati wa Kusakinusha"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "Inapowekwa tiki, kuondoa programu-jalizi huhifadhi sajili yake ya BMC, manenosiri yaliyosimbwa fiche, na akiba ya usomaji. Ondoa tiki ili kuondoa programu-jalizi kuvifuta. Kuondoa hakugusi kamwe vifaa vya Cacti, grafu, au BMC, ikiwa ni pamoja na vifaa ambavyo programu-jalizi iliviunda."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "Thibitisha dhidi ya hifadhi ya CA ya mfumo"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "Thibitisha dhidi ya faili ya kifurushi cha CA"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "Ufunguo wa umma uliopiniwa (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "Usithibitishe (si salama)"

