#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Kagua upya wa ukusanyaji na grafu za kifaa. Jaribu Tena huachia zuio la ukusanyaji kwa uendeshaji ujao uliopangwa; haiwasiliani na BMC sasa."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Faili ni tupu au ni kubwa kuliko 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Faili haikuweza kusomwa."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Faili haina safumlalo ya kichwa."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Faili ina safuwima inayoitwa \"%s\". Faili za kuleta hazipaswi kubeba siri; badala yake taja kitambulisho kilichohifadhiwa katika safuwima ya credential. Hakuna kilicholetwa."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Kichwa lazima kitaje safuwima hizi pekee, kila moja mara moja, ikiwemo name, address, na credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Faili ina safumlalo zaidi ya %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Mstari %d: sehemu %d zilitarajiwa, zimepatikana %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Kitambulisho: hakuna kitambulisho kilichohifadhiwa kinachoitwa \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Mstari %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Mstari %d: anwani %s lango %d tayari imesajiliwa kama %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "mstari %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Mstari %d: jina %s tayari linatumika."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Mstari %d: hakuna kifaa cha Cacti chenye kitambulisho %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Mstari %d: kifaa %d tayari kina BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "ya mstari %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Faili haina safu mlalo za BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Jina: weka vibambo 1 hadi 100 bila vibambo vya udhibiti."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Anwani: weka jina la seva pangishi au anwani ya IP pekee, bila muundo wa itifaki, lango, njia, au jina la mtumiaji. Anwani za loopback, link-local, multicast, na zisizoainishwa zinakataliwa."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Lango: weka lango la TCP kuanzia 1 hadi 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: ni poller kuu pekee inayoweza kukusanya BMC katika toleo hili."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Kifaa: chagua kifaa cha Cacti au usiweke chochote."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Taarifa ya utambulisho: chagua taarifa ya utambulisho iliyohifadhiwa."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Uthibitishaji wa TLS: chagua mojawapo ya hali zilizoorodheshwa."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Faili ya Kifurushi cha CA: weka njia kamili bila herufi za udhibiti, isiyozidi herufi 512."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pini ya Ufunguo wa Umma: weka hashi ya base64 SHA-256 ya ufunguo wa umma wa BMC, kwa hiari ikiwa na kiambishi awali sha256//."

