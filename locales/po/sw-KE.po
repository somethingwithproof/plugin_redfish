msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: uthibitishaji wa TLS umezimwa. Yeyote aliye njiani anaweza kusoma trafiki yake, ikiwa ni pamoja na nenosiri la BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: inatumia uthibitishaji wa Basic kwa sababu BMC haitoi huduma ya kipindi; kila ombi linabeba nenosiri."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: kipindi huenda kiliachwa wazi kwenye BMC; uendeshaji ujao utakifuta baada ya kuingia."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: uingiaji wa kipindi %d mfululizo ulipoteza majibu yake, kwa hivyo uingiaji ulisimama. Angalia orodha ya vipindi vya BMC, kisha tumia Jaribu Tena Sasa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC ilikataa taarifa ya utambulisho. Haitajaribiwa tena hadi taarifa ya utambulisho ibadilike."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: taarifa yake ya utambulisho haipo au haina nenosiri lililohifadhiwa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: viungo %d katika majibu yake vilielekeza kwingine na vilipuuzwa."

