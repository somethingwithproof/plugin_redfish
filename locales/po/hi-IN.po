#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "संग्रह की ताज़गी और डिवाइस ग्राफ़ जाँचें। पुनः प्रयास अगले निर्धारित रन के लिए संग्रह रोक हटाता है; अभी BMC से संपर्क नहीं करता।"

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "फ़ाइल खाली है या 1 MiB से बड़ी है।"

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "फ़ाइल पढ़ी नहीं जा सकी।"

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "फ़ाइल में शीर्षक पंक्ति नहीं है।"

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "फ़ाइल में \"%s\" नाम का कॉलम है। आयात फ़ाइल में गोपनीय जानकारी नहीं होनी चाहिए; credential कॉलम में संग्रहीत क्रेडेंशियल का नाम दें। कुछ आयात नहीं हुआ।"

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "शीर्षक में केवल ये कॉलम एक-एक बार हों और name, address तथा credential शामिल हों: %s।"

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "फ़ाइल में %d से अधिक पंक्तियाँ हैं।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "पंक्ति %d: अपेक्षित %d फ़ील्ड, मिले %d।"

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "क्रेडेंशियल: \"%s\" नाम का कोई संग्रहीत क्रेडेंशियल नहीं है।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "पंक्ति %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "पंक्ति %d: पता %s पोर्ट %d पहले से %s के रूप में पंजीकृत है।"

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "पंक्ति %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "पंक्ति %d: नाम %s पहले से उपयोग में है।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "पंक्ति %d: ID %d वाला कोई Cacti डिवाइस नहीं है।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "पंक्ति %d: डिवाइस %d का BMC पहले से %s है।"

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "पंक्ति %d का"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "फ़ाइल में BMC पंक्तियाँ नहीं हैं।"

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "नाम: नियंत्रण वर्णों के बिना 1 से 100 वर्ण दर्ज करें।"

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "पता: केवल होस्टनाम या IP पता दें, स्कीम, पोर्ट, पथ या उपयोगकर्ता नाम नहीं। लूपबैक, लिंक-लोकल, मल्टीकास्ट और अनिर्दिष्ट पते अस्वीकृत हैं।"

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "पोर्ट: 1 से 65535 तक TCP पोर्ट दें।"

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "पोलर: इस संस्करण में केवल मुख्य पोलर BMC से संग्रह कर सकता है।"

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "डिवाइस: Cacti डिवाइस या कोई नहीं चुनें।"

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "क्रेडेंशियल: संग्रहीत क्रेडेंशियल चुनें।"

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS सत्यापन: सूचीबद्ध मोड में से एक चुनें।"

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA बंडल फ़ाइल: नियंत्रण वर्णों के बिना अधिकतम 512 वर्णों का पूर्ण पथ दें।"

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "सार्वजनिक कुंजी पिन: BMC सार्वजनिक कुंजी का base64 SHA-256 हैश दें; sha256// उपसर्ग वैकल्पिक है।"

#: lib/BmcRepository.php
msgid "another BMC"
msgstr "दूसरा BMC"

