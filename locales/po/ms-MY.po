#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Fail kunci peti besi tidak dapat digunakan: %s. Kata laluan yang disimpan tidak boleh dibaca atau ditulis sehingga ia dibaiki."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Pengumpul pada poller %d mengambil masa %.0f saat, melebihi peruntukannya sebanyak %d saat."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Pengumpul pada poller %d kehabisan masa sebelum setiap BMC selesai dibaca; selebihnya akan disambung pada larian seterusnya. Tambah pekerja atau naikkan peruntukan masa."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Pengumpul pada poller %d kali terakhir dijalankan pada %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: pengesahan TLS dimatikan. Sesiapa sahaja di sepanjang laluan boleh membaca trafiknya, termasuk kata laluan BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: menggunakan pengesahan Basic kerana BMC tidak menawarkan perkhidmatan sesi; setiap permintaan membawa kata laluan."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: suatu sesi mungkin dibiarkan terbuka pada BMC; larian seterusnya akan memadamkannya selepas log masuk."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d log masuk sesi berturut-turut kehilangan responsnya, jadi log masuk dihentikan. Semak senarai sesi BMC, kemudian gunakan Cuba Semula Sekarang."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC menolak kelayakan tersebut. Ia tidak akan dicuba lagi sehingga kelayakan berubah."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: kelayakannya tiada atau tidak mempunyai kata laluan yang disimpan."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d pautan dalam responsnya menghala ke tempat lain dan telah diabaikan."

