#: lib/Settings.php
#, php-format
msgid "%s Default %d, from %d to %d."
msgstr "%s Lalai %d, dari %d hingga %d."

#: lib/Settings.php
msgid "Credential Vault"
msgstr "Peti Besi Kelayakan"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "Fail Kunci Peti Besi"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "Laluan mutlak ke kunci 32-bait yang menyulitkan kata laluan BMC yang disimpan. Ciptanya sendiri, di luar akar web, hanya boleh dibaca oleh pelayan web dan pengguna poller, dalam direktori yang hanya root dan pengguna tersebut boleh tulis; pemalam tidak pernah mencipta atau menulisnya. Sandarkannya bersama pangkalan data: tanpanya, kata laluan yang disimpan mesti dimasukkan semula."

#: lib/Settings.php
msgid "Collector"
msgstr "Pengumpul"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "Selang Pengumpulan"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "Saat antara bacaan setiap BMC."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "Selang Penemuan Semula"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "Saat antara penemuan sumber penuh bagi setiap BMC. BMC juga ditemui semula dengan serta-merta apabila sumber yang diketahui hilang atau bertukar jenis."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "Belanjawan Masa Pengumpul"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "Saat yang boleh diambil oleh satu larian pengumpul sebelum ia berhenti memulakan BMC baharu. Pastikan ia di bawah selang poller; BMC yang belum selesai akan disambung pada larian seterusnya."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "BMC dibaca secara selari. Setiap BMC dibaca oleh seorang pekerja pada satu-satu masa."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "Pekerja Pengumpul"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Tamat Masa Sambungan"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "Saat yang dibenarkan untuk sambungan TCP dan jabat tangan TLS ke BMC."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "Tamat Masa Permintaan"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "Saat yang dibenarkan untuk satu permintaan penuh ke BMC, termasuk sambungan."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "KiB yang diterima dalam satu badan respons BMC; respons yang lebih besar akan ditolak."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "Saiz Respons Maksimum"

#: lib/Settings.php
msgid "Freshness"
msgstr "Kesegaran"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "Selang pengumpulan yang selepasnya sesuatu bacaan dipaparkan sebagai tertunda."

#: lib/Settings.php
msgid "Delayed After"
msgstr "Tertunda Selepas"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "Selang pengumpulan yang selepasnya sesuatu bacaan dianggap lapuk dan terbaca sebagai tidak diketahui. Sentiasa sekurang-kurangnya satu lebih daripada Tertunda Selepas."

#: lib/Settings.php
msgid "Stale After"
msgstr "Lapuk Selepas"

#: lib/Settings.php
msgid "Uninstall"
msgstr "Nyahpasang"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Kekalkan Jadual Pemalam semasa Nyahpasang"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "Apabila ditandakan, menyahpasang pemalam akan mengekalkan pendaftaran BMC, kata laluan tersulit, dan cache bacaannya. Kosongkannya supaya penyahpasangan menggugurkannya. Penyahpasangan tidak pernah menyentuh peranti Cacti, graf, atau BMC, termasuk peranti yang dicipta oleh pemalam."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "Sahkan dengan stor CA sistem"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "Sahkan dengan fail himpunan CA"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "Kunci awam dipin (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "Jangan sahkan (tidak selamat)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "Anda tidak mempunyai akses ke peranti Cacti bagi BMC ini."

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "BMC tidak dapat disimpan."

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "BMC telah disimpan."

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "BMC dan data cachenya telah dipadamkan. Peranti Cactinya dibiarkan di tempatnya."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "Penundaan dan kegagalan yang ditahan telah dikosongkan; pengumpul akan membaca BMC pada larian seterusnya."

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "Penambahan peranti dan graf memerlukan kebenaran pengurusan peranti Cacti."

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "Peranti bagi BMC ini telah dipadamkan. Pilih peranti lain, atau tiada, pada borang BMC terlebih dahulu."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "Pertanyaan data telah diindeks semula dan %d graf telah ditambah."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "Peranti tersebut telah dicipta bersama graf Redfishnya."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Pemasangan templat Redfish memerlukan kebenaran Import Templat Cacti."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Templat Redfish telah dipasang."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "Templat Redfish tidak dapat dipasang. Halaman kesihatan menunjukkan sebabnya."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "Import tidak dapat disimpan; tiada apa-apa yang diimport."

#: redfish_bmcs.php
#, php-format
msgid "%d BMCs were imported."
msgstr "%d BMC telah diimport."

#: redfish_credentials.php
msgid "This credential is used by a BMC on a Cacti device you do not have access to, so it cannot be changed here."
msgstr "Kelayakan ini digunakan oleh BMC pada peranti Cacti yang anda tidak mempunyai akses, jadi ia tidak boleh diubah di sini."

#: redfish_credentials.php
msgid "Name: another credential already uses this name."
msgstr "Nama: kelayakan lain sudah menggunakan nama ini."

#: redfish_credentials.php
msgid "User Name: enter 1 to 255 characters without control characters."
msgstr "Nama Pengguna: masukkan 1 hingga 255 aksara tanpa aksara kawalan."

#: redfish_credentials.php
msgid "Password: enter the password of the BMC account."
msgstr "Kata Laluan: masukkan kata laluan bagi akaun BMC."

#: redfish_credentials.php
#, php-format
msgid "The credential was saved, but the password was not stored: %s"
msgstr "Kelayakan telah disimpan, tetapi kata laluan tidak disimpan: %s"

#: redfish_credentials.php
msgid "The credential could not be saved."
msgstr "Kelayakan tidak dapat disimpan."

#: redfish_credentials.php
msgid "The credential was saved."
msgstr "Kelayakan telah disimpan."

#: redfish_credentials.php
msgid "The credential and its stored password were deleted."
msgstr "Kelayakan dan kata laluan yang disimpannya telah dipadamkan."

#: redfish_credentials.php
msgid "The credential was not deleted. A credential in use by a BMC cannot be deleted."
msgstr "Kelayakan tidak dipadamkan. Kelayakan yang sedang digunakan oleh BMC tidak boleh dipadamkan."

#: redfish_operator.php
msgid "Retry collection"
msgstr "Cuba semula pengumpulan"

#: redfish_operator.php
msgid "Monitoring view"
msgstr "Paparan pemantauan"

#: redfish_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Pemerhatian tidak dapat dibaca. Minta pentadbir menyemak log pemalam."

