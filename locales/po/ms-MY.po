#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Semak kesegaran pengumpulan dan graf peranti. Cuba semula melepaskan tahanan pengumpulan untuk larian berjadual seterusnya; ia tidak menghubungi BMC sekarang."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Fail kosong atau lebih besar daripada 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Fail tidak dapat dibaca."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Fail tiada baris pengepala."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Fail mempunyai lajur bernama \"%s\". Fail import tidak boleh membawa rahsia; namakan kelayakan tersimpan dalam lajur credential sebaliknya. Tiada apa-apa diimport."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Pengepala mesti menamakan hanya lajur ini, setiap satu sekali, termasuk name, address dan credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Fail mempunyai lebih daripada %d baris."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Baris %d: menjangkakan %d medan, menemui %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Kelayakan: tiada kelayakan tersimpan bernama \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Baris %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Baris %d: alamat %s port %d sudah didaftarkan sebagai %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "baris %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Baris %d: nama %s sudah digunakan."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Baris %d: tiada peranti Cacti yang mempunyai ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Baris %d: peranti %d sudah mempunyai BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "daripada baris %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Fail ini tidak mempunyai baris BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nama: masukkan 1 hingga 100 aksara tanpa aksara kawalan."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Alamat: masukkan nama hos atau alamat IP sahaja, tanpa skema, port, laluan, atau nama pengguna. Alamat gelung balik, pautan setempat, multisiar, dan tidak ditentukan akan ditolak."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: masukkan port TCP dari 1 hingga 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: hanya poller utama boleh mengumpul BMC dalam keluaran ini."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Peranti: pilih peranti Cacti atau tiada."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Kelayakan: pilih kelayakan yang disimpan."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Pengesahan TLS: pilih salah satu mod yang disenaraikan."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Fail Himpunan CA: masukkan laluan mutlak tanpa aksara kawalan, maksimum 512 aksara."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin Kunci Awam: masukkan cincangan SHA-256 base64 bagi kunci awam BMC, secara pilihan diawali dengan sha256//."

