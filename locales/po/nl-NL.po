#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Naam: voer 1 tot 100 tekens in zonder besturingstekens."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adres: voer alleen een hostnaam of een IP-adres in, zonder schema, poort, pad of gebruikersnaam. Loopback-, link-local-, multicast- en niet-gespecificeerde adressen worden geweigerd."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Poort: voer een TCP-poort van 1 tot 65535 in."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: alleen de hoofdpoller kan in deze versie BMC's verzamelen."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Apparaat: kies een Cacti-apparaat of geen."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Referentie: kies een opgeslagen referentie."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS-verificatie: kies een van de vermelde modi."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA-bundelbestand: voer een absoluut pad zonder stuurtekens in, maximaal 512 tekens."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Vastgezette openbare sleutel: voer de base64 SHA-256-hash van de openbare sleutel van de BMC in, optioneel voorafgegaan door sha256//."

