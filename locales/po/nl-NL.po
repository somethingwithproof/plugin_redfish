msgstr "Regel %d: %d velden verwacht, %d aangetroffen."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Referentie: er bestaat geen opgeslagen referentie met de naam \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Regel %d: %s"

