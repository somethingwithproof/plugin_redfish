msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Het kluissleutelbestand kan niet worden gebruikt: %s. Opgeslagen wachtwoorden kunnen pas weer worden gelezen of geschreven nadat dit is verholpen."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "De collector op poller %d duurde %.0f seconden, meer dan het budget van %d seconden."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "De collector op poller %d had onvoldoende tijd voordat elke BMC was uitgelezen; de rest wordt bij de volgende uitvoering hervat. Voeg workers toe of verhoog het budget."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "De collector op poller %d is voor het laatst uitgevoerd %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS-verificatie is uitgeschakeld. Iedereen op het netwerkpad kan het verkeer meelezen, inclusief het BMC-wachtwoord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: gebruikt Basic-authenticatie omdat de BMC geen sessieservice biedt; elke aanvraag bevat het wachtwoord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: er is mogelijk een sessie opengebleven op de BMC; de volgende uitvoering verwijdert deze na het inloggen."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d sessie-aanmeldingen op rij verloren hun antwoord, dus aanmeldingen zijn gestopt. Controleer de sessielijst van de BMC en gebruik vervolgens Nu opnieuw proberen."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: de BMC heeft de referentie geweigerd. Deze wordt niet opnieuw geprobeerd totdat de referentie wijzigt."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: de bijbehorende referentie ontbreekt of heeft geen opgeslagen wachtwoord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d koppelingen in de antwoorden verwezen naar elders en zijn genegeerd."

