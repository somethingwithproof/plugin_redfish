#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Controleer de actualiteit van de gegevensverzameling en de apparaatgrafieken. Opnieuw proberen heft een blokkade voor de verzameling op voor de volgende geplande uitvoering; er wordt nu geen contact opgenomen met de BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Het bestand is leeg of groter dan 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Het bestand kon niet worden gelezen."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Het bestand heeft geen koptekstrij."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Het bestand bevat een kolom met de naam \"%s\". Importbestanden mogen geen geheimen bevatten; vermeld in plaats daarvan een opgeslagen referentie in de kolom credential. Er is niets geïmporteerd."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "De koptekst mag alleen deze kolommen vermelden, elk één keer, waaronder name, address en credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Het bestand heeft meer dan %d rijen."

#: lib/BmcImport.php
#, php-format
