#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "সংগ্রহের সতেজতা এবং ডিভাইসের গ্রাফগুলো পরীক্ষা করুন। পুনরায় চেষ্টা করলে পরবর্তী নির্ধারিত রানের জন্য সংগ্রহের হোল্ড মুক্ত হয়; এটি এখন BMC-এর সাথে যোগাযোগ করে না।"

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "ফাইলটি খালি অথবা 1 MiB-এর চেয়ে বড়।"

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "ফাইলটি পড়া যায়নি।"

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "ফাইলটিতে কোনো হেডার সারি নেই।"

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "ফাইলটিতে \"%s\" নামের একটি কলাম রয়েছে। ইমপোর্ট ফাইলে গোপন তথ্য থাকা উচিত নয়; এর পরিবর্তে credential কলামে একটি সংরক্ষিত ক্রেডেনশিয়ালের নাম দিন। কোনো কিছু ইমপোর্ট করা হয়নি।"

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "হেডারে শুধুমাত্র এই কলামগুলোর নাম একবার করে থাকতে হবে, যার মধ্যে name, address এবং credential অন্তর্ভুক্ত থাকবে: %s।"

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "ফাইলটিতে %d-টির বেশি সারি রয়েছে।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "লাইন %d: %d-টি ফিল্ড প্রত্যাশিত ছিল, পাওয়া গেছে %d-টি।"

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "ক্রেডেনশিয়াল: \"%s\" নামের কোনো সংরক্ষিত ক্রেডেনশিয়াল নেই।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "লাইন %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "লাইন %d: ঠিকানা %s পোর্ট %d ইতিমধ্যেই %s হিসেবে নিবন্ধিত আছে।"

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "লাইন %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "লাইন %d: %s নামটি ইতিমধ্যেই ব্যবহৃত হয়েছে।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "লাইন %d: কোনো Cacti ডিভাইসের ID %d নেই।"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "লাইন %d: ডিভাইস %d-এ ইতিমধ্যেই BMC %s রয়েছে।"

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "লাইন %d-এর"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "ফাইলটিতে কোনো BMC সারি নেই।"

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "নাম: কন্ট্রোল ক্যারেক্টার ছাড়া ১ থেকে ১০০টি অক্ষর লিখুন।"

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "ঠিকানা: স্কিম, পোর্ট, পাথ বা ব্যবহারকারীর নাম ছাড়া শুধুমাত্র একটি হোস্ট নাম বা IP ঠিকানা লিখুন। লুপব্যাক, লিঙ্ক-লোকাল, মাল্টিকাস্ট এবং অনির্দিষ্ট ঠিকানা প্রত্যাখ্যান করা হয়।"

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "পোর্ট: ১ থেকে ৬৫৫৩৫ এর মধ্যে একটি TCP পোর্ট লিখুন।"

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "পলার: এই রিলিজে শুধুমাত্র মূল পলার BMC সংগ্রহ করতে পারে।"

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "ডিভাইস: একটি Cacti ডিভাইস নির্বাচন করুন অথবা কোনোটিই নয় রাখুন।"

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "ক্রেডেনশিয়াল: একটি সংরক্ষিত ক্রেডেনশিয়াল নির্বাচন করুন।"

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS যাচাইকরণ: তালিকাভুক্ত মোডগুলোর মধ্যে একটি নির্বাচন করুন।"

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA বান্ডেল ফাইল: কন্ট্রোল ক্যারেক্টার ছাড়া একটি অ্যাবসলিউট পাথ লিখুন, সর্বোচ্চ ৫১২ অক্ষর।"

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "পাবলিক কী পিন: BMC পাবলিক কী-এর base64 SHA-256 হ্যাশ লিখুন, ঐচ্ছিকভাবে শুরুতে sha256// যুক্ত করতে পারেন।"

