#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS যাচাইকরণ বন্ধ আছে। এই পথে থাকা যে কেউ BMC পাসওয়ার্ডসহ এর ট্র্যাফিক পড়তে পারবে।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: বেসিক অথেনটিকেশন ব্যবহার করছে কারণ BMC কোনো সেশন সেবা প্রদান করে না; প্রতিটি অনুরোধে পাসওয়ার্ড পাঠানো হয়।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: BMC-তে একটি সেশন খোলা থেকে যেতে পারে; পরবর্তী রানে লগ ইন করার পর সেটি মুছে ফেলা হবে।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: পরপর %dটি সেশন লগইনের প্রতিক্রিয়া হারিয়ে গেছে, তাই লগইন বন্ধ হয়েছে। BMC সেশন তালিকা পরীক্ষা করুন, তারপর 'এখনই আবার চেষ্টা করুন' ব্যবহার করুন।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC ক্রেডেনশিয়ালটি প্রত্যাখ্যান করেছে। ক্রেডেনশিয়াল পরিবর্তন না হওয়া পর্যন্ত এটি আবার চেষ্টা করা হবে না।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: এর ক্রেডেনশিয়াল অনুপস্থিত অথবা কোনো পাসওয়ার্ড সংরক্ষিত নেই।"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: এর প্রতিক্রিয়ার %dটি লিঙ্ক অন্যত্র নির্দেশ করছিল এবং সেগুলো উপেক্ষা করা হয়েছে।"

