#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "संकलनाचा ताजेपणा आणि डिव्हाइसचे आलेख तपासा. पुन्हा प्रयत्न करा हे पुढील नियोजित प्रक्रियेसाठी संकलन स्थगिती मुक्त करते; ते आता BMC शी संपर्क साधत नाही."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "फाइल रिकामी आहे किंवा 1 MiB पेक्षा मोठी आहे."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "फाइल वाचता आली नाही."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "फाइलमध्ये कोणतीही हेडर ओळ नाही."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "फाइलमध्ये \"%s\" नावाचा स्तंभ आहे. इम्पोर्ट फाइल्समध्ये गुप्त माहिती नसावी; त्याऐवजी credential स्तंभात संग्रहित क्रेडेन्शियलचे नाव द्या. काहीही इम्पोर्ट केले गेले नाही."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "हेडरमध्ये name, address आणि credential सह फक्त हेच स्तंभ प्रत्येक एकदाच नमूद केलेले असले पाहिजेत: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "फाइलमध्ये %d पेक्षा जास्त ओळी आहेत."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "ओळ %d: %d फील्ड्स अपेक्षित होते, %d सापडले."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "क्रेडेन्शियल: \"%s\" नावाचे कोणतेही संग्रहित क्रेडेन्शियल नाही."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "ओळ %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "ओळ %d: पत्ता %s पोर्ट %d आधीच %s म्हणून नोंदवलेला आहे."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "ओळ %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "ओळ %d: %s हे नाव आधीच वापरले गेले आहे."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "ओळ %d: ID %d असलेले कोणतेही Cacti डिव्हाइस नाही."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "ओळ %d: डिव्हाइस %d वर आधीच BMC %s आहे."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "ओळ %d चे"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "फाइलमध्ये कोणत्याही BMC ओळी नाहीत."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "नाव: नियंत्रण वर्णाशिवाय 1 ते 100 वर्ण प्रविष्ट करा."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "पत्ता: योजना, पोर्ट, पाथ किंवा वापरकर्ता नावाशिवाय फक्त होस्टनाव किंवा IP पत्ता प्रविष्ट करा. लूपबॅक, लिंक-लोकल, मल्टीकास्ट आणि अनिर्दिष्ट पत्ते नाकारले जातात."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "पोर्ट: 1 ते 65535 मधील TCP पोर्ट प्रविष्ट करा."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "पोलर: या आवृत्तीमध्ये फक्त मुख्य पोलर BMC गोळा करू शकतो."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "डिव्हाइस: Cacti डिव्हाइस निवडा किंवा काहीही नाही निवडा."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "क्रेडेन्शियल: साठवलेले क्रेडेन्शियल निवडा."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS पडताळणी: सूचीबद्ध मोडपैकी एक निवडा."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA बंडल फाइल: नियंत्रण वर्णांशिवाय पूर्ण पाथ प्रविष्ट करा, कमाल 512 वर्ण."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "सार्वजनिक की पिन: BMC सार्वजनिक कीचा base64 SHA-256 हॅश प्रविष्ट करा, पर्यायाने sha256// उपसर्ग लावून."

