#: lib/Settings.php
#, php-format
msgid "%s Default %d, from %d to %d."
msgstr "%s ברירת מחדל %d, מ-%d עד %d."

#: lib/Settings.php
msgid "Credential Vault"
msgstr "כספת פרטי אימות"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "קובץ מפתח כספת"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "נתיב מוחלט למפתח של 32 בתים המצפין סיסמאות BMC שמורות. צור אותו בעצמך, מחוץ לשורש האתר, עם הרשאת קריאה לשרת האינטרנט ולמשתמש הדוגם בלבד, בספרייה שרק root ומשתמש זה יכולים לכתוב אליה; התוסף אינו יוצר או כותב אותו לעולם. גבה אותו יחד עם מסד הנתונים: בלעדיו, יהיה צורך להזין מחדש את הסיסמאות השמורות."

#: lib/Settings.php
msgid "Collector"
msgstr "אוסף"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "מרווח איסוף"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "שניות בין קריאות של כל BMC."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "מרווח גילוי מחדש"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "שניות בין גילויי משאבים מלאים של כל BMC. כמו כן, מתבצע גילוי מחדש מיידי של BMC כאשר משאב מוכר נעלם או משנה סוג."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "תקציב זמן לאוסף"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "שניות שהרצה אחת של האספן רשאית להימשך לפני שהיא מפסיקה להתחיל בקרי BMC חדשים. שמור על ערך נמוך ממרווח הדוגם; בקרי BMC שלא הושלמו ימשיכו בהרצה הבאה."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "בקרי BMC שנקראים במקביל. כל BMC נקרא על ידי תהליך עבודה אחד בכל פעם."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "תהליכי עבודה של האספן"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "זמן קצוב לחיבור"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "שניות המותרות לחיבור TCP וללחיצת היד של TLS מול BMC."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "פסק זמן לבקשה"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "שניות המותרות לבקשה אחת שלמה מול BMC, כולל החיבור."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "KiB המותרים בגוף תגובה אחת של BMC; תגובה גדולה יותר נדחית."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "גודל תגובה מרבי"

#: lib/Settings.php
msgid "Freshness"
msgstr "עדכניות"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "מרווחי איסוף שלאחריהם קריאה מוצגת כמעוכבת."

#: lib/Settings.php
msgid "Delayed After"
msgstr "מעוכב לאחר"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "מרווחי איסוף שלאחריהם קריאה נחשבת ללא עדכנית ונקראת כלא ידועה. תמיד גדול בלפחות אחד מ\"מעוכב לאחר\"."

#: lib/Settings.php
msgid "Stale After"
msgstr "התיישנות לאחר"

#: lib/Settings.php
msgid "Uninstall"
msgstr "הסרת התקנה"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "שמור את טבלאות התוסף בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "כאשר מסומן, הסרת ההתקנה של התוסף שומרת על מרשם ה-BMC, הסיסמאות המוצפנות ומטמון הקריאות. נקה סימון זה כדי שהסרת ההתקנה תמחק אותם. הסרת ההתקנה אינה נוגעת לעולם בהתקני Cacti, גרפים או בקרי BMC, כולל התקנים שהתוסף יצר."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "אמת מול מאגר ה-CA של המערכת"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "אמת מול קובץ מאגד CA"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "מפתח ציבורי מוצמד (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "אל תאמת (לא בטוח)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "אין לך גישה להתקן ה-Cacti של BMC זה."

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "לא ניתן היה לשמור את ה-BMC."

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "ה-BMC נשמר."

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "ה-BMC והנתונים השמורים שלו במטמון נמחקו. התקן ה-Cacti שלו נשאר במקומו."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "השהיית הניסיונות החוזרים והכשלים המושהים נוקו; האספן יקרא את ה-BMC בהרצה הבאה שלו."

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "הוספת התקנים וגרפים דורשת הרשאת ניהול התקנים של Cacti."

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "ההתקן של BMC זה נמחק. בחר תחילה התקן אחר, או ללא, בטופס ה-BMC."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "שאילתות הנתונים מופתחו מחדש ונוספו %d גרפים."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "ההתקן נוצר עם גרפי ה-Redfish שלו."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "התקנת תבניות Redfish דורשת את הרשאת ייבוא התבניות של Cacti."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "תבניות Redfish מותקנות."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "לא ניתן היה להתקין את תבניות Redfish. דף התקינות מציג מדוע."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "לא ניתן היה לשמור את הייבוא; דבר לא יובא."

#: redfish_bmcs.php
#, php-format
msgid "%d BMCs were imported."
msgstr "יובאו %d בקרי BMC."

#: redfish_credentials.php
msgid "This credential is used by a BMC on a Cacti device you do not have access to, so it cannot be changed here."
msgstr "פרטי גישה אלו משמשים BMC בהתקן Cacti שאין לך גישה אליו, ולכן לא ניתן לשנותם כאן."

#: redfish_credentials.php
msgid "Name: another credential already uses this name."
msgstr "שם: פרטי גישה אחרים כבר משתמשים בשם זה."

#: redfish_credentials.php
msgid "User Name: enter 1 to 255 characters without control characters."
msgstr "שם משתמש: הזן בין 1 ל-255 תווים ללא תווי בקרה."

#: redfish_credentials.php
msgid "Password: enter the password of the BMC account."
msgstr "סיסמה: הזן את הסיסמה של חשבון ה-BMC."

#: redfish_credentials.php
#, php-format
msgid "The credential was saved, but the password was not stored: %s"
msgstr "פרטי הגישה נשמרו, אך הסיסמה לא נשמרה: %s"

#: redfish_credentials.php
msgid "The credential could not be saved."
msgstr "לא ניתן היה לשמור את פרטי הגישה."

#: redfish_credentials.php
msgid "The credential was saved."
msgstr "פרטי הגישה נשמרו."

#: redfish_credentials.php
msgid "The credential and its stored password were deleted."
msgstr "פרטי הגישה והסיסמה השמורה שלהם נמחקו."

#: redfish_credentials.php
msgid "The credential was not deleted. A credential in use by a BMC cannot be deleted."
msgstr "פרטי הגישה לא נמחקו. לא ניתן למחוק פרטי גישה שנמצאים בשימוש על ידי BMC."

