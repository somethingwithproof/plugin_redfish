msgstr "ייבוא בקרי BMC"

#: lib/BmcsPage.php
msgid "CSV File"
msgstr "קובץ CSV"

#: lib/BmcsPage.php
#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "שורת כותרת עם העמודות: %s. ציין שם של פרטי גישה שמורים; לעולם אל תכלול סיסמה בקובץ. כל שורה חייבת להיות תקינה, אחרת לא ייובא דבר."

#: lib/BmcsPage.php
msgid "Import"
msgstr "ייבוא"

#: lib/BmcsPage.php
msgid "Choose a credential"
msgstr "בחר פרטי גישה"

