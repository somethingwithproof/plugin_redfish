msgid "None"
msgstr "ללא"

#: lib/BmcsPage.php
#, php-format
msgid "Deleted device (ID %d)"
msgstr "התקן שנמחק (מזהה %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "BMC חדש של Redfish"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "Redfish BMC: %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "שם מארח או כתובת IP של ה-BMC, ללא https:// או נתיב."

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "האפשרות \"אל תאמת\" נרשמת ביומן בעת הגדרתה ומוצגת כאזהרה בדף התקינות כל עוד היא פעילה."

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "קובץ מאגד CA"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "למצב מאגד CA: נתיב מוחלט בדוגם לקובץ PEM שאחרים אינם יכולים לכתוב אליו."

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "למצב הצמדה: גיבוב SHA-256 ב-base64 של המפתח הציבורי של ה-BMC, כ-sha256//... או הגיבוב בלבד. מפתח שהשתנה ייכשל עד לעדכון ערך זה."

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "הצמדת מפתח ציבורי"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "אפשר חלופת אימות Basic"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "משמש רק כאשר ה-BMC אינו מציע שירות הפעלה. במקרה זה כל בקשה נושאת את הסיסמה; דף התקינות מציג אזהרה כל עוד האפשרות בשימוש."

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "התקן ה-Cacti של השרת ש-BMC זה מנהל. השאר על \"ללא\" כדי שהתוסף ייצור התקן מתוך הרשימה."

#: lib/BmcsPage.php lib/CredentialsPage.php
msgid "Save"
msgstr "שמור"

#: lib/BmcsPage.php
#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "כתובת: %s יציאה %d כבר רשומה בשם %s."

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "כתובת: כתובת ויציאה אלו כבר רשומות."

#: lib/BmcsPage.php
msgid "Name: another BMC already uses this name."
msgstr "שם: BMC אחר כבר משתמש בשם זה."

#: lib/BmcsPage.php
msgid "Device: no Cacti device has this ID."
msgstr "התקן: אין התקן Cacti בעל מזהה זה."

#: lib/BmcsPage.php
msgid "Device: another BMC is already mapped to this device."
msgstr "התקן: BMC אחר כבר ממופה להתקן זה."

#: lib/CredentialsPage.php lib/Pages.php
msgid "Redfish Credentials"
msgstr "פרטי גישה של Redfish"

#: lib/CredentialsPage.php
msgid "Password"
msgstr "סיסמה"

#: lib/CredentialsPage.php
msgid "Used By"
msgstr "בשימוש על ידי"

#: lib/CredentialsPage.php
msgid "User Name"
msgstr "שם משתמש"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "אין עדיין פרטי גישה. צור רשומה עם חשבון BMC לקריאה בלבד."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "לא שמורים"

#: lib/CredentialsPage.php
msgid "Stored"
msgstr "מאוחסן"

#: lib/CredentialsPage.php
#, php-format
msgid "%d BMCs"
msgstr "%d בקרי BMC"

#: lib/CredentialsPage.php
msgid "New Redfish Credential"
msgstr "פרטי גישה חדשים של Redfish"

#: lib/CredentialsPage.php
#, php-format
msgid "Redfish Credential: %s"
msgstr "פרטי גישה של Redfish: %s"

#: lib/CredentialsPage.php
msgid "A BMC account with the ReadOnly role. The plugin never needs a role that can change BMC state."
msgstr "חשבון BMC בעל תפקיד ReadOnly. התוסף אינו זקוק לעולם לתפקיד שיכול לשנות את מצב ה-BMC."

#: lib/CredentialsPage.php
msgid "A password is stored. Leave blank to keep it."
msgstr "סיסמה שמורה במערכת. השאר ריק כדי לשמור עליה."

#: lib/CredentialsPage.php
msgid "Stored encrypted with the vault key."
msgstr "שמור מוצפן באמצעות מפתח הכספת."

#: lib/DeviceProvisioner.php
msgid "The Redfish templates are not installed completely. Reinstall them from the Redfish BMCs page."
msgstr "תבניות Redfish אינן מותקנות במלואן. התקן אותן מחדש מדף בקרי ה-BMC של Redfish."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off. Its host name is a reserved name that is never contacted."
msgstr "התקן \"%s\" מתבנית ההתקן %s, הנדגם על ידי דוגם %d, כאשר בדיקות זמינות כבויות. שם המארח שלו הוא שם שמור שאליו לא מתבצעת פנייה לעולם."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", with a graph for each of the %d members known now."
msgstr "שאילתת הנתונים \"%s\", עם גרף עבור כל אחד מ-%d החברים הידועים כעת."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d fans or power supplies that were present are no longer reported. They count as failed until you confirm; confirming accepts the members the BMC reports now."
msgstr "%d מאווררים או ספקי כוח שהיו נוכחים אינם מדווחים עוד. הם נחשבים ככושלים עד שתאשר; אישור מקבל את החברים שה-BMC מדווח עליהם כעת."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The graph \"%s\", with its \"%s\" data source."
msgstr "הגרף \"%s\", עם מקור הנתונים \"%s\" שלו."

#: lib/DeviceProvisioner.php
msgid "The BMC is already mapped to a device."
msgstr "ה-BMC כבר ממופה להתקן."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Redfish plugin for BMC %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "נוצר על ידי תוסף Redfish עבור ה-BMC %s. ערכיו מגיעים ממטמון התוסף; שם המארח הוא שם שמור שאליו לא מתבצעת פנייה לעולם."

#: lib/DeviceProvisioner.php
msgid "Cacti refused to create the device. See the Cacti log."
msgstr "Cacti סירב ליצור את ההתקן. עיין ביומן Cacti."

#: lib/DeviceProvisioner.php
msgid "The new device would be hidden from you by your device permissions, so it was removed again. Ask an administrator to grant access, or map the BMC to a device you can see."
msgstr "ההתקן החדש היה מוסתר ממך בשל הרשאות ההתקן שלך, ולכן הוא הוסר שוב. בקש ממנהל המערכת להעניק גישה, או מפה את ה-BMC להתקן שאתה יכול לראות."

#: lib/DeviceProvisioner.php
msgid "The BMC was mapped to a device by someone else meanwhile, or could not be mapped, so the new device was removed again. Reload the page and check its mapping."
msgstr "ה-BMC מופה להתקן על ידי גורם אחר בינתיים, או שלא ניתן היה למפותו, ולכן ההתקן החדש הוסר שוב. טען מחדש את הדף ובדוק את המיפוי שלו."

#: lib/DeviceWarnings.php
#, php-format
msgid "The Redfish templates could not be installed: %s"
msgstr "לא ניתן היה להתקין את תבניות Redfish: %s"

#: lib/DeviceWarnings.php
msgid "The Redfish templates are not installed or not current. Reinstall them from the Redfish BMCs page."
msgstr "תבניות Redfish אינן מותקנות או שאינן עדכניות. התקן אותן מחדש מדף בקרי ה-BMC של Redfish."

#: lib/DeviceWarnings.php
#, php-format
msgid "%s: its Cacti device was deleted. Map it to another device or create one from the BMCs page."
msgstr "%s: התקן ה-Cacti שלו נמחק. מפה אותו להתקן אחר או צור אחד מדף בקרי ה-BMC."

#: lib/DeviceWarnings.php
#, php-format
msgid "%s: its device is polled by poller %d but the BMC is read by poller %d. Move one of them so both use the same poller, or its graphs can read as unknown."
msgstr "%s: ההתקן שלו נדגם על ידי דוגם %d אך ה-BMC נקרא על ידי דוגם %d. העבר אחד מהם כך ששניהם ישתמשו באותו דוגם, אחרת הגרפים שלו עלולים להופיע כלא ידועים."

#: lib/GraphLinks.php
msgid "Redfish graphs of this device"
msgstr "גרפי Redfish של התקן זה"

