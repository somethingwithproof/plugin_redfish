#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "בדוק את עדכניות האיסוף ואת גרפי ההתקן. ניסיון חוזר משחרר השהיית איסוף עבור הריצה המתוזמנת הבאה; הוא אינו יוצר קשר עם ה-BMC כעת."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "הקובץ ריק או גדול מ-1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "לא ניתן היה לקרוא את הקובץ."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "לקובץ אין שורת כותרת."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "בקובץ יש עמודה בשם \"%s\". קובצי ייבוא אינם רשאים להכיל סודות; במקום זאת, ציין פרטי הזדהות שמורים בעמודת credential. דבר לא יובא."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "הכותרת חייבת לציין רק עמודות אלה, כל אחת פעם אחת, כולל name, address ו-credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "בקובץ יש יותר מ-%d שורות."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "שורה %d: צפויים %d שדות, נמצאו %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "פרטי הזדהות: לא קיימים פרטי הזדהות שמורים בשם \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "שורה %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "שורה %d: הכתובת %s יציאה %d כבר רשומה בשם %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "שורה %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "שורה %d: השם %s כבר בשימוש."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "שורה %d: אין התקן Cacti בעל מזהה %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "שורה %d: להתקן %d כבר משויך ה-BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "של שורה %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "הקובץ אינו מכיל שורות BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "שם: הזן 1 עד 100 תווים ללא תווי בקרה."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "כתובת: הזן שם מארח או כתובת IP בלבד, ללא סכימה, יציאה, נתיב או שם משתמש. כתובות לולאה חוזרת, קישור מקומי, ריבוי יעדים וכתובות לא מוגדרות נדחות."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "יציאה: הזן יציאת TCP בין 1 ל-65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "דוגם: רק הדוגם הראשי יכול לאסוף נתוני BMC בגרסה זו."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "התקן: בחר התקן Cacti או ללא."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "פרטי גישה: בחר פרטי גישה שמורים."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "אימות TLS: בחר אחד מהמצבים הרשומים."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "קובץ מאגד CA: הזן נתיב מוחלט ללא תווי בקרה, באורך של עד 512 תווים."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "הצמדת מפתח ציבורי: הזן את גיבוב ה-SHA-256 ב-base64 של המפתח הציבורי של ה-BMC, אופציונלית עם הקידומת sha256//."

