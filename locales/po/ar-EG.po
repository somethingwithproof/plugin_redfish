#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "استغرق المجمّع على poller %d مدة %.0f ثانية، وهو أكثر من المدة المخصصة له البالغة %d ثانية."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "نفد وقت المجمّع على poller %d قبل قراءة كل وحدات BMC؛ سيتم استئناف الباقي في التشغيل التالي. أضف عمالًا أو ارفع المدة المخصصة."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "آخر تشغيل للمجمّع على poller %d كان %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: التحقق من TLS متوقف. يمكن لأي شخص على المسار قراءة حركة البيانات الخاصة به، بما في ذلك كلمة مرور BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: يستخدم مصادقة Basic لأن وحدة BMC لا توفر خدمة جلسات؛ كل طلب يحمل كلمة المرور."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: ربما تُركت جلسة مفتوحة على وحدة BMC؛ سيقوم التشغيل التالي بحذفها بعد تسجيل الدخول."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: فقدت %d عمليات تسجيل دخول للجلسة على التوالي استجابتها، لذلك توقفت عمليات تسجيل الدخول. تحقق من قائمة جلسات BMC، ثم استخدم إعادة المحاولة الآن."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: رفضت وحدة BMC بيانات الاعتماد. لن تتم تجربتها مرة أخرى حتى تتغير بيانات الاعتماد."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: بيانات الاعتماد الخاصة بها مفقودة أو لا تحتوي على كلمة مرور مخزّنة."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: أشارت %d روابط في استجاباتها إلى مكان آخر وتم تجاهلها."

