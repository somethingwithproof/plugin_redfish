#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Файлът с ключа за хранилището не може да се използва: %s. Запазените пароли не могат да се четат или записват, докато проблемът не бъде отстранен."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Колекторът на полър %d отне %.0f секунди, повече от бюджета си от %d секунди."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Времето на колектора на полър %d изтече преди прочитането на всички BMC устройства; останалите ще продължат при следващото изпълнение. Добавете работни процеси или увеличете бюджета."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Колекторът на полър %d се е изпълнил последно %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS проверката е изключена. Всеки по пътя на трафика може да го чете, включително паролата на BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: използва Basic удостоверяване, защото BMC не предлага услуга за сесии; всяка заявка предава паролата."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: възможно е на BMC да е останала отворена сесия; следващото изпълнение ще я изтрие след влизане."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d поредни влизания за сесия загубиха отговора си, затова влизанията спряха. Проверете списъка със сесии на BMC, след което използвайте „Опитай отново сега“."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC отхвърли данните за достъп. Няма да се правят нови опити, докато данните за достъп не бъдат променени."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: данните за достъп липсват или нямат запазена парола."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d връзки в отговорите му сочеха другаде и бяха игнорирани."

