#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Проверете актуалността на събирането и графиките на устройството. Повторният опит освобождава задържаното събиране за следващото планирано изпълнение; не се свързва с BMC в момента."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Файлът е празен или по-голям от 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Файлът не можа да бъде прочетен."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Файлът няма заглавен ред."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Файлът съдържа колона с име „%s“. Файловете за импортиране не трябва да съдържат тайни данни; вместо това посочете запазени данни за достъп в колоната за данни за достъп. Нищо не беше импортирано."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Заглавният ред трябва да съдържа само тези колони, всяка по веднъж, включително name, address и credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Файлът има повече от %d реда."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Ред %d: очаквани %d полета, намерени %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Данни за достъп: няма запазени данни за достъп с име „%s“."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Ред %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Ред %d: адресът %s, порт %d, вече е регистриран като %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "ред %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Ред %d: името %s вече се използва."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Ред %d: няма устройство в Cacti с ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Ред %d: устройство %d вече има BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "на ред %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Файлът не съдържа редове за BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Име: въведете от 1 до 100 знака без контролни знаци."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Адрес: въведете само име на хост или IP адрес, без схема, порт, път или потребителско име. Loopback, link-local, multicast и неопределени адреси се отхвърлят."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Порт: въведете TCP порт от 1 до 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Полър: в тази версия само главният полър може да събира данни от BMC устройства."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Устройство: изберете устройство в Cacti или никое."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Данни за достъп: изберете запазени данни за достъп."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS проверка: изберете един от изброените режими."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Файл с CA пакет: въведете абсолютен път без контролни знаци, най-много 512 знака."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Фиксиран публичен ключ: въведете base64 SHA-256 хеша на публичния ключ на BMC, по избор с префикс sha256//."

