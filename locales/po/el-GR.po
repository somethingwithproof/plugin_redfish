#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Δεν είναι δυνατή η χρήση του αρχείου κλειδιού θησαυροφυλακίου: %s. Οι αποθηκευμένοι κωδικοί πρόσβασης δεν μπορούν να διαβαστούν ή να εγγραφούν μέχρι να διορθωθεί."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Ο συλλέκτης στον poller %d χρειάστηκε %.0f δευτερόλεπτα, περισσότερο από το χρονικό όριο των %d δευτερολέπτων."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Ο συλλέκτης στον poller %d εξάντλησε τον χρόνο του πριν διαβαστούν όλα τα BMC. Τα υπόλοιπα συνεχίζουν στην επόμενη εκτέλεση. Προσθέστε διεργασίες ή αυξήστε το χρονικό όριο."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Ο συλλέκτης στον poller %d εκτελέστηκε τελευταία φορά %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: η επαλήθευση TLS είναι απενεργοποιημένη. Οποιοσδήποτε στη διαδρομή μπορεί να διαβάσει την κίνησή του, συμπεριλαμβανομένου του κωδικού πρόσβασης του BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: χρησιμοποιεί έλεγχο ταυτότητας Basic επειδή το BMC δεν προσφέρει υπηρεσία συνεδριών. Κάθε αίτημα μεταφέρει τον κωδικό πρόσβασης."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: μια συνεδρία ενδέχεται να έχει μείνει ανοιχτή στο BMC. Η επόμενη εκτέλεση θα τη διαγράψει μετά τη σύνδεση."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d συνεχόμενες συνδέσεις συνεδρίας έχασαν την απόκρισή τους, οπότε οι συνδέσεις σταμάτησαν. Ελέγξτε τη λίστα συνεδριών του BMC και στη συνέχεια χρησιμοποιήστε «Επανάληψη τώρα»."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: το BMC απέρριψε το διαπιστευτήριο. Δεν θα γίνει νέα προσπάθεια μέχρι να αλλάξει το διαπιστευτήριο."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: το διαπιστευτήριό του λείπει ή δεν έχει αποθηκευμένο κωδικό πρόσβασης."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d σύνδεσμοι στις αποκρίσεις του έδειχναν αλλού και αγνοήθηκαν."

