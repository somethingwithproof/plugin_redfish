#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "Γραμμή κεφαλίδας με στήλες: %s. Δηλώστε ένα αποθηκευμένο διαπιστευτήριο και μην τοποθετείτε ποτέ κωδικό πρόσβασης στο αρχείο. Κάθε γραμμή πρέπει να είναι έγκυρη, αλλιώς δεν εισάγεται τίποτα."

#: lib/BmcsPage.php
msgid "Import"
msgstr "Εισαγωγή"

