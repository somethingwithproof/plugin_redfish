msgstr "Αποθήκευση"

#: lib/BmcsPage.php
#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "Διεύθυνση: η διεύθυνση %s θύρα %d έχει ήδη καταχωριστεί ως %s."

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "Διεύθυνση: αυτή η διεύθυνση και θύρα έχουν ήδη καταχωριστεί."

#: lib/BmcsPage.php
msgid "Name: another BMC already uses this name."
msgstr "Όνομα: ένα άλλο BMC χρησιμοποιεί ήδη αυτό το όνομα."

