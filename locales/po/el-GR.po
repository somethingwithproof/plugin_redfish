#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Ελέγξτε την επικαιρότητα της συλλογής και τα γραφήματα της συσκευής. Η επανάληψη αποδεσμεύει την αναστολή συλλογής για την επόμενη προγραμματισμένη εκτέλεση, χωρίς να επικοινωνήσει τώρα με το BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Το αρχείο είναι κενό ή μεγαλύτερο από 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση του αρχείου."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Το αρχείο δεν περιέχει γραμμή κεφαλίδας."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Το αρχείο περιέχει μια στήλη με όνομα «%s». Τα αρχεία εισαγωγής δεν πρέπει να περιέχουν μυστικά, αντ' αυτού δηλώστε ένα αποθηκευμένο διαπιστευτήριο στη στήλη διαπιστευτηρίου. Δεν έγινε καμία εισαγωγή."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Η κεφαλίδα πρέπει να περιλαμβάνει μόνο αυτές τις στήλες, καθεμία μία φορά, συμπεριλαμβανομένων των name, address και credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Το αρχείο έχει περισσότερες από %d γραμμές."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Γραμμή %d: αναμένονταν %d πεδία, βρέθηκαν %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Διαπιστευτήριο: δεν υπάρχει αποθηκευμένο διαπιστευτήριο με όνομα «%s»."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Γραμμή %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Γραμμή %d: η διεύθυνση %s θύρα %d έχει ήδη καταχωριστεί ως %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "γραμμή %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Γραμμή %d: το όνομα %s χρησιμοποιείται ήδη."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Γραμμή %d: καμία συσκευή Cacti δεν έχει αναγνωριστικό %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Γραμμή %d: η συσκευή %d έχει ήδη το BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "της γραμμής %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Το αρχείο δεν περιέχει γραμμές BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Όνομα: εισαγάγετε 1 έως 100 χαρακτήρες χωρίς χαρακτήρες ελέγχου."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Διεύθυνση: εισαγάγετε μόνο όνομα κεντρικού υπολογιστή ή διεύθυνση IP, χωρίς πρωτόκολλο, θύρα, διαδρομή ή όνομα χρήστη. Οι διευθύνσεις loopback, link-local, multicast και απροσδιόριστες διευθύνσεις απορρίπτονται."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Θύρα: εισαγάγετε μια θύρα TCP από 1 έως 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: μόνο ο κύριος poller μπορεί να συλλέγει δεδομένα από BMC σε αυτή την έκδοση."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Συσκευή: επιλέξτε μια συσκευή Cacti ή καμία."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Διαπιστευτήριο: επιλέξτε ένα αποθηκευμένο διαπιστευτήριο."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Επαλήθευση TLS: επιλέξτε μία από τις διαθέσιμες λειτουργίες."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Αρχείο δέσμης CA: εισαγάγετε μια απόλυτη διαδρομή χωρίς χαρακτήρες ελέγχου, έως 512 χαρακτήρες."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Καρφίτσωμα δημόσιου κλειδιού: εισαγάγετε τη σύνοψη SHA-256 σε μορφή base64 του δημόσιου κλειδιού του BMC, προαιρετικά με το πρόθεμα sha256//."

