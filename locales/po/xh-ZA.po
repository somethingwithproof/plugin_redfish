#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Ifayile yeqhosha le-vault ayikwazi ukusetyenziswa: %s. Amagama okugqitha agciniweyo awakwazi ukufundwa okanye ukubhalwa de ilungiswe."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Umqokeleli kwi-poller %d uthathe imizuzwana %.0f, ngaphezu kwesabelo sayo semizuzwana %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Umqokeleli kwi-poller %d uphelelwe lixesha phambi kokuba yonke i-BMC ifundwe; ezinye ziyaqhubeka kusebenzo olulandelayo. Yongeza abasebenzi okanye unyuse isabelo sexesha."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Umqokeleli kwi-poller %d ugqibele ukusebenza %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: uqinisekiso lwe-TLS lucinyiwe. Nabani na osendleleni unokufunda ugqithiso lwayo, kubandakanya negama lokugqitha le-BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: isebenzisa uqinisekiso lwe-Basic kuba i-BMC ayiboneleli ngenkonzo yeseshoni; isicelo ngasinye sithwala igama lokugqitha."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: iseshoni isenokuba ishiywe ivuliwe kwi-BMC; usebenzo olulandelayo luyayicima emva kokungena."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d ukungena kwiseshoni ngokulandelelana kulahlekelwe yimpendulo, ngoko ke ukungena kumile. Khangela uluhlu lweeseshoni ze-BMC, uze usebenzise u-Zama kwakhona ngoku."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: i-BMC isikhanyele isiqinisekiso. Asizanywa kwakhona de isiqinisekiso sitshintshe."

#: lib/HealthWarnings.php
