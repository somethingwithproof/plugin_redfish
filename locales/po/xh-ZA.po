msgstr "Isixhobo: akukho sixhobo seCacti esinale ID."

#: lib/BmcsPage.php
msgid "Device: another BMC is already mapped to this device."
msgstr "Isixhobo: enye i-BMC sele imaphwe kwesi sixhobo."

