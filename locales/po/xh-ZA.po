msgstr "Imibuzo yedatha yenziwe isalathiso kwakhona kwaye kongezwe %d iigrafu."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "Isixhobo siyilwe kunye neegrafu zaso zeRedfish."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Ukufakela iitempleyithi zeRedfish kufuna imvume yeCacti yokungenisa iitempleyithi."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Iitempleyithi zeRedfish zifakelwe."

#: redfish_bmcs.php
