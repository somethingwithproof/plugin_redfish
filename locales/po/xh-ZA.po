#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Khangela ukutsha koqokelelo kunye neegrafu zesixhobo. Ukuzama kwakhona kukhulula ukubanjwa koqokelelo kuqhuba olulandelayo olucwangcisiweyo; akuyiqhagamsheli i-BMC ngoku."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Ifayile ayinanto okanye inkulu kune-1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Ifayile ayikwazanga ukufundwa."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Ifayile ayinamqolo wesihloko."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Ifayile inekholam ebizwa ngokuba yi-\"%s\". Iifayile zokungenisa akufuneki ziphathe izinto ezifihlakeleyo; endaweni yoko xela isiqinisekiso esigciniweyo kwikholam yesiqinisekiso. Akukho nto ingenisiweyo."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Isihloko kufuneka sixele ezi kholam kuphela, nganye kanye, kuquka name, address, kunye ne-credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Ifayile inemiqolo engaphezu kwe-%d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Umgca %d: kulindelwe imihlaba eyi-%d, kufunyenwe eyi-%d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Isiqinisekiso: akukho siqinisekiso sigciniweyo sibizwa ngokuba yi-\"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Umgca %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Umgca %d: idilesi %s iphothi %d sele ibhalisiwe njenge-%s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "umgca %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Umgca %d: igama elithi %s selisetyenzisiwe."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Umgca %d: akukho sixhobo seCacti esine-ID engu-%d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Umgca %d: isixhobo %d sele sine-BMC engu-%s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "yomgca %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Ifayile ayinayo imiqolo ye-BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Igama: faka oonobumba abayi-1 ukuya kwabayi-100 ngaphandle koonobumba bolawulo."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Idilesi: faka igama lomamkeli okanye idilesi ye-IP kuphela, ngaphandle kwe-scheme, izibuko, indlela, okanye igama lomsebenzisi. Iidilesi ze-loopback, i-link-local, i-multicast, kunye neengachazwanga ziyaliwa."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Izibuko: faka izibuko le-TCP ukusuka ku-1 ukuya ku-65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "I-Poller: kuphela yi-poller ephambili enokuqokelela ii-BMC kolu khupho."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Isixhobo: khetha isixhobo seCacti okanye akukho nasinye."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Isiqinisekiso: khetha isiqinisekiso esigciniweyo."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Uqinisekiso lwe-TLS: khetha enye yeendlela ezidwelisiweyo."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Ifayile ye-CA Bundle: faka indlela epheleleyo engenazo iimpawu zokulawula, ubuninzi beempawu ezingama-512."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "IPhini yeQhosha loLuntu: faka i-hash ye-SHA-256 ye-base64 yeqhosha loluntu le-BMC, ngokuzikhethela iqaliswe nge-sha256//."

