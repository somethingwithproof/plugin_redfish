#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "შეამოწმეთ მონაცემთა შეგროვების აქტუალურობა და მოწყობილობის გრაფიკები. ხელახალი ცდა ხსნის შეგროვების შეზღუდვას შემდეგი დაგეგმილი გაშვებისთვის; ის ახლა არ უკავშირდება BMC-ს."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "ფაილი ცარიელია ან 1 MiB-ზე დიდია."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "ფაილის წაკითხვა ვერ მოხერხდა."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "ფაილს არ აქვს სათაურის სტრიქონი."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "ფაილში არის სვეტი სახელწოდებით „%s“. იმპორტის ფაილები არ უნდა შეიცავდეს საიდუმლო მონაცემებს; ამის ნაცვლად, credential სვეტში მიუთითეთ შენახული ავტორიზაციის მონაცემის სახელი. არაფერი დაიმპორტდა."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "სათაური უნდა შეიცავდეს მხოლოდ ამ სვეტებს, თითოეულს ერთხელ, მათ შორის name, address და credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "ფაილს %d-ზე მეტი სტრიქონი აქვს."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "ხაზი %d: მოსალოდნელი იყო %d ველი, ნაპოვნია %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "ავტორიზაციის მონაცემი: შენახული მონაცემი სახელწოდებით „%s“ არ არსებობს."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "ხაზი %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "ხაზი %d: მისამართი %s პორტით %d უკვე რეგისტრირებულია როგორც %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "ხაზი %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "ხაზი %d: სახელი %s უკვე გამოყენებულია."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "ხაზი %d: Cacti-ის არცერთ მოწყობილობას არ აქვს ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "ხაზი %d: მოწყობილობას %d უკვე აქვს BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "%d ხაზიდან"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "ფაილში BMC სტრიქონები არ არის."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "სახელი: შეიყვანეთ 1-დან 100-მდე სიმბოლო მართვის სიმბოლოების გარეშე."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "მისამართი: შეიყვანეთ მხოლოდ ჰოსტის სახელი ან IP მისამართი, სქემის, პორტის, გზისა და მომხმარებლის სახელის გარეშე. Loopback, link-local, multicast და განუსაზღვრელი მისამართები უარყოფილია."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "პორტი: შეიყვანეთ TCP პორტი 1-დან 65535-მდე."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "პოლერი: ამ ვერსიაში BMC-ების შეგროვება მხოლოდ მთავარ პოლერს შეუძლია."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "მოწყობილობა: აირჩიეთ Cacti-ის მოწყობილობა ან არცერთი."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "ავტორიზაციის მონაცემი: აირჩიეთ შენახული ავტორიზაციის მონაცემი."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS შემოწმება: აირჩიეთ ჩამოთვლილი რეჟიმებიდან ერთ-ერთი."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA ბანდლის ფაილი: შეიყვანეთ აბსოლუტური გზა მართვის სიმბოლოების გარეშე, მაქსიმუმ 512 სიმბოლო."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "საჯარო გასაღების მიმაგრება: შეიყვანეთ BMC-ის საჯარო გასაღების base64 SHA-256 ჰეში, სურვილისამებრ sha256// პრეფიქსით."

