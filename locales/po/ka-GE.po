#: lib/Settings.php
msgid "Connect Timeout"
msgstr "დაკავშირების მოლოდინის დრო"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "წამების რაოდენობა BMC-თან TCP კავშირისა და TLS ხელის ჩამორთმევისთვის."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "მოთხოვნის მოლოდინის დრო"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "წამების რაოდენობა BMC-თან ერთი სრული მოთხოვნისთვის, კავშირის დამყარების ჩათვლით."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "ერთი BMC პასუხის ტანში დასაშვები KiB-ების რაოდენობა; უფრო დიდი პასუხი უარყოფილია."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "პასუხის მაქსიმალური ზომა"

#: lib/Settings.php
msgid "Freshness"
msgstr "აქტუალურობა"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "შეგროვების ინტერვალების რაოდენობა, რომლის შემდეგაც მაჩვენებელი დაგვიანებულად ჩანს."

#: lib/Settings.php
msgid "Delayed After"
msgstr "დაგვიანებულია შემდეგ"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "შეგროვების ინტერვალების რაოდენობა, რომლის შემდეგაც მაჩვენებელი მოძველებულია და იკითხება როგორც უცნობი. ყოველთვის სულ მცირე ერთით მეტია პარამეტრზე „დაგვიანებულია შემდეგ“."

#: lib/Settings.php
msgid "Stale After"
msgstr "მოძველებულია შემდეგ"

#: lib/Settings.php
msgid "Uninstall"
msgstr "დეინსტალაცია"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "პლაგინის ცხრილების შენახვა დეინსტალაციისას"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "მონიშვნის შემთხვევაში, პლაგინის წაშლისას შენარჩუნდება მისი BMC რეესტრი, დაშიფრული პაროლები და მაჩვენებლების ქეში. მოხსენით მონიშვნა მათ წასაშლელად. დეინსტალაცია არასდროს ეხება Cacti მოწყობილობებს, გრაფიკებს ან BMC-ებს, მათ შორის პლაგინის მიერ შექმნილ მოწყობილობებს."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "შემოწმება სისტემის CA საცავით"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "შემოწმება CA ბანდლის ფაილით"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "მიმაგრებული საჯარო გასაღები (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "არ შეამოწმო (არაუსაფრთხო)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "თქვენ არ გაქვთ წვდომა ამ BMC-ის Cacti მოწყობილობაზე."

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "BMC-ის შენახვა ვერ მოხერხდა."

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "BMC შენახულია."

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "BMC და მისი ქეშირებული მონაცემები წაიშალა. მისი Cacti მოწყობილობა ხელუხლებელი დარჩა."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "დაყოვნება და დაგროვილი შეფერხებები გასუფთავდა; კოლექტორი წაიკითხავს BMC-ს შემდეგ გაშვებაზე."

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "მოწყობილობებისა და გრაფიკების დამატებისთვის საჭიროა Cacti-ის მოწყობილობების მართვის უფლება."

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "ამ BMC-ის მოწყობილობა წაშლილია. ჯერ BMC ფორმაში აირჩიეთ სხვა მოწყობილობა ან „არცერთი“."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "მონაცემთა მოთხოვნები ხელახლა დაინდექსდა და დაემატა %d გრაფიკი."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "მოწყობილობა შეიქმნა თავისი Redfish გრაფიკებით."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Redfish შაბლონების დაყენებისთვის საჭიროა Cacti-ის შაბლონების იმპორტის უფლება."

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "Redfish შაბლონები დაყენებულია."

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "Redfish შაბლონების დაყენება ვერ მოხერხდა. მიზეზი ნაჩვენებია გამართულობის გვერდზე."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "იმპორტის შენახვა ვერ მოხერხდა; არაფერი დაიმპორტდა."

#: redfish_bmcs.php
#, php-format
msgid "%d BMCs were imported."
msgstr "დაიმპორტდა %d BMC."

#: redfish_credentials.php
msgid "This credential is used by a BMC on a Cacti device you do not have access to, so it cannot be changed here."
msgstr "ამ ავტორიზაციის მონაცემს იყენებს BMC ისეთ Cacti მოწყობილობაზე, რომელზეც წვდომა არ გაქვთ, ამიტომ მისი შეცვლა აქ შეუძლებელია."

#: redfish_credentials.php
msgid "Name: another credential already uses this name."
msgstr "სახელი: სხვა ავტორიზაციის მონაცემი უკვე იყენებს ამ სახელს."

#: redfish_credentials.php
msgid "User Name: enter 1 to 255 characters without control characters."
msgstr "მომხმარებლის სახელი: შეიყვანეთ 1-დან 255-მდე სიმბოლო მართვის სიმბოლოების გარეშე."

#: redfish_credentials.php
msgid "Password: enter the password of the BMC account."
msgstr "პაროლი: შეიყვანეთ BMC ანგარიშის პაროლი."

#: redfish_credentials.php
#, php-format
msgid "The credential was saved, but the password was not stored: %s"
msgstr "ავტორიზაციის მონაცემი შეინახა, მაგრამ პაროლი ვერ ჩაიწერა: %s"

#: redfish_credentials.php
msgid "The credential could not be saved."
msgstr "ავტორიზაციის მონაცემის შენახვა ვერ მოხერხდა."

#: redfish_credentials.php
msgid "The credential was saved."
msgstr "ავტორიზაციის მონაცემი შენახულია."

#: redfish_credentials.php
msgid "The credential and its stored password were deleted."
msgstr "ავტორიზაციის მონაცემი და მისი შენახული პაროლი წაიშალა."

#: redfish_credentials.php
msgid "The credential was not deleted. A credential in use by a BMC cannot be deleted."
msgstr "ავტორიზაციის მონაცემი არ წაიშალა. BMC-ის მიერ გამოყენებული ავტორიზაციის მონაცემის წაშლა შეუძლებელია."

#: redfish_operator.php
msgid "Retry collection"
msgstr "შეგროვების ხელახლა ცდა"

#: redfish_operator.php
msgid "Monitoring view"
msgstr "მონიტორინგის ხედი"

#: redfish_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "დაკვირვებების წაკითხვა ვერ მოხერხდა. სთხოვეთ ადმინისტრატორს პლაგინის ჟურნალის შემოწმება."

