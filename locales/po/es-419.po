#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Compruebe la actualidad de la recopilación y los gráficos del dispositivo. Reintentar libera la retención para la próxima ejecución programada; no contacta ahora con el BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "El archivo está vacío o supera 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "No se pudo leer el archivo."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "El archivo no tiene fila de cabecera."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "El archivo tiene una columna «%s». Los archivos de importación no deben contener secretos; indique una credencial guardada en la columna credential. No se importó nada."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "La cabecera solo debe incluir estas columnas, una vez cada una, incluidas name, address y credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "El archivo tiene más de %d filas."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Línea %d: se esperaban %d campos y se encontraron %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Credencial: no hay ninguna credencial guardada llamada «%s»."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Línea %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Línea %d: la dirección %s y el puerto %d ya están registrados como %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "línea %d"

#: lib/BmcImport.php
#, php-format
