msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "No se puede usar el archivo de clave de la bóveda: %s. Hasta corregirlo no se pueden leer ni guardar contraseñas."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "El recopilador del sondeador %d tardó %.0f segundos, más que su presupuesto de %d segundos."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "El recopilador del sondeador %d agotó el tiempo antes de leer todos los BMC; los restantes continúan en la próxima ejecución. Agregue procesos o aumente el presupuesto."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "El recopilador del sondeador %d se ejecutó por última vez %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: la verificación TLS está desactivada. Cualquiera en el trayecto puede leer el tráfico, incluida la contraseña del BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: usa autenticación básica porque el BMC no ofrece sesiones; cada solicitud lleva la contraseña."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: puede haber quedado una sesión abierta en el BMC; la próxima ejecución la elimina después de iniciar sesión."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: se perdieron las respuestas de %d inicios de sesión seguidos y se detuvieron los accesos. Revise la lista de sesiones del BMC y use Reintentar ahora."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: el BMC rechazó la credencial. No se reintenta hasta que cambie."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: falta su credencial o no tiene contraseña guardada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: se ignoraron %d enlaces de sus respuestas que apuntaban a otros lugares."

