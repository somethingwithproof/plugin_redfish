msgstr "El archivo no contiene filas de BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nombre: ingrese de 1 a 100 caracteres sin caracteres de control."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Dirección: ingrese solo un nombre de host o IP, sin esquema, puerto, ruta ni usuario. Se rechazan direcciones de bucle local, enlace local, multidifusión y no especificadas."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Puerto: ingrese un puerto TCP entre 1 y 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Sondeador: en esta versión solo el sondeador principal puede recopilar datos de BMC."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Dispositivo: elija un dispositivo Cacti o ninguno."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Credencial: elija una credencial guardada."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Verificación TLS: elija uno de los modos enumerados."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Archivo de CA: ingrese una ruta absoluta de hasta 512 caracteres, sin caracteres de control."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Huella de clave pública: ingrese el hash SHA-256 en base64 de la clave pública del BMC, opcionalmente con el prefijo sha256//."

