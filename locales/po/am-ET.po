#: lib/Settings.php
msgid "Credential Vault"
msgstr "የምስክርነት ካዝና"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "የካዝና ቁልፍ ፋይል"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "የተቀመጡ የBMC ይለፍ ቃሎችን የሚያመሰጥረው የ32-ባይት ቁልፍ ሙሉ መንገድ። ከድር ሥሩ ውጭ፣ በድር አገልጋዩ እና በፖለር ተጠቃሚው ብቻ የሚነበብ፣ root እና ያ ተጠቃሚ ብቻ ሊጽፉበት በሚችሉት ማውጫ ውስጥ እራስዎ ይፍጠሩት፤ ተሰኪው በፍጹም አይፈጥረውም ወይም አይጽፈውም። ከዳታቤዙ ጋር ምትኬ ያስቀምጡለት፦ ያለ እሱ የተቀመጡ የይለፍ ቃሎች እንደገና መግባት አለባቸው።"

#: lib/Settings.php
msgid "Collector"
msgstr "ሰብሳቢ"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "የስብስብ ክፍተት"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "በእያንዳንዱ የBMC ንባብ መካከል ያሉ ሰከንዶች።"

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "እንደገና የማግኘት ክፍተት"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "በእያንዳንዱ BMC ሙሉ የሃብት ግኝቶች መካከል ያሉ ሰከንዶች። አንድ የሚታወቅ ሃብት ሲጠፋ ወይም ዓይነት ሲቀይር BMC ወዲያውኑ እንደገና ይገኛል።"

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "የሰብሳቢ ጊዜ በጀት"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "አንድ የሰብሳቢ ሂደት አዲስ BMCs መጀመር ከማቆሙ በፊት ሊወስድ የሚችለው ሰከንዶች። ከፖለር ክፍተቱ በታች ያድርጉት፤ ያልተጠናቀቁ BMCs በሚቀጥለው ሂደት ይቀጥላሉ።"

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "BMCs በትይዩ ይነበባሉ። እያንዳንዱ BMC በአንድ ጊዜ በአንድ ሰራተኛ ይነበባል።"

#: lib/Settings.php
msgid "Collector Workers"
msgstr "የሰብሳቢ ሰራተኞች"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "የግንኙነት ጊዜ ማብቂያ"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "ወደ BMC ለሚደረግ የTCP ግንኙነት እና የTLS መጨባበጥ የተፈቀዱ ሰከንዶች።"

#: lib/Settings.php
msgid "Request Timeout"
msgstr "የጥያቄ ጊዜ ማብቂያ"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "ግንኙነቱን ጨምሮ ወደ BMC ለአንድ ሙሉ ጥያቄ የተፈቀዱ ሰከንዶች።"

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "በአንድ የBMC ምላሽ አካል ውስጥ ተቀባይነት ያለው KiB፤ ከዚያ የበለጠ ምላሽ ተቀባይነት የለውም።"

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "ከፍተኛው የምላሽ መጠን"

#: lib/Settings.php
msgid "Freshness"
msgstr "ወቅታዊነት"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "አንድ ንባብ እንደዘገየ የሚታይባቸው የመሰብሰቢያ ክፍተቶች።"

#: lib/Settings.php
msgid "Delayed After"
msgstr "የሚዘገይበት ጊዜ"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "አንድ ንባብ ጊዜው ያለፈበት ሆኖ እንደ የማይታወቅ የሚነበብባቸው የመሰብሰቢያ ክፍተቶች። ሁልጊዜ ከ'የሚዘገይበት ጊዜ' ቢያንስ በአንድ ይበልጣል።"

#: lib/Settings.php
msgid "Stale After"
msgstr "ጊዜው ያለፈበት ተብሎ የሚቆጠርበት ከ"

#: lib/Settings.php
msgid "Uninstall"
msgstr "አራግፍ"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "ሲራገፍ የተሰኪ ሰንጠረዦችን አቆይ"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "ምልክት ሲደረግበት፣ ተሰኪውን ማራገፍ የBMC መዝገቡን፣ የተመሰጠሩ የይለፍ ቃሎቹን እና የንባብ መሸጎጫውን ያቆያል። ማራገፉ እንዲጥላቸው ምልክቱን ያጥፉ። ማራገፍ ተሰኪው የፈጠራቸውን መሣሪያዎች ጨምሮ የCacti መሣሪያዎችን፣ ግራፎችን ወይም BMCsን በፍጹም አይነካም።"

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "ከስርዓቱ የCA ማከማቻ ጋር አረጋግጥ"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "ከCA ጥቅል ፋይል ጋር አረጋግጥ"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "የተሰካ የህዝብ ቁልፍ (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "አታረጋግጥ (ደህንነቱ ያልተጠበቀ)"

#: redfish_bmcs.php
msgid "You do not have access to the Cacti device of this BMC."
msgstr "የዚህ BMC የCacti መሣሪያ መዳረሻ የለዎትም።"

#: redfish_bmcs.php
msgid "The BMC could not be saved."
msgstr "BMC ሊቀመጥ አልቻለም።"

#: redfish_bmcs.php
msgid "The BMC was saved."
msgstr "BMC ተቀምጧል።"

#: redfish_bmcs.php
msgid "The BMC and its cached data were deleted. Its Cacti device was left in place."
msgstr "BMC እና የተሸጎጠው ውሂብ ተሰርዘዋል። የCacti መሣሪያው በቦታው ተትቷል።"

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "የማዘግየት ጊዜ እና የተያዙ ውድቀቶች ተጸድተዋል፤ ሰብሳቢው በሚቀጥለው ሂደቱ BMCን ያነባል።"

#: redfish_bmcs.php
msgid "Adding devices and graphs needs Cacti's device management permission."
msgstr "መሣሪያዎችን እና ግራፎችን ማከል የCacti የመሣሪያ አስተዳደር ፈቃድን ይፈልጋል።"

#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "የዚህ BMC መሣሪያ ተሰርዟል። በመጀመሪያ በBMC ቅጹ ላይ ሌላ መሣሪያ ወይም ምንም ይምረጡ።"

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "የውሂብ መጠይቆቹ እንደገና ተጠቁመዋል እና %d ግራፎች ታክለዋል።"

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "መሣሪያው ከRedfish ግራፎቹ ጋር ተፈጥሯል።"

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "የRedfish አብነቶችን መጫን የCacti አብነቶችን የማስገባት ፈቃድን ይፈልጋል።"

#: redfish_bmcs.php
msgid "The Redfish templates are installed."
msgstr "የRedfish አብነቶች ተጭነዋል።"

#: redfish_bmcs.php
msgid "The Redfish templates could not be installed. The health page shows why."
msgstr "የRedfish አብነቶች ሊጫኑ አልቻሉም። የጤና ገጹ ለምን እንደሆነ ያሳያል።"

#: redfish_bmcs.php
