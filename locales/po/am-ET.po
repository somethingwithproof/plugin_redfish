msgstr "ማረጋገጥ የሚከተሉትን ያክላል፦"

#: lib/BmcsPage.php
msgid "Existing devices, graphs, and thresholds are not changed."
msgstr "ነባር መሣሪያዎች፣ ግራፎች እና ገደቦች አይለወጡም።"

#: lib/BmcsPage.php
msgid "Confirm"
msgstr "አረጋግጥ"

#: lib/BmcsPage.php
msgid "Cancel"
msgstr "ተወው"

#: lib/BmcsPage.php
msgid "Import BMCs"
msgstr "BMCs አስገባ"

#: lib/BmcsPage.php
msgid "CSV File"
msgstr "የCSV ፋይል"

#: lib/BmcsPage.php
#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "አምዶች ያሉት የራስጌ ረድፍ፦ %s። የተቀመጠ የመግቢያ መረጃ ይጥቀሱ፤ በፋይሉ ውስጥ የይለፍ ቃል በፍጹም አያስቀምጡ። እያንዳንዱ ረድፍ ትክክለኛ መሆን አለበት ወይም ምንም አይገባም።"

#: lib/BmcsPage.php
msgid "Import"
msgstr "አስገባ"

#: lib/BmcsPage.php
msgid "Choose a credential"
msgstr "የመግቢያ መረጃ ይምረጡ"

#: lib/BmcsPage.php
msgid "None"
msgstr "ምንም"

#: lib/BmcsPage.php
#, php-format
msgid "Deleted device (ID %d)"
msgstr "የተሰረዘ መሣሪያ (መታወቂያ %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "አዲስ Redfish BMC"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "Redfish BMC፦ %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "ያለ https:// ወይም መንገድ የBMC አስተናጋጅ ስም ወይም IP አድራሻ።"

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "'አታረጋግጥ' ሲመረጥ በመዝገብ ውስጥ ይጻፋል እንዲሁም እስከሚቆይ ድረስ በጤና ገጹ ላይ እንደ ማስጠንቀቂያ ይታያል።"

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "የCA ጥቅል ፋይል"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "ለCA ጥቅል ሁነታ፦ ሌሎች ሊጽፉበት የማይችሉት በፖለሩ ላይ ያለ የPEM ፋይል ሙሉ መንገድ።"

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "ለተሰካ ሁነታ፦ የBMC የህዝብ ቁልፍ base64 SHA-256፣ እንደ sha256//... ወይም ባዶ ሃሽ። የተለወጠ ቁልፍ ይህ እስኪዘምን ድረስ አይሳካም።"

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "የህዝብ ቁልፍ ፒን"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "የBasic ማረጋገጫ መጠባበቂያን ፍቀድ"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "BMC የክፍለ-ጊዜ አገልግሎት በማይሰጥበት ጊዜ ብቻ ጥቅም ላይ ይውላል። ያኔ እያንዳንዱ ጥያቄ የይለፍ ቃሉን ይይዛል፤ ጥቅም ላይ እያለ የጤና ገጹ ያስጠነቅቃል።"

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "ይህ BMC የሚያስተዳድረው የአገልጋዩ Cacti መሣሪያ። ተሰኪው ከዝርዝሩ ውስጥ መሣሪያ እንዲፈጥር ምንም ላይ ይተዉት።"

#: lib/BmcsPage.php lib/CredentialsPage.php
msgid "Save"
msgstr "አስቀምጥ"

#: lib/BmcsPage.php
#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "አድራሻ፦ %s ወደብ %d ቀድሞውኑ እንደ %s ተመዝግቧል።"

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "አድራሻ፦ ይህ አድራሻ እና ወደብ ቀድሞውኑ ተመዝግበዋል።"

#: lib/BmcsPage.php
msgid "Name: another BMC already uses this name."
msgstr "ስም፦ ሌላ BMC ቀድሞውኑ ይህንን ስም ይጠቀማል።"

#: lib/BmcsPage.php
msgid "Device: no Cacti device has this ID."
msgstr "መሣሪያ፦ ይህ ID ያለው የCacti መሣሪያ የለም።"

