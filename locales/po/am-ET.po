#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "የስብስብ ትኩስነትን እና የመሣሪያውን ግራፎች ያረጋግጡ። እንደገና መሞከር ለሚቀጥለው የታቀደ ሩጫ የስብስብ እገዳን ይለቃል፤ አሁን ከ BMC ጋር አይገናኝም።"

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "ፋይሉ ባዶ ነው ወይም ከ 1 MiB ይበልጣል።"

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "ፋይሉን ማንበብ አልተቻለም።"

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "ፋይሉ የራስጌ ረድፍ የለውም።"

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "ፋይሉ \"%s\" የሚባል ዓምድ አለው። የማስመጫ ፋይሎች ምስጢሮችን መያዝ የለባቸውም፤ በምትኩ በ credential ዓምድ ውስጥ የተቀመጠ ማረጋገጫ ስም ይጥቀሱ። ምንም ነገር አልገባም።"

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "ራስጌው name፣ address እና credential ን ጨምሮ እነዚህን ዓምዶች ብቻ እያንዳንዳቸውን አንድ ጊዜ መሰየም አለበት፦ %s።"

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "ፋይሉ ከ %d በላይ ረድፎች አሉት።"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "መስመር %d፦ %d መስኮች ይጠበቁ ነበር፣ %d ተገኝተዋል።"

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "ማረጋገጫ፦ \"%s\" የተባለ የተቀመጠ ማረጋገጫ የለም።"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "መስመር %d፦ %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "መስመር %d፦ አድራሻ %s ወደብ %d አስቀድሞ እንደ %s ተመዝግቧል።"

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "መስመር %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "መስመር %d: %s የሚለው ስም ቀድሞውኑ ጥቅም ላይ ውሏል።"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "መስመር %d: ID %d ያለው የCacti መሣሪያ የለም።"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "መስመር %d: መሣሪያ %d ቀድሞውኑ %s BMC አለው።"

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "የመስመር %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "ፋይሉ ምንም የBMC ረድፎች የሉትም።"

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "ስም፦ ያለ መቆጣጠሪያ ቁምፊዎች ከ1 እስከ 100 ቁምፊዎችን ያስገቡ።"

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "አድራሻ፦ ያለ እቅድ፣ ወደብ፣ መንገድ ወይም የተጠቃሚ ስም የአስተናጋጅ ስም ወይም የIP አድራሻ ብቻ ያስገቡ። የሉፕባክ፣ የሊንክ-ሎካል፣ የመልቲካስት እና ያልተገለጹ አድራሻዎች ተቀባይነት የላቸውም።"

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "ወደብ፦ ከ1 እስከ 65535 ያለ የTCP ወደብ ያስገቡ።"

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "ፖለር፦ በዚህ እትም ውስጥ ዋናው ፖለር ብቻ BMCs መሰብሰብ ይችላል።"

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "መሣሪያ፦ የCacti መሣሪያ ይምረጡ ወይም ምንም አይምረጡ።"

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "የመግቢያ መረጃ፦ የተቀመጠ የመግቢያ መረጃ ይምረጡ።"

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "የTLS ማረጋገጫ፦ ከተዘረዘሩት ሁነታዎች አንዱን ይምረጡ።"

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "የCA ጥቅል ፋይል፦ የመቆጣጠሪያ ቁምፊዎች የሌሉበት ሙሉ መንገድ ያስገቡ፣ ቢበዛ 512 ቁምፊዎች።"

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "የህዝብ ቁልፍ ፒን፦ የBMC የህዝብ ቁልፍ የbase64 SHA-256 ሃሽ ያስገቡ፣ እንደ አማራጭ በsha256// ሊጀምር ይችላል።"

