#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Verifique a atualidade da recolha e os gráficos do dispositivo. Tentar novamente liberta uma retenção de recolha para a próxima execução agendada; não contacta o BMC agora."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "O ficheiro está vazio ou tem mais de 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Não foi possível ler o ficheiro."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "O ficheiro não tem linha de cabeçalho."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "O ficheiro tem uma coluna chamada \"%s\". Os ficheiros de importação não devem conter segredos; indique antes o nome de uma credencial guardada na coluna credential. Nada foi importado."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "O cabeçalho deve indicar apenas estas colunas, cada uma uma vez, incluindo name, address e credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "O ficheiro tem mais de %d linhas."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Linha %d: eram esperados %d campos, foram encontrados %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Credencial: não existe nenhuma credencial guardada com o nome \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Linha %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Linha %d: o endereço %s porta %d já está registado como %s."

