#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nome: introduza entre 1 e 100 caracteres sem caracteres de controlo."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Endereço: introduza apenas um nome de anfitrião ou um endereço IP, sem esquema, porta, caminho ou nome de utilizador. Endereços de loopback, link-local, multicast e não especificados são recusados."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Porta: introduza uma porta TCP de 1 a 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: apenas o poller principal pode recolher BMCs nesta versão."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Dispositivo: escolha um dispositivo Cacti ou nenhum."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Credencial: escolha uma credencial guardada."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Verificação TLS: escolha um dos modos listados."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Ficheiro de pacote CA: introduza um caminho absoluto sem caracteres de controlo, com no máximo 512 caracteres."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Fixação de chave pública: introduza o hash SHA-256 em base64 da chave pública do BMC, opcionalmente com o prefixo sha256//."

