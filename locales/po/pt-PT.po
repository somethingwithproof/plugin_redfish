#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "O coletor no poller %d demorou %.0f segundos, mais do que o seu limite de %d segundos."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "O coletor no poller %d ficou sem tempo antes de ler todos os BMCs; os restantes retomam na próxima execução. Adicione trabalhadores ou aumente o limite de tempo."

#: lib/HealthWarnings.php
