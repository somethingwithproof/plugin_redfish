msgstr "A última execução do coletor no poller %d foi %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: a verificação TLS está desativada. Qualquer pessoa no trajeto pode ler o tráfego, incluindo a palavra-passe do BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: utiliza autenticação Basic porque o BMC não disponibiliza serviço de sessão; cada pedido transporta a palavra-passe."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: pode ter ficado uma sessão aberta no BMC; a próxima execução elimina-a depois de iniciar sessão."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d inícios de sessão consecutivos perderam a resposta, pelo que os inícios de sessão foram interrompidos. Verifique a lista de sessões do BMC e utilize Tentar novamente agora."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: o BMC rejeitou a credencial. Não será tentada novamente até que a credencial seja alterada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: a credencial está em falta ou não tem palavra-passe guardada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d ligações nas suas respostas apontavam para outro local e foram ignoradas."

