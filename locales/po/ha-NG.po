#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Ba za a iya amfani da fayil ɗin maɓallin ma'ajiya ba: %s. Ba za a iya karanta ko rubuta kalmomin sirri da aka ajiye ba har sai an gyara shi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Mai tattarawa akan poller %d ya ɗauki daƙiƙa %.0f, fiye da ƙayyadadden lokacinsa na daƙiƙa %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Lokacin mai tattarawa akan poller %d ya ƙare kafin a karanta kowane BMC; sauran za su ci gaba a zagaye na gaba. Ƙara ma'aikata (workers) ko ƙara ƙayyadadden lokacin."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Mai tattarawa akan poller %d ya yi aiki na ƙarshe %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: an kashe tabbatar da TLS. Duk wanda ke kan hanyar sadarwa zai iya karanta bayanan zirga-zirgarsa, gami da kalmar sirrin BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: yana amfani da tantancewar Basic saboda BMC ba ta da sabis na zama (session service); kowane buƙata yana ɗauke da kalmar sirri."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: wataƙila an bar zama (session) a buɗe akan BMC; zagaye na gaba zai share shi bayan an shiga."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: shiga zama sau %d a jere sun rasa amsarsu, don haka shiga ya tsaya. Duba jerin zama na BMC, sannan ka yi amfani da Sake Gwadawa Yanzu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC ta ƙi amincewa da bayanan shigar. Ba za a sake gwadawa ba har sai bayanan shigar sun canza."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: bayanan shigarsa sun ɓace ko kuma ba shi da kalmar sirrin da aka ajiye."

