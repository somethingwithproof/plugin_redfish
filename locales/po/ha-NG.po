#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Duba sabuntar tarawa da zane-zanen na'urar. Sake gwadawa yana sakin riƙon tarawa don gudana ta gaba da aka tsara; ba ya tuntuɓar BMC yanzu."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Fayil ɗin fanko ne ko kuma ya fi 1 MiB girma."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Ba a iya karanta fayil ɗin ba."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Fayil ɗin ba shi da layin kanun shafi."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Fayil ɗin yana da shafi mai suna \"%s\". Fayilolin shigo da bayanai ba su kamata su ɗauki sirrika ba; a maimakon haka ambaci bayanin shiga da aka adana a cikin shafin credential. Ba a shigo da komai ba."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Kanun shafi dole ne ya ambaci waɗannan shafuka kaɗai, kowanne sau ɗaya, ciki har da name, address, da credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Fayil ɗin yana da layuka fiye da %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Layi %d: an yi tsammanin filaye %d, an sami %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Bayanin Shiga: babu bayanin shiga da aka adana mai suna \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Layi %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Layi %d: adireshin %s tasha %d an riga an yi masa rajista a matsayin %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "layi %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Layi na %d: an riga an yi amfani da sunan %s."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Layi na %d: babu wata na'urar Cacti mai lambar ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Layi na %d: na'ura ta %d ta riga tana da BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "na layi na %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Fayil ɗin ba shi da layukan BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Suna: shigar da haruffa 1 zuwa 100 ba tare da haruffan sarrafawa ba."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adireshi: shigar da sunan uwar garke ko adireshin IP kaɗai, ba tare da tsari, port, hanya, ko sunan mai amfani ba. Ba a karɓar adiresoshin loopback, link-local, multicast, da waɗanda ba a ƙayyade ba."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: shigar da TCP port daga 1 zuwa 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: babban poller kaɗai zai iya tattara bayanan BMCs a wannan fitowar."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Na'ura: zaɓi na'urar Cacti ko babu ko ɗaya."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Bayanan shiga: zaɓi bayanan shiga da aka ajiye."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Tabbatar da TLS: zaɓi ɗaya daga cikin yanayoyin da aka jera."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Fayil ɗin CA Bundle: shigar da cikakkiyar hanya (absolute path) ba tare da haruffan sarrafawa ba, haruffa 512 a mafi yawa."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin ɗin Maɓallin Jama'a: shigar da lambar hash ta base64 SHA-256 ta maɓallin jama'a na BMC, ana iya sanya sha256// a gaba idan ana so."

