#, php-format
msgid "Deleted device (ID %d)"
msgstr "Dzēsta ierīce (ID %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "Jauns Redfish BMC"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "Redfish BMC: %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "BMC resursdatora nosaukums vai IP adrese bez https:// vai ceļa."

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "Režīma \"Neverificēt\" iestatīšana tiek reģistrēta žurnālā, un, kamēr tas ir aktīvs, darbspējas lapā tiek rādīts brīdinājums."

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "CA sertifikātu kopas fails"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "CA sertifikātu kopas režīmam: absolūts ceļš aptaujātājā uz PEM failu, kurā citi lietotāji nevar rakstīt."

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "Piesaistītās atslēgas režīmam: BMC publiskās atslēgas base64 SHA-256 jaucējvērtība formā sha256//... vai bez prefiksa. Atslēgas maiņa izraisīs kļūdu, līdz šī vērtība tiks atjaunināta."

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "Publiskās atslēgas piesaiste"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "Atļaut Basic autentifikācijas rezerves režīmu"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "Tiek izmantots tikai tad, ja BMC nepiedāvā sesiju pakalpojumu. Šādā gadījumā katrs pieprasījums satur paroli; kamēr tas tiek izmantots, darbspējas lapā tiek rādīts brīdinājums."

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "Tā servera Cacti ierīce, kuru pārvalda šis BMC. Atstājiet \"Nav\", lai spraudnis varētu izveidot ierīci no saraksta."

#: lib/BmcsPage.php lib/CredentialsPage.php
