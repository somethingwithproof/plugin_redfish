msgstr "Lietotājvārds"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Vēl nav akreditācijas datu. Izveidojiet ierakstu ar tikai lasīšanai paredzētu BMC kontu."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "Nav saglabāts"

#: lib/CredentialsPage.php
