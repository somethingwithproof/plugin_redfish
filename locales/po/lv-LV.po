#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Glabātuves atslēgas failu nevar izmantot: %s. Saglabātās paroles nevar nolasīt vai ierakstīt, kamēr tas netiek salabots."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Datu vācējs aptaujātājā %d darbojās %.0f sekundes, pārsniedzot savu %d sekunžu laika limitu."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Datu vācējam aptaujātājā %d beidzās laiks, pirms tika nolasīti visi BMC; pārējie tiks apstrādāti nākamajā izpildē. Pievienojiet darba procesus vai palieliniet laika limitu."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Datu vācējs aptaujātājā %d pēdējo reizi darbojās %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS verifikācija ir izslēgta. Ikviens tīkla ceļā var nolasīt trafiku, tostarp BMC paroli."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: izmanto Basic autentifikāciju, jo BMC nepiedāvā sesiju pakalpojumu; katrs pieprasījums satur paroli."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: BMC ierīcē, iespējams, palika atvērta sesija; nākamā izpilde to dzēsīs pēc pieteikšanās."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d sesijas pieteikšanās reizes pēc kārtas nesaņēma atbildi, tāpēc pieteikšanās tika apturēta. Pārbaudiet BMC sesiju sarakstu un pēc tam izmantojiet \"Mēģināt vēlreiz\"."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
