#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Pārbaudiet datu vākšanas aktualitāti un ierīces grafikus. Atkārtots mēģinājums atceļ datu vākšanas aizturi nākamajai plānotajai izpildei; tas tūlīt nesazinās ar BMC."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Fails ir tukšs vai lielāks par 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Failu nevarēja nolasīt."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Failam nav galvenes rindas."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Failā ir kolonna ar nosaukumu \"%s\". Importa faili nedrīkst saturēt noslēpumus; tā vietā kolonnā credential norādiet saglabāto akreditācijas datu nosaukumu. Nekas netika importēts."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Galvenē jānorāda tikai šīs kolonnas, katru vienu reizi, ieskaitot name, address un credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Failā ir vairāk nekā %d rindas."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "%d. rinda: gaidīti %d lauki, atrasti %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Akreditācijas dati: nav saglabātu akreditācijas datu ar nosaukumu \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "%d. rinda: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "%d. rinda: adrese %s, ports %d jau ir reģistrēta kā %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "%d. rinda"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "%d. rinda: nosaukums %s jau tiek izmantots."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "%d. rinda: nevienai Cacti ierīcei nav ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "%d. rinda: ierīcei %d jau ir BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "no %d. rindas"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Failā nav nevienas BMC rindas."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nosaukums: ievadiet no 1 līdz 100 rakstzīmēm bez vadības rakstzīmēm."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adrese: ievadiet tikai resursdatora nosaukumu vai IP adresi bez shēmas, porta, ceļa vai lietotājvārda. Atgriezeniskās cilpas (loopback), lokālās saites (link-local), multiraides un nenoteiktas adreses tiek noraidītas."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Ports: ievadiet TCP portu no 1 līdz 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Aptaujātājs: šajā laidienā BMC datus var vākt tikai galvenais aptaujātājs."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Ierīce: izvēlieties Cacti ierīci vai nevienu."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Akreditācijas dati: izvēlieties saglabātus akreditācijas datus."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS verifikācija: izvēlieties vienu no norādītajiem režīmiem."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA sertifikātu kopas fails: ievadiet absolūtu ceļu bez vadības rakstzīmēm, ne garāku par 512 rakstzīmēm."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Publiskās atslēgas piesaiste: ievadiet BMC publiskās atslēgas base64 SHA-256 jaucējvērtību, pēc izvēles ar prefiksu sha256//."

