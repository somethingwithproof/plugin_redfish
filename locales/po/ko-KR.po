msgstr "암호"

#: lib/CredentialsPage.php
msgid "Used By"
msgstr "사용 대상"

#: lib/CredentialsPage.php
msgid "User Name"
msgstr "사용자 이름"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "아직 자격 증명이 없습니다. 읽기 전용 BMC 계정으로 하나 생성하세요."

#: lib/CredentialsPage.php
