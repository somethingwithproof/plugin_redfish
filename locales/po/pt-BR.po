msgstr "O coletor no poller %d foi executado pela última vez em %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: a verificação TLS está desativada. Qualquer pessoa no caminho pode ler seu tráfego, incluindo a senha do BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: usa autenticação Basic porque o BMC não oferece serviço de sessão; cada solicitação envia a senha."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: uma sessão pode ter ficado aberta no BMC; a próxima execução a excluirá após o login."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d logins de sessão consecutivos perderam a resposta, portanto os logins foram interrompidos. Verifique a lista de sessões do BMC e use Tentar novamente agora."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: o BMC rejeitou a credencial. Ela não será tentada novamente até que a credencial seja alterada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: sua credencial está ausente ou não possui senha armazenada."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d links em suas respostas apontavam para outro local e foram ignorados."

