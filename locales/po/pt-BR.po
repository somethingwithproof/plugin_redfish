#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Verifique a atualidade da coleta e os gráficos do dispositivo. Tentar novamente libera uma retenção de coleta para a próxima execução agendada; isso não contata o BMC agora."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "O arquivo está vazio ou é maior que 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Não foi possível ler o arquivo."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "O arquivo não tem linha de cabeçalho."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "O arquivo tem uma coluna chamada \"%s\". Arquivos de importação não devem conter segredos; informe o nome de uma credencial armazenada na coluna credential. Nada foi importado."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "O cabeçalho deve nomear apenas estas colunas, cada uma uma vez, incluindo name, address e credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "O arquivo tem mais de %d linhas."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Linha %d: esperados %d campos, encontrados %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Credencial: nenhuma credencial armazenada se chama \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Linha %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Linha %d: o endereço %s porta %d já está registrado como %s."

