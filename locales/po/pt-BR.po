msgstr "Não é possível usar o arquivo de chave do cofre: %s. Senhas armazenadas não podem ser lidas ou gravadas até que isso seja corrigido."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "O coletor no poller %d levou %.0f segundos, mais do que seu limite de tempo de %d segundos."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "O coletor no poller %d ficou sem tempo antes que todos os BMCs fossem lidos; os restantes serão retomados na próxima execução. Adicione workers ou aumente o limite de tempo."

#: lib/HealthWarnings.php
