#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Toplama güncelliğini ve cihaz grafiklerini denetleyin. Yeniden Dene, bir sonraki zamanlanmış çalıştırma için toplama bekletmesini kaldırır; şimdi BMC ile iletişim kurmaz."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Dosya boş veya 1 MiB boyutundan büyük."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Dosya okunamadı."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Dosyada başlık satırı yok."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Dosyada \"%s\" adlı bir sütun var. İçe aktarma dosyaları gizli bilgi taşımamalıdır; bunun yerine credential sütununda kayıtlı bir kimlik bilgisinin adını belirtin. Hiçbir şey içe aktarılmadı."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Başlık yalnızca bu sütunları, her birini bir kez, name, address ve credential dahil olacak şekilde adlandırmalıdır: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Dosyada %d satırdan fazla satır var."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Satır %d: %d alan bekleniyordu, %d bulundu."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Kimlik Bilgisi: \"%s\" adlı kayıtlı bir kimlik bilgisi yok."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Satır %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Satır %d: %s adresi %d bağlantı noktası zaten %s olarak kayıtlı."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "satır %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Satır %d: %s adı zaten kullanılıyor."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Satır %d: %d kimliğine sahip bir Cacti cihazı yok."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Satır %d: %d cihazında zaten %s BMC'si var."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "%d. satırın"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Dosyada BMC satırı yok."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Ad: denetim karakterleri olmadan 1 ila 100 karakter girin."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adres: yalnızca bir ana bilgisayar adı veya IP adresi girin; şema, bağlantı noktası, yol veya kullanıcı adı eklemeyin. Geri döngü, bağlantı yerel, çok noktaya yayın ve belirtilmemiş adresler reddedilir."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Bağlantı Noktası: 1 ile 65535 arasında bir TCP bağlantı noktası girin."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Yoklayıcı: bu sürümde yalnızca ana yoklayıcı BMC verisi toplayabilir."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Cihaz: bir Cacti cihazı seçin veya yok olarak bırakın."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Kimlik Bilgisi: kayıtlı bir kimlik bilgisi seçin."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS Doğrulama: listelenen modlardan birini seçin."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA Paketi Dosyası: kontrol karakterleri içermeyen, en fazla 512 karakterlik mutlak bir yol girin."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Açık Anahtar Sabitlemesi: BMC açık anahtarının base64 SHA-256 özetini girin; isteğe bağlı olarak başına sha256// ekleyebilirsiniz."

