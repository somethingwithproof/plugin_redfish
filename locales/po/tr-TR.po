#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Kasa anahtar dosyası kullanılamıyor: %s. Düzeltilene kadar kayıtlı parolalar okunamaz veya yazılamaz."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "%d yoklayıcısındaki toplayıcı %.0f saniye sürdü; bu süre %d saniyelik bütçesinden fazla."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "%d yoklayıcısındaki toplayıcının süresi tüm BMC'ler okunmadan doldu; kalanlar bir sonraki çalıştırmada devam edecektir. Çalışan ekleyin veya bütçeyi artırın."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "%d yoklayıcısındaki toplayıcı en son %s çalıştı."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS doğrulaması kapalı. Yol üzerindeki herkes BMC parolası dahil trafiğini okuyabilir."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: BMC oturum hizmeti sunmadığı için Basic kimlik doğrulaması kullanıyor; her istek parolayı taşır."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: BMC üzerinde açık bir oturum kalmış olabilir; bir sonraki çalıştırma oturum açtıktan sonra bunu silecektir."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: art arda %d oturum açma işleminin yanıtı kayboldu, bu nedenle oturum açma durduruldu. BMC oturum listesini kontrol edin, ardından Şimdi Yeniden Dene'yi kullanın."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC kimlik bilgisini reddetti. Kimlik bilgisi değişene kadar yeniden denenmeyecek."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: kimlik bilgisi eksik veya kayıtlı parolası yok."

#: lib/HealthWarnings.php
