#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Valvnyckelfilen kan inte användas: %s. Lagrade lösenord kan inte läsas eller skrivas förrän detta är åtgärdat."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Insamlaren på poller %d tog %.0f sekunder, vilket är mer än dess budget på %d sekunder."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Insamlaren på poller %d fick slut på tid innan alla BMC:er hann läsas; resten återupptas vid nästa körning. Lägg till arbetsprocesser eller höj budgeten."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Insamlaren på poller %d kördes senast %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS-verifiering är avstängd. Vem som helst längs nätverksvägen kan läsa dess trafik, inklusive BMC-lösenordet."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: använder Basic-autentisering eftersom BMC:n inte erbjuder någon sessionstjänst; varje begäran innehåller lösenordet."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: en session kan ha lämnats öppen på BMC:n; nästa körning tar bort den efter inloggning."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d sessionsinloggningar i rad förlorade sitt svar, så inloggningarna stoppades. Kontrollera BMC:ns sessionslista och använd sedan Försök igen nu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC:n avvisade inloggningsuppgiften. Den provas inte igen förrän inloggningsuppgiften ändras."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: dess inloggningsuppgift saknas eller har inget lagrat lösenord."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d länkar i dess svar pekade någon annanstans och ignorerades."

