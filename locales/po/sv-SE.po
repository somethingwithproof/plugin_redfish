#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Kontrollera insamlingens aktualitet och enhetens grafer. Försök igen släpper en insamlingsspärr inför nästa schemalagda körning; det kontaktar inte BMC:n nu."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Filen är tom eller större än 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Filen kunde inte läsas."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Filen saknar rubrikrad."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Filen har en kolumn med namnet \"%s\". Importfiler får inte innehålla hemligheter; ange namnet på en lagrad inloggningsuppgift i kolumnen credential i stället. Ingenting importerades."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Rubrikraden får endast ange dessa kolumner, en gång vardera, inklusive name, address och credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Filen har fler än %d rader."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Rad %d: förväntade %d fält, hittade %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Inloggningsuppgift: ingen lagrad inloggningsuppgift heter \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Rad %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Rad %d: adressen %s port %d är redan registrerad som %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "rad %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Rad %d: namnet %s används redan."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Rad %d: ingen Cacti-enhet har ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Rad %d: enhet %d har redan BMC:n %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "på rad %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Filen innehåller inga BMC-rader."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Namn: ange 1 till 100 tecken utan kontrolltecken."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Adress: ange endast ett värdnamn eller en IP-adress, utan schema, port, sökväg eller användarnamn. Loopback-, länklokala, multicast- och ospecificerade adresser avvisas."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: ange en TCP-port från 1 till 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: endast huvudpollern kan samla in BMC:er i den här versionen."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Enhet: välj en Cacti-enhet eller ingen."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Inloggningsuppgift: välj en lagrad inloggningsuppgift."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS-verifiering: välj ett av de listade lägena."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA-bundlefil: ange en absolut sökväg utan kontrolltecken, högst 512 tecken."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Fäst publik nyckel: ange base64-kodad SHA-256-hash för BMC:ns publika nyckel, valfritt med prefixet sha256//."

