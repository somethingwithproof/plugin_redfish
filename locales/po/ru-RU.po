msgid "CSV File"
msgstr "CSV-файл"

#: lib/BmcsPage.php
#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "Строка заголовка со столбцами: %s. Укажите имя сохранённых учётных данных; никогда не помещайте пароль в файл. Все строки должны быть корректными, иначе импорт не будет выполнен."

#: lib/BmcsPage.php
msgid "Import"
msgstr "Импорт"

#: lib/BmcsPage.php
msgid "Choose a credential"
msgstr "Выберите учётные данные"

#: lib/BmcsPage.php
msgid "None"
msgstr "Нет"

#: lib/BmcsPage.php
#, php-format
msgid "Deleted device (ID %d)"
msgstr "Удалённое устройство (ID %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "Новый BMC Redfish"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "BMC Redfish: %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "Имя хоста или IP-адрес BMC без https:// и без пути."

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "При выборе режима без проверки это событие заносится в журнал, а на странице состояния отображается предупреждение, пока этот режим активен."

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "Файл пакета CA"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "Для режима пакета CA: абсолютный путь на опросчике к PEM-файлу, недоступному для записи другим пользователям."

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "Для режима закреплённого ключа: хеш SHA-256 открытого ключа BMC в кодировке base64 в виде sha256//... или только сам хеш. При изменении ключа проверка будет завершаться ошибкой до обновления этого значения."

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "Закрепление открытого ключа"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "Разрешить резервную Basic-аутентификацию"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "Используется только в том случае, если BMC не поддерживает службу сеансов. При этом пароль передаётся в каждом запросе; пока этот режим используется, на странице состояния выводится предупреждение."

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "Устройство Cacti сервера, которым управляет этот BMC. Оставьте значение «нет», чтобы плагин создал устройство из списка."

#: lib/BmcsPage.php lib/CredentialsPage.php
msgid "Save"
msgstr "Сохранить"

