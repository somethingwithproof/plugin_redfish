#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Проверьте актуальность сбора данных и графики устройства. Повторная попытка снимает блокировку сбора до следующего планового запуска и не обращается к BMC прямо сейчас."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Файл пуст или его размер превышает 1 МиБ."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Не удалось прочитать файл."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "В файле отсутствует строка заголовка."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Файл содержит столбец с именем \"%s\". Файлы импорта не должны содержать секреты; вместо этого укажите имя сохранённых учётных данных в столбце credential. Ничего не импортировано."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Заголовок должен содержать только эти столбцы, по одному разу каждый, включая name, address и credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "В файле более %d строк."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Строка %d: ожидалось полей — %d, найдено — %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Учётные данные: нет сохранённых учётных данных с именем \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Строка %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Строка %d: адрес %s, порт %d уже зарегистрирован как %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "строка %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Строка %d: имя %s уже используется."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Строка %d: устройство Cacti с ID %d не найдено."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Строка %d: к устройству %d уже привязан BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "строки %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "В файле нет строк с BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Имя: введите от 1 до 100 символов без управляющих символов."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Адрес: введите только имя хоста или IP-адрес, без схемы, порта, пути или имени пользователя. Loopback-, link-local-, multicast-адреса и неопределённые адреса отклоняются."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Порт: введите TCP-порт от 1 до 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Опросчик: в этом выпуске опрос BMC может выполнять только основной опросчик."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Устройство: выберите устройство Cacti или оставьте значение «нет»."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Учётные данные: выберите сохранённые учётные данные."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Проверка TLS: выберите один из перечисленных режимов."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Файл пакета CA: введите абсолютный путь без управляющих символов, не более 512 символов."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Закрепление открытого ключа: введите SHA-256-хеш открытого ключа BMC в кодировке base64, при необходимости с префиксом sha256//."

