#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "Адрес: %s, порт %d уже зарегистрирован как %s."

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "Адрес: этот адрес и порт уже зарегистрированы."

