#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Невозможно использовать файл ключа хранилища: %s. Сохранённые пароли нельзя ни прочитать, ни записать, пока эта проблема не будет устранена."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Сборщик на опросчике %d выполнялся %.0f секунд, превысив выделенный бюджет в %d секунд."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Сборщику на опросчике %d не хватило времени для опроса всех BMC; оставшиеся будут опрошены при следующем запуске. Добавьте обработчики или увеличьте бюджет времени."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Сборщик на опросчике %d последний раз запускался %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: проверка TLS отключена. Любой на пути следования трафика может перехватить его, включая пароль BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: используется Basic-аутентификация, так как BMC не поддерживает службу сеансов; пароль передаётся в каждом запросе."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: на BMC мог остаться открытый сеанс; при следующем запуске он будет удалён после входа."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d попыток входа в сеанс подряд не получили ответа, поэтому вход приостановлен. Проверьте список сеансов BMC, затем нажмите «Повторить сейчас»."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC отклонил учётные данные. Повторные попытки не выполняются до изменения учётных данных."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: учётные данные отсутствуют или для них не сохранён пароль."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d ссылок в ответах указывали на внешние ресурсы и были проигнорированы."

