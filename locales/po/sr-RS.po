#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Сакупљачу на полеру %d истекло је време пре него што су сви BMC уређаји очитани; преостали се настављају при следећем покретању. Додајте раднике или повећајте временски буџет."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Сакупљач на полеру %d последњи пут је покренут %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: TLS провера је искључена. Свако на мрежној путањи може да чита његов саобраћај, укључујући лозинку BMC-а."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: користи Basic аутентификацију јер BMC не нуди сервис сесија; сваки захтев носи лозинку."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: на BMC-у је можда остала отворена сесија; следеће покретање ће је обрисати након пријаве."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d узастопних пријава сесије остало је без одговора, па су пријаве заустављене. Проверите списак сесија на BMC-у, а затим употребите Покушај поново сада."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC је одбио акредитив. Неће се поново покушавати док се акредитив не измени."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: његов акредитив недостаје или нема сачувану лозинку."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d веза у његовим одговорима упућивало је другде и занемарено је."

