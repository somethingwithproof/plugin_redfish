#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Проверите свежину прикупљања и графиконе уређаја. Поновни покушај уклања блокаду прикупљања за следеће заказано покретање; не контактира BMC одмах."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Датотека је празна или већа од 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Датотеку није могуће прочитати."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Датотека нема ред заглавља."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Датотека садржи колону под називом \"%s\". Датотеке за увоз не смеју да садрже тајне; уместо тога наведите назив сачуваног акредитива у колони credential. Ништа није увезено."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Заглавље мора да садржи само ове колоне, сваку по једном, укључујући name, address и credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Датотека има више од %d редова."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Линија %d: очекивано је %d поља, пронађено %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Акредитив: не постоји сачувани акредитив под називом \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Линија %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Линија %d: адреса %s, порт %d је већ регистрована као %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "линија %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Линија %d: назив %s се већ користи."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Линија %d: ниједан Cacti уређај нема ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Линија %d: уређај %d већ има BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "из линије %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Датотека нема редова са BMC записима."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Назив: унесите од 1 до 100 знакова без контролних знакова."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Адреса: унесите само име хоста или IP адресу, без шеме, порта, путање или корисничког имена. Loopback, link-local, multicast и неодређене адресе се одбијају."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Порт: унесите TCP порт од 1 до 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Полер: само главни полер може да прикупља BMC податке у овом издању."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Уређај: изаберите Cacti уређај или ниједан."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Акредитив: изаберите сачувани акредитив."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS провера: изаберите један од наведених режима."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Датотека CA пакета: унесите апсолутну путању без контролних знакова, највише 512 знакова."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Качење јавног кључа: унесите base64 SHA-256 хеш јавног кључа BMC-а, опционо са префиксом sha256//."

