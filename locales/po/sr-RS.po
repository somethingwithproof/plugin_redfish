#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Још нема акредитива. Креирајте један са BMC налогом само за читање."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "Није сачувана"

#: lib/CredentialsPage.php
