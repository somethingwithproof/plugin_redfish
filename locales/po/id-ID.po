#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Berkas kunci brankas tidak dapat digunakan: %s. Kata sandi tersimpan tidak dapat dibaca atau ditulis hingga masalah ini diperbaiki."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Kolektor pada poller %d memerlukan waktu %.0f detik, melebihi batas waktunya sebesar %d detik."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Kolektor pada poller %d kehabisan waktu sebelum semua BMC selesai dibaca; sisanya akan dilanjutkan pada proses berikutnya. Tambahkan worker atau naikkan batas waktu."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Kolektor pada poller %d terakhir berjalan %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: verifikasi TLS nonaktif. Siapa pun di jalur jaringan dapat membaca lalu lintasnya, termasuk kata sandi BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: menggunakan autentikasi Basic karena BMC tidak menyediakan layanan sesi; setiap permintaan membawa kata sandi."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: sesi mungkin masih terbuka pada BMC; proses berikutnya akan menghapusnya setelah masuk."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d proses masuk sesi berturut-turut kehilangan responsnya, sehingga proses masuk dihentikan. Periksa daftar sesi BMC, lalu gunakan Coba Lagi Sekarang."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC menolak kredensial tersebut. Kredensial tidak akan dicoba lagi hingga diubah."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: kredensialnya tidak ada atau tidak memiliki kata sandi tersimpan."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d tautan dalam responsnya mengarah ke tempat lain dan diabaikan."

