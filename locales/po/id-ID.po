#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Periksa kesegaran pengumpulan data dan grafik perangkat. Coba ulang akan melepaskan penangguhan pengumpulan untuk eksekusi terjadwal berikutnya; tindakan ini tidak menghubungi BMC sekarang."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Berkas kosong atau lebih besar dari 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Berkas tidak dapat dibaca."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Berkas tidak memiliki baris tajuk."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Berkas memiliki kolom bernama \"%s\". Berkas impor tidak boleh membawa rahasia; sebutkan nama kredensial yang tersimpan di kolom credential sebagai gantinya. Tidak ada yang diimpor."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Tajuk harus mencantumkan kolom-kolom ini saja, masing-masing satu kali, termasuk name, address, dan credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Berkas memiliki lebih dari %d baris."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Baris %d: diharapkan %d bidang, ditemukan %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Kredensial: tidak ada kredensial tersimpan yang bernama \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Baris %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Baris %d: alamat %s port %d sudah terdaftar sebagai %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "baris %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Baris %d: nama %s sudah digunakan."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Baris %d: tidak ada perangkat Cacti dengan ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Baris %d: perangkat %d sudah memiliki BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "dari baris %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Berkas tidak memiliki baris BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nama: masukkan 1 hingga 100 karakter tanpa karakter kontrol."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Alamat: masukkan hanya nama host atau alamat IP, tanpa skema, port, jalur, atau nama pengguna. Alamat loopback, link-local, multicast, dan tidak ditentukan ditolak."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: masukkan port TCP dari 1 hingga 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: hanya poller utama yang dapat mengumpulkan BMC pada rilis ini."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Perangkat: pilih perangkat Cacti atau tidak ada."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Kredensial: pilih kredensial yang tersimpan."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Verifikasi TLS: pilih salah satu mode yang tercantum."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Berkas Bundel CA: masukkan jalur absolut tanpa karakter kontrol, maksimal 512 karakter."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin Kunci Publik: masukkan hash SHA-256 base64 dari kunci publik BMC, secara opsional diawali dengan sha256//."

