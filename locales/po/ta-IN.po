msgstr "உறுதிப்படுத்துவதால் சேர்க்கப்படுபவை:"

#: lib/BmcsPage.php
msgid "Existing devices, graphs, and thresholds are not changed."
msgstr "ஏற்கனவே உள்ள சாதனங்கள், வரைபடங்கள் மற்றும் வரம்புகள் மாற்றப்படாது."

#: lib/BmcsPage.php
msgid "Confirm"
msgstr "உறுதிப்படுத்து"

#: lib/BmcsPage.php
msgid "Cancel"
msgstr "ரத்து செய்"

#: lib/BmcsPage.php
msgid "Import BMCs"
msgstr "BMC களை இறக்குமதி செய்"

#: lib/BmcsPage.php
msgid "CSV File"
msgstr "CSV கோப்பு"

#: lib/BmcsPage.php
#, php-format
msgid "Header row with columns: %s. Name a stored credential; never put a password in the file. Every row must be valid or nothing is imported."
msgstr "நெடுவரிசைகளுடன் கூடிய தலைப்பு வரிசை: %s. சேமிக்கப்பட்ட நற்சான்றிதழின் பெயரைக் குறிப்பிடவும்; கோப்பில் ஒருபோதும் கடவுச்சொல்லை வைக்க வேண்டாம். ஒவ்வொரு வரிசையும் செல்லுபடியாக வேண்டும், இல்லையெனில் எதுவும் இறக்குமதி செய்யப்படாது."

#: lib/BmcsPage.php
msgid "Import"
msgstr "இறக்குமதி"

#: lib/BmcsPage.php
msgid "Choose a credential"
msgstr "ஒரு நற்சான்றிதழைத் தேர்ந்தெடுக்கவும்"

#: lib/BmcsPage.php
msgid "None"
msgstr "ஏதுமில்லை"

#: lib/BmcsPage.php
#, php-format
msgid "Deleted device (ID %d)"
msgstr "நீக்கப்பட்ட சாதனம் (ID %d)"

#: lib/BmcsPage.php
msgid "New Redfish BMC"
msgstr "புதிய Redfish BMC"

#: lib/BmcsPage.php
#, php-format
msgid "Redfish BMC: %s"
msgstr "Redfish BMC: %s"

#: lib/BmcsPage.php
msgid "Host name or IP address of the BMC, without https:// or a path."
msgstr "https:// அல்லது பாதை இல்லாமல் BMC இன் புரவலன் பெயர் அல்லது IP முகவரி."

#: lib/BmcsPage.php
msgid "Do not verify is logged when set and shown as a warning on the health page while it stays."
msgstr "சரிபார்க்க வேண்டாம் என்பது அமைக்கப்படும்போது பதிவு செய்யப்பட்டு, அது இருக்கும் வரை நலன் பக்கத்தில் எச்சரிக்கையாகக் காட்டப்படும்."

#: lib/BmcsPage.php
msgid "CA Bundle File"
msgstr "CA தொகுப்புக் கோப்பு"

#: lib/BmcsPage.php
msgid "For the CA bundle mode: absolute path on the poller to a PEM file that others cannot write."
msgstr "CA தொகுப்பு முறைக்கு: பிறரால் எழுத முடியாத PEM கோப்பிற்கான போலரில் உள்ள முழுமையான பாதை."

#: lib/BmcsPage.php
msgid "For the pinned mode: base64 SHA-256 of the BMC public key, as sha256//... or the bare hash. A changed key fails until this is updated."
msgstr "பின் செய்யப்பட்ட முறைக்கு: sha256//... அல்லது வெறும் ஹாஷ் வடிவில் BMC பொது விசையின் base64 SHA-256. இது புதுப்பிக்கப்படும் வரை மாற்றப்பட்ட விசை தோல்வியடையும்."

#: lib/BmcsPage.php
msgid "Public Key Pin"
msgstr "பொது விசை பின்"

#: lib/BmcsPage.php
msgid "Allow Basic Authentication Fallback"
msgstr "Basic அங்கீகார மாற்று முறையை அனுமதி"

#: lib/BmcsPage.php
msgid "Used only when the BMC offers no session service. Every request then carries the password; the health page warns while it is in use."
msgstr "BMC அமர்வு சேவையை வழங்காதபோது மட்டுமே பயன்படுத்தப்படும். அப்போது ஒவ்வொரு கோரிக்கையும் கடவுச்சொல்லைக் கொண்டு செல்லும்; இது பயன்பாட்டில் இருக்கும்போது நலன் பக்கம் எச்சரிக்கும்."

#: lib/BmcsPage.php
msgid "The Cacti device of the server this BMC manages. Leave it at none to have the plugin create a device from the list."
msgstr "இந்த BMC நிர்வகிக்கும் சேவையகத்தின் Cacti சாதனம். பட்டியலிலிருந்து செருகுநிரல் ஒரு சாதனத்தை உருவாக்க, இதை எதுவுமில்லை என்பதில் விடவும்."

#: lib/BmcsPage.php lib/CredentialsPage.php
msgid "Save"
msgstr "சேமி"

#: lib/BmcsPage.php
#, php-format
msgid "Address: %s port %d is already registered as %s."
msgstr "முகவரி: %s போர்ட் %d ஏற்கனவே %s ஆகப் பதிவு செய்யப்பட்டுள்ளது."

#: lib/BmcsPage.php
msgid "Address: this address and port are already registered."
msgstr "முகவரி: இந்த முகவரியும் போர்ட்டும் ஏற்கனவே பதிவு செய்யப்பட்டுள்ளன."

#: lib/BmcsPage.php
msgid "Name: another BMC already uses this name."
msgstr "பெயர்: மற்றொரு BMC ஏற்கனவே இந்தப் பெயரைப் பயன்படுத்துகிறது."

#: lib/BmcsPage.php
msgid "Device: no Cacti device has this ID."
msgstr "சாதனம்: இந்த ID கொண்ட Cacti சாதனம் எதுவும் இல்லை."

