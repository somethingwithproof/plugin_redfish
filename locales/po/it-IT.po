msgstr "Impossibile utilizzare il file della chiave del vault: %s. Le password memorizzate non possono essere lette né scritte finché il problema non viene risolto."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Il raccoglitore sul poller %d ha impiegato %.0f secondi, superando il limite di %d secondi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Il raccoglitore sul poller %d ha esaurito il tempo prima di leggere tutti i BMC; i rimanenti riprenderanno all'esecuzione successiva. Aggiungere worker o aumentare il limite di tempo."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Ultima esecuzione del raccoglitore sul poller %d: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: la verifica TLS è disattivata. Chiunque lungo il percorso può leggere il traffico, inclusa la password del BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: utilizza l'autenticazione Basic perché il BMC non offre un servizio di sessione; ogni richiesta trasporta la password."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: una sessione potrebbe essere rimasta aperta sul BMC; l'esecuzione successiva la eliminerà dopo l'accesso."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d accessi di sessione consecutivi hanno perso la risposta, pertanto gli accessi sono stati interrotti. Verificare l'elenco delle sessioni del BMC, quindi utilizzare Riprova ora."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: il BMC ha rifiutato la credenziale. Non verrà riprovata finché la credenziale non cambia."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: la credenziale è mancante o non ha alcuna password memorizzata."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d collegamenti nelle risposte puntavano altrove e sono stati ignorati."

