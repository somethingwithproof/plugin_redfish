#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Verificare l'aggiornamento della raccolta e i grafici del dispositivo. Riprova rilascia il blocco della raccolta per la prossima esecuzione pianificata; non contatta il BMC adesso."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Il file è vuoto o supera 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Impossibile leggere il file."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Il file non ha una riga di intestazione."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Il file contiene una colonna denominata \"%s\". I file di importazione non devono contenere segreti; indicare invece il nome di una credenziale salvata nella colonna credential. Nulla è stato importato."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "L'intestazione deve indicare solo queste colonne, ciascuna una sola volta, includendo name, address e credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Il file contiene più di %d righe."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Riga %d: previsti %d campi, trovati %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Credenziale: nessuna credenziale salvata è denominata \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Riga %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Riga %d: l'indirizzo %s porta %d è già registrato come %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "riga %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Riga %d: il nome %s è già utilizzato."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Riga %d: nessun dispositivo Cacti ha ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Riga %d: il dispositivo %d ha già il BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "della riga %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Il file non contiene righe BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Nome: inserire da 1 a 100 caratteri senza caratteri di controllo."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Indirizzo: inserire solo un nome host o un indirizzo IP, senza schema, porta, percorso o nome utente. Gli indirizzi di loopback, link-local, multicast e non specificati vengono rifiutati."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Porta: inserire una porta TCP da 1 a 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: solo il poller principale può eseguire la raccolta dei BMC in questa versione."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Dispositivo: scegliere un dispositivo Cacti oppure nessuno."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Credenziale: scegliere una credenziale memorizzata."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Verifica TLS: scegliere una delle modalità elencate."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "File bundle CA: inserire un percorso assoluto senza caratteri di controllo, di al massimo 512 caratteri."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pin chiave pubblica: inserire l'hash SHA-256 in base64 della chiave pubblica del BMC, facoltativamente preceduto da sha256//."

