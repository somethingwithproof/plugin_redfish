msgstr "Đã xóa BMC và dữ liệu đệm của nó. Thiết bị Cacti của nó vẫn được giữ nguyên."

#: redfish_bmcs.php
msgid "Backoff and held failures were cleared; the collector reads the BMC on its next run."
msgstr "Đã xóa thời gian giãn thử lại và các lỗi đang giữ; bộ thu thập sẽ đọc BMC ở lần chạy tiếp theo."

#: redfish_bmcs.php
