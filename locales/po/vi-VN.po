#: redfish_bmcs.php
msgid "The device of this BMC was deleted. Choose another device, or none, on the BMC form first."
msgstr "Thiết bị của BMC này đã bị xóa. Trước tiên hãy chọn thiết bị khác hoặc không chọn thiết bị nào trên biểu mẫu BMC."

#: redfish_bmcs.php
#, php-format
msgid "The data queries were indexed again and %d graphs were added."
msgstr "Các truy vấn dữ liệu đã được lập chỉ mục lại và đã thêm %d biểu đồ."

#: redfish_bmcs.php
msgid "The device was created with its Redfish graphs."
msgstr "Thiết bị đã được tạo cùng các biểu đồ Redfish của nó."

#: redfish_bmcs.php
msgid "Installing the Redfish templates needs Cacti's Import Templates permission."
msgstr "Việc cài đặt các mẫu Redfish cần có quyền Nhập mẫu (Import Templates) của Cacti."

