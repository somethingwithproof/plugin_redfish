#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Kiểm tra độ mới của dữ liệu thu thập và biểu đồ thiết bị. Thử lại sẽ giải phóng trạng thái tạm giữ thu thập cho lần chạy theo lịch tiếp theo; thao tác này không kết nối tới BMC ngay bây giờ."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Tệp trống hoặc lớn hơn 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Không thể đọc tệp."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Tệp không có hàng tiêu đề."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Tệp có cột tên là \"%s\". Tệp nhập không được chứa thông tin bí mật; hãy chỉ định tên thông tin xác thực đã lưu trong cột thông tin xác thực để thay thế. Không có gì được nhập."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Tiêu đề chỉ được đặt tên các cột này, mỗi cột một lần, bao gồm name, address và credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Tệp có nhiều hơn %d hàng."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Dòng %d: dự kiến %d trường, tìm thấy %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Thông tin xác thực: không có thông tin xác thực đã lưu nào có tên \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Dòng %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Dòng %d: địa chỉ %s cổng %d đã được đăng ký với tên %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "dòng %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Dòng %d: tên %s đã được sử dụng."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Dòng %d: không có thiết bị Cacti nào có ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Dòng %d: thiết bị %d đã có BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "của dòng %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Tệp không có hàng BMC nào."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Tên: nhập từ 1 đến 100 ký tự không chứa ký tự điều khiển."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Địa chỉ: chỉ nhập tên máy chủ hoặc địa chỉ IP, không kèm giao thức, cổng, đường dẫn hoặc tên người dùng. Các địa chỉ loopback, link-local, multicast và địa chỉ không xác định sẽ bị từ chối."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Cổng: nhập cổng TCP từ 1 đến 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: chỉ poller chính mới có thể thu thập dữ liệu BMC trong bản phát hành này."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Thiết bị: chọn một thiết bị Cacti hoặc không chọn."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Thông tin xác thực: chọn một thông tin xác thực đã lưu."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Xác minh TLS: chọn một trong các chế độ được liệt kê."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Tệp gói CA: nhập đường dẫn tuyệt đối không chứa ký tự điều khiển, tối đa 512 ký tự."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Ghim khóa công khai: nhập mã băm SHA-256 dạng base64 của khóa công khai BMC, có thể có tiền tố sha256//."

