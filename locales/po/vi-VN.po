msgstr "Được lưu ở dạng mã hóa bằng khóa vault."

#: lib/DeviceProvisioner.php
msgid "The Redfish templates are not installed completely. Reinstall them from the Redfish BMCs page."
msgstr "Các mẫu Redfish chưa được cài đặt đầy đủ. Hãy cài đặt lại từ trang Các BMC Redfish."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off. Its host name is a reserved name that is never contacted."
msgstr "Một thiết bị \"%s\" từ mẫu thiết bị %s, được poller %d thăm dò, với kiểm tra tính sẵn sàng đang tắt. Tên máy chủ của nó là tên dành riêng và không bao giờ được liên hệ."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", with a graph for each of the %d members known now."
msgstr "Truy vấn dữ liệu \"%s\", kèm một biểu đồ cho từng thành phần trong số %d thành phần đã biết hiện tại."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d fans or power supplies that were present are no longer reported. They count as failed until you confirm; confirming accepts the members the BMC reports now."
msgstr "%d quạt hoặc bộ nguồn từng hiện diện không còn được báo cáo nữa. Chúng được tính là lỗi cho đến khi bạn xác nhận; việc xác nhận sẽ chấp nhận các thành phần mà BMC báo cáo hiện tại."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The graph \"%s\", with its \"%s\" data source."
msgstr "Biểu đồ \"%s\", cùng nguồn dữ liệu \"%s\" của nó."

#: lib/DeviceProvisioner.php
msgid "The BMC is already mapped to a device."
msgstr "BMC đã được ánh xạ tới một thiết bị."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Redfish plugin for BMC %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Được tạo bởi plugin Redfish cho BMC %s. Giá trị của thiết bị lấy từ bộ nhớ đệm của plugin; tên máy chủ là tên dành riêng và không bao giờ được liên hệ."

#: lib/DeviceProvisioner.php
msgid "Cacti refused to create the device. See the Cacti log."
msgstr "Cacti đã từ chối tạo thiết bị. Xem nhật ký Cacti."

#: lib/DeviceProvisioner.php
msgid "The new device would be hidden from you by your device permissions, so it was removed again. Ask an administrator to grant access, or map the BMC to a device you can see."
msgstr "Thiết bị mới sẽ bị ẩn khỏi bạn do quyền thiết bị của bạn, nên nó đã bị xóa lại. Hãy yêu cầu quản trị viên cấp quyền truy cập, hoặc ánh xạ BMC tới một thiết bị mà bạn có thể xem."

#: lib/DeviceProvisioner.php
msgid "The BMC was mapped to a device by someone else meanwhile, or could not be mapped, so the new device was removed again. Reload the page and check its mapping."
msgstr "Trong lúc đó BMC đã được người khác ánh xạ tới một thiết bị, hoặc không thể ánh xạ, nên thiết bị mới đã bị xóa lại. Hãy tải lại trang và kiểm tra ánh xạ của nó."

#: lib/DeviceWarnings.php
#, php-format
msgid "The Redfish templates could not be installed: %s"
msgstr "Không thể cài đặt các mẫu Redfish: %s"

#: lib/DeviceWarnings.php
msgid "The Redfish templates are not installed or not current. Reinstall them from the Redfish BMCs page."
msgstr "Các mẫu Redfish chưa được cài đặt hoặc không phải bản mới nhất. Hãy cài đặt lại từ trang Các BMC Redfish."

#: lib/DeviceWarnings.php
#, php-format
msgid "%s: its Cacti device was deleted. Map it to another device or create one from the BMCs page."
msgstr "%s: thiết bị Cacti của nó đã bị xóa. Hãy ánh xạ tới thiết bị khác hoặc tạo mới từ trang các BMC."

#: lib/DeviceWarnings.php
#, php-format
msgid "%s: its device is polled by poller %d but the BMC is read by poller %d. Move one of them so both use the same poller, or its graphs can read as unknown."
msgstr "%s: thiết bị của nó được thăm dò bởi poller %d nhưng BMC lại được đọc bởi poller %d. Hãy chuyển một trong hai để cả hai dùng cùng một poller, nếu không biểu đồ có thể hiển thị giá trị không xác định."

