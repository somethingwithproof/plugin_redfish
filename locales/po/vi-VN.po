msgstr "Không thể cài đặt các mẫu Redfish. Trang tình trạng sẽ hiển thị lý do."

#: redfish_bmcs.php
msgid "The import could not be saved; nothing was imported."
msgstr "Không thể lưu dữ liệu nhập; không có gì được nhập."

