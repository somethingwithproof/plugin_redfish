#: lib/Settings.php
msgid "Credential Vault"
msgstr "Kho thông tin xác thực"

#: lib/Settings.php
msgid "Vault Key File"
msgstr "Tệp khóa kho bảo mật"

#: lib/Settings.php
msgid "Absolute path to the 32-byte key that encrypts stored BMC passwords. Create it yourself, outside the web root, readable only by the web server and poller user, in a directory that only root and that user can write; the plugin never creates or writes it. Back it up with the database: without it, stored passwords must be entered again."
msgstr "Đường dẫn tuyệt đối đến khóa 32 byte dùng để mã hóa mật khẩu BMC đã lưu. Hãy tự tạo khóa này bên ngoài thư mục gốc web, chỉ cho phép người dùng máy chủ web và poller đọc, trong thư mục mà chỉ root và người dùng đó có quyền ghi; plugin không bao giờ tạo hoặc ghi tệp này. Hãy sao lưu nó cùng cơ sở dữ liệu: nếu mất khóa, bạn sẽ phải nhập lại các mật khẩu đã lưu."

#: lib/Settings.php
msgid "Collector"
msgstr "Trình thu thập"

#: lib/Settings.php
msgid "Collection Interval"
msgstr "Khoảng thời gian thu thập"

#: lib/Settings.php
msgid "Seconds between reads of each BMC."
msgstr "Số giây giữa các lần đọc của mỗi BMC."

#: lib/Settings.php
msgid "Rediscovery Interval"
msgstr "Chu kỳ phát hiện lại"

#: lib/Settings.php
msgid "Seconds between full resource discoveries of each BMC. A BMC is also rediscovered at once when a known resource disappears or changes type."
msgstr "Số giây giữa các lần phát hiện tài nguyên đầy đủ của mỗi BMC. BMC cũng được phát hiện lại ngay lập tức khi một tài nguyên đã biết biến mất hoặc thay đổi loại."

#: lib/Settings.php
msgid "Collector Time Budget"
msgstr "Giới hạn thời gian trình thu thập"

#: lib/Settings.php
msgid "Seconds one collector run may spend before it stops starting new BMCs. Keep it below the poller interval; unfinished BMCs resume on the next run."
msgstr "Số giây tối đa một lần chạy bộ thu thập được phép dùng trước khi ngừng bắt đầu đọc các BMC mới. Hãy giữ giá trị này thấp hơn chu kỳ poller; các BMC chưa hoàn tất sẽ tiếp tục ở lần chạy sau."

#: lib/Settings.php
msgid "BMCs read in parallel. Each BMC is read by one worker at a time."
msgstr "Số BMC được đọc song song. Mỗi BMC được một worker đọc tại một thời điểm."

#: lib/Settings.php
msgid "Collector Workers"
msgstr "Worker bộ thu thập"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Thời gian chờ kết nối"

#: lib/Settings.php
msgid "Seconds allowed for the TCP connection and TLS handshake to a BMC."
msgstr "Số giây tối đa cho phép đối với kết nối TCP và bắt tay TLS tới một BMC."

#: lib/Settings.php
msgid "Request Timeout"
msgstr "Thời gian chờ yêu cầu"

#: lib/Settings.php
msgid "Seconds allowed for one whole request to a BMC, including the connection."
msgstr "Số giây tối đa cho phép đối với toàn bộ một yêu cầu tới BMC, bao gồm cả thời gian kết nối."

#: lib/Settings.php
msgid "KiB accepted in one BMC response body; a larger response is refused."
msgstr "Số KiB được chấp nhận trong một phần thân phản hồi BMC; phản hồi lớn hơn sẽ bị từ chối."

#: lib/Settings.php
msgid "Maximum Response Size"
msgstr "Kích thước phản hồi tối đa"

#: lib/Settings.php
msgid "Freshness"
msgstr "Độ mới"

#: lib/Settings.php
msgid "Collection intervals after which a reading is shown as delayed."
msgstr "Số chu kỳ thu thập mà sau đó giá trị đo được hiển thị là bị trễ."

#: lib/Settings.php
msgid "Delayed After"
msgstr "Bị trễ sau"

#: lib/Settings.php
msgid "Collection intervals after which a reading is stale and reads as unknown. Always at least one more than Delayed After."
msgstr "Số chu kỳ thu thập mà sau đó giá trị đo trở nên cũ và được đọc là không xác định. Luôn lớn hơn giá trị Bị trễ sau ít nhất 1."

#: lib/Settings.php
msgid "Stale After"
msgstr "Cũ sau"

#: lib/Settings.php
msgid "Uninstall"
msgstr "Gỡ cài đặt"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Giữ các bảng của plugin khi gỡ cài đặt"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its BMC registry, encrypted passwords, and reading cache. Clear it to have the uninstall drop them. Uninstall never touches Cacti devices, graphs, or BMCs, including devices the plugin created."
msgstr "Khi được chọn, việc gỡ cài đặt plugin sẽ giữ lại sổ đăng ký BMC, mật khẩu đã mã hóa và bộ nhớ đệm giá trị đo. Bỏ chọn để quá trình gỡ cài đặt xóa chúng. Việc gỡ cài đặt không bao giờ chạm vào các thiết bị Cacti, biểu đồ hoặc BMC, bao gồm cả các thiết bị do plugin tạo."

#: lib/TlsMode.php
msgid "Verify against the system CA store"
msgstr "Xác minh theo kho CA hệ thống"

#: lib/TlsMode.php
msgid "Verify against a CA bundle file"
msgstr "Xác minh theo tệp gói CA"

#: lib/TlsMode.php
msgid "Pinned public key (SHA-256)"
msgstr "Khóa công khai đã ghim (SHA-256)"

#: lib/TlsMode.php
msgid "Do not verify (unsafe)"
msgstr "Không xác minh (không an toàn)"

