#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Không thể sử dụng tệp khóa vault: %s. Không thể đọc hoặc ghi mật khẩu đã lưu cho đến khi lỗi này được khắc phục."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Bộ thu thập trên poller %d mất %.0f giây, vượt quá mức giới hạn %d giây."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Bộ thu thập trên poller %d đã hết thời gian trước khi đọc hết mọi BMC; phần còn lại sẽ tiếp tục ở lần chạy sau. Hãy thêm worker hoặc tăng thời gian cho phép."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Bộ thu thập trên poller %d chạy lần cuối vào %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: xác minh TLS đang tắt. Bất kỳ ai trên đường truyền đều có thể đọc lưu lượng của nó, bao gồm cả mật khẩu BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: sử dụng xác thực Basic vì BMC không cung cấp dịch vụ phiên; mọi yêu cầu đều mang theo mật khẩu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: một phiên có thể vẫn đang mở trên BMC; lần chạy tiếp theo sẽ xóa phiên đó sau khi đăng nhập."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: %d lần đăng nhập phiên liên tiếp bị mất phản hồi nên quá trình đăng nhập đã dừng. Hãy kiểm tra danh sách phiên trên BMC, sau đó dùng Thử lại ngay."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC đã từ chối thông tin xác thực. Hệ thống sẽ không thử lại cho đến khi thông tin xác thực thay đổi."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: thông tin xác thực bị thiếu hoặc chưa lưu mật khẩu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d liên kết trong phản hồi trỏ đến nơi khác và đã bị bỏ qua."

