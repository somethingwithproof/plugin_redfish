#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "収集の鮮度とデバイスグラフを確認してください。再試行を実行すると次回スケジュール実行時の収集保留が解除されますが、今すぐ BMC に接続するわけではありません。"

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "ファイルが空であるか、1 MiB を超えています。"

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "ファイルを読み取れませんでした。"

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "ファイルにヘッダー行がありません。"

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "ファイルに「%s」という名前の列があります。インポートファイルにシークレットを含めることはできません。代わりに credential 列に保存済み認証情報の名前を指定してください。インポートは行われませんでした。"

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "ヘッダーには name、address、credential を含め、これらの列のみをそれぞれ 1 回ずつ指定する必要があります: %s。"

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "ファイルの行数が %d 行を超えています。"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "%d 行目: %d 個のフィールドが必要ですが、%d 個見つかりました。"

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "認証情報: 「%s」という名前の保存済み認証情報はありません。"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "%d 行目: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "%d 行目: アドレス %s ポート %d はすでに %s として登録されています。"

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "%d 行目"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "%d 行目: 名前 %s はすでに使用されています。"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "%d 行目: ID %d の Cacti デバイスは存在しません。"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "%d 行目: デバイス %d にはすでに BMC %s が設定されています。"

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "(%d 行目)"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "ファイルに BMC の行がありません。"

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "名前: 制御文字を含まない 1 ～ 100 文字を入力してください。"

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "アドレス: スキーム、ポート、パス、ユーザー名を含めず、ホスト名または IP アドレスのみを入力してください。ループバック、リンクローカル、マルチキャスト、未指定アドレスは拒否されます。"

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "ポート: 1 〜 65535 の TCP ポートを入力してください。"

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "ポーラー: このリリースではメインポーラーのみが BMC を収集できます。"

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "デバイス: Cacti デバイスを選択するか、「なし」を選択してください。"

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "認証情報: 保存済み認証情報を選択してください。"

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "TLS 検証: 一覧にあるモードのいずれかを選択してください。"

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA バンドルファイル: 制御文字を含まない 512 文字以内の絶対パスを入力してください。"

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "公開鍵ピン: BMC 公開鍵の base64 SHA-256 ハッシュを入力してください (先頭に sha256// を付けることもできます)。"

