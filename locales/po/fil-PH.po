msgstr "Huling tumakbo ang collector sa poller %d noong %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: naka-off ang pag-verify ng TLS. Maaaring basahin ng sinuman sa daanan ang trapiko nito, kabilang ang password ng BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: gumagamit ng Basic authentication dahil walang inaalok na session service ang BMC; may dalang password ang bawat kahilingan."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: maaaring naiwang bukas ang isang session sa BMC; tatanggalin ito ng susunod na pagtakbo pagkatapos mag-log in."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: nawalan ng tugon ang %d sunud-sunod na pag-log in sa session, kaya huminto ang mga pag-log in. Suriin ang listahan ng session ng BMC, pagkatapos ay gamitin ang Subukan Muli Ngayon."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: tinanggihan ng BMC ang credential. Hindi na ito susubukan muli hanggang sa magbago ang credential."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: its credential is missing or has no stored password."
msgstr "%s: nawawala ang credential nito o walang nakaimbak na password."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d links in its responses pointed elsewhere and were ignored."
msgstr "%s: %d mga link sa mga tugon nito ay nakaturo sa ibang lugar at hindi pinansin."

