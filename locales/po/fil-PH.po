#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Suriin ang pagiging bago ng koleksyon at ang mga graph ng device. Inaalis ng Subukan Muli ang pagpigil sa koleksyon para sa susunod na nakatakdang pagtakbo; hindi nito kinokontak ang BMC ngayon."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Walang laman ang file o mas malaki ito sa 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Hindi mabasa ang file."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Walang header row ang file."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "May column ang file na pinangalanang \"%s\". Hindi dapat magdala ng mga lihim ang mga import file; sa halip, pangalanan ang isang nakaimbak na kredensyal sa column na credential. Walang na-import."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Dapat pangalanan lamang ng header ang mga column na ito, bawat isa nang isang beses, kasama ang name, address, at credential: %s."

