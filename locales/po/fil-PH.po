#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Pangalan: maglagay ng 1 hanggang 100 character na walang mga control character."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Address: maglagay lamang ng host name o IP address, nang walang scheme, port, path, o user name. Tinatanggihan ang mga loopback, link-local, multicast, at hindi tinukoy na address."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Port: maglagay ng TCP port mula 1 hanggang 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: ang pangunahing poller lamang ang maaaring mangolekta ng mga BMC sa release na ito."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Device: pumili ng Cacti device o wala."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Credential: pumili ng nakaimbak na credential."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Pag-verify ng TLS: pumili ng isa sa mga nakalistang mode."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "CA Bundle File: maglagay ng absolute path na walang mga control character, na hindi lalampas sa 512 character."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Public Key Pin: ilagay ang base64 SHA-256 hash ng pampublikong susi ng BMC, na opsyonal na may unlaping sha256//."

