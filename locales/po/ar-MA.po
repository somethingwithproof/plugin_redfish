#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "تحقق من حداثة الجمع والرسوم البيانية للجهاز. تحرر إعادة المحاولة تعليق الجمع للتشغيل المجدول التالي؛ ولا تتصل بـ BMC الآن."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "الملف فارغ أو أكبر من 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "تعذر قراءة الملف."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "لا يحتوي الملف على صف ترويسة."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "يحتوي الملف على عمود باسم \"%s\". يجب ألا تحمل ملفات الاستيراد أسراراً؛ حدد اسم بيانات اعتماد مخزنة في عمود بيانات الاعتماد بدلاً من ذلك. لم يتم استيراد أي شيء."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "يجب أن تسمّي الترويسة هذه الأعمدة فقط، كل عمود مرة واحدة، بما في ذلك name وaddress وcredential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "يحتوي الملف على أكثر من %d صف."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "السطر %d: المتوقع %d حقول، والموجود %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "بيانات الاعتماد: لا توجد بيانات اعتماد مخزنة باسم \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "السطر %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "السطر %d: العنوان %s المنفذ %d مسجل بالفعل كـ %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "السطر %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "السطر %d: الاسم %s مستعمل بالفعل."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "السطر %d: لا يوجد أي جهاز Cacti بالمعرّف %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "السطر %d: الجهاز %d لديه مسبقاً وحدة BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "من السطر %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "لا يحتوي الملف على أي أسطر BMC."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "الاسم: أدخل من 1 إلى 100 حرف دون أحرف تحكم."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "العنوان: أدخل اسم مضيف أو عنوان IP فقط، دون بروتوكول أو منفذ أو مسار أو اسم مستخدم. تُرفض عناوين الاسترجاع (loopback) والارتباط المحلي (link-local) والبث المتعدد (multicast) والعناوين غير المحددة."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "المنفذ: أدخل منفذ TCP من 1 إلى 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "المستطلع (Poller): يمكن للمستطلع الرئيسي فقط جمع بيانات وحدات BMC في هذا الإصدار."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "الجهاز: اختر جهاز Cacti أو لا شيء."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "بيانات الاعتماد: اختر بيانات اعتماد مخزنة."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "التحقق من TLS: اختر أحد الأوضاع المدرجة."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "ملف حزمة CA: أدخل مساراً مطلقاً بدون أحرف تحكم، بحد أقصى 512 حرفاً."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "تثبيت المفتاح العمومي: أدخل بصمة SHA-256 بصيغة base64 للمفتاح العمومي لوحدة BMC، مع البادئة sha256// اختيارياً."

