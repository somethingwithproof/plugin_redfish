#: lib/CredentialsPage.php lib/Pages.php
msgid "Redfish Credentials"
msgstr "Àwọn Ìwé-ẹ̀rí Ìwọlé Redfish"

#: lib/CredentialsPage.php
msgid "Password"
msgstr "Ọ̀rọ̀-ìpamọ́"

#: lib/CredentialsPage.php
msgid "Used By"
msgstr "Ohun Tí Ó Ń Lò Ó"

#: lib/CredentialsPage.php
msgid "User Name"
msgstr "Orúkọ Olùmúlò"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Kò sí ìwé-ẹ̀rí ìwọlé kankan síbẹ̀. Ṣẹ̀dá ọ̀kan pẹ̀lú àkáùntì BMC kíkà-nìkan."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "Kò sí èyí tí a fi pamọ́"

#: lib/CredentialsPage.php
msgid "Stored"
msgstr "Tí a tọ́jú"

#: lib/CredentialsPage.php
#, php-format
msgid "%d BMCs"
msgstr "Àwọn BMC %d"

#: lib/CredentialsPage.php
msgid "New Redfish Credential"
msgstr "Ìwé-ẹ̀rí Ìwọlé Redfish Tuntun"

#: lib/CredentialsPage.php
#, php-format
msgid "Redfish Credential: %s"
msgstr "Ìwé-ẹ̀rí Ìwọlé Redfish: %s"

#: lib/CredentialsPage.php
msgid "A BMC account with the ReadOnly role. The plugin never needs a role that can change BMC state."
msgstr "Àkáùntì BMC kan pẹ̀lú ipa ReadOnly. Àfikún náà kò nílò ipa tí ó lè yí ipò BMC padà láéláé."

#: lib/CredentialsPage.php
msgid "A password is stored. Leave blank to keep it."
msgstr "A ti fi ọ̀rọ̀-ìpamọ́ kan pamọ́. Fi sí òfo láti pa á mọ́."

#: lib/CredentialsPage.php
msgid "Stored encrypted with the vault key."
msgstr "A fi pamọ́ ní ìṣàṣírí pẹ̀lú kọ́kọ́rọ́ vault."

#: lib/DeviceProvisioner.php
msgid "The Redfish templates are not installed completely. Reinstall them from the Redfish BMCs page."
msgstr "Àwọn àdàkọ Redfish kò tíì wà ní gbígbé sínú pátápátá. Tún wọn gbé sínú láti ojú-ewé Àwọn BMC Redfish."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off. Its host name is a reserved name that is never contacted."
msgstr "Ẹ̀rọ \"%s\" láti inú àdàkọ ẹ̀rọ %s, tí poller %d ń ṣe ìwádìí rẹ̀, pẹ̀lú àyẹ̀wò wíwà ní pípa. Orúkọ olùgbàlejò rẹ̀ jẹ́ orúkọ tí a yà sọ́tọ̀ tí a kì í kàn sí láéláé."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", with a graph for each of the %d members known now."
msgstr "Ìbéèrè dátà \"%s\", pẹ̀lú àwòrán-ìṣirò kan fún ọ̀kọ̀ọ̀kan àwọn ọmọ ẹgbẹ́ %d tí a mọ̀ báyìí."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d fans or power supplies that were present are no longer reported. They count as failed until you confirm; confirming accepts the members the BMC reports now."
msgstr "Àwọn fáànù tàbí ohun èlò agbára %d tí ó wà tẹ́lẹ̀ kò sí nínú ìròyìn mọ́. A kà wọ́n sí èyí tí ó kùnà títí ìwọ yóò fi fìdí rẹ̀ múlẹ̀; ìfìdí-múlẹ̀ yóò gba àwọn ọmọ ẹgbẹ́ tí BMC ń ròyìn báyìí."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The graph \"%s\", with its \"%s\" data source."
msgstr "Àwòrán-ìṣirò \"%s\", pẹ̀lú orísun dátà rẹ̀ \"%s\"."

#: lib/DeviceProvisioner.php
msgid "The BMC is already mapped to a device."
msgstr "BMC náà ti wà ní ìsopọ̀ mọ́ ẹ̀rọ kan tẹ́lẹ̀."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Redfish plugin for BMC %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Àfikún Redfish ni ó ṣẹ̀dá rẹ̀ fún BMC %s. Àwọn ìwọ̀n rẹ̀ ń wá láti inú ibi ìpamọ́ àfikún náà; orúkọ olùgbàlejò jẹ́ orúkọ tí a yà sọ́tọ̀ tí a kì í kàn sí láéláé."

#: lib/DeviceProvisioner.php
msgid "Cacti refused to create the device. See the Cacti log."
msgstr "Cacti kọ̀ láti ṣẹ̀dá ẹ̀rọ náà. Wo àkọsílẹ̀ Cacti."

#: lib/DeviceProvisioner.php
msgid "The new device would be hidden from you by your device permissions, so it was removed again. Ask an administrator to grant access, or map the BMC to a device you can see."
msgstr "Ẹ̀rọ tuntun náà yóò farapamọ́ fún ọ nítorí àwọn àṣẹ ẹ̀rọ rẹ, nítorí náà a yọ ọ́ kúrò lẹ́ẹ̀kan sí i. Béèrè lọ́wọ́ alákòóso láti fún ọ ní ààyè, tàbí so BMC náà mọ́ ẹ̀rọ tí o lè rí."

#: lib/DeviceProvisioner.php
msgid "The BMC was mapped to a device by someone else meanwhile, or could not be mapped, so the new device was removed again. Reload the page and check its mapping."
msgstr "Ẹlòmíràn ti so BMC náà mọ́ ẹ̀rọ kan ní àkókò náà, tàbí kò ṣeé so pọ̀, nítorí náà a yọ ẹ̀rọ tuntun náà kúrò lẹ́ẹ̀kan sí i. Tún ojú-ewé náà rù kí o sì ṣàyẹ̀wò ìsopọ̀ rẹ̀."

#: lib/DeviceWarnings.php
#, php-format
msgid "The Redfish templates could not be installed: %s"
msgstr "Àwọn àdàkọ Redfish kò ṣeé gbé sínú: %s"

#: lib/DeviceWarnings.php
msgid "The Redfish templates are not installed or not current. Reinstall them from the Redfish BMCs page."
msgstr "Àwọn àdàkọ Redfish kò sí nínú rẹ̀ tàbí wọn kò jẹ́ tuntun. Tún wọn gbé sínú láti ojú-ewé Àwọn BMC Redfish."

