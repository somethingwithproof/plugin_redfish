#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Ṣàyẹ̀wò ìjẹ́-tuntun àkójọpọ̀ àti àwọn àwòrán ẹ̀rọ. Àtúngbìyànjú ń tú ìdádúró àkójọpọ̀ sílẹ̀ fún ìṣiṣẹ́ tí a ṣètò tókàn; kò kàn sí BMC báyìí."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Fáìlì náà ṣófo tàbí ó tóbi ju 1 MiB lọ."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "A kò lè ka fáìlì náà."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Fáìlì náà kò ní ìlà àkọlé."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Fáìlì náà ní òpó tí a pè ní \"%s\". Àwọn fáìlì ìkówọlé kò gbọ́dọ̀ ní àṣírí; dárúkọ ìwé-ẹ̀rí tí a fi pamọ́ sínú òpó credential dípò rẹ̀. Kò sí ohun tí a kó wọlé."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Àkọlé gbọ́dọ̀ dárúkọ àwọn òpó wọ̀nyí nìkan, ọ̀kọ̀ọ̀kan lẹ́ẹ̀kan, pẹ̀lú name, address, àti credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Fáìlì náà ní ìlà tí ó pọ̀ ju %d lọ."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Ìlà %d: a retí pápá %d, a rí %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Ìwé-ẹ̀rí: kò sí ìwé-ẹ̀rí tí a fi pamọ́ tí a pè ní \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Ìlà %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Ìlà %d: àdírẹ́sì %s èbúté %d ti wà ní ìforúkọsílẹ̀ tẹ́lẹ̀ bíi %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "ìlà %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Ìlà %d: orúkọ %s ti wà ní lílò tẹ́lẹ̀."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Ìlà %d: kò sí ẹ̀rọ Cacti kankan tí ó ní ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Ìlà %d: ẹ̀rọ %d ti ní BMC %s tẹ́lẹ̀."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "ti ìlà %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Fáìlì náà kò ní àwọn ìlà BMC kankan."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Orúkọ: tẹ àmì-ìkọ̀wé 1 sí 100 láìsí àwọn àmì ìdarí."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Àdírẹ́sì: tẹ orúkọ olùgbàlejò tàbí àdírẹ́sì IP nìkan sínú rẹ̀, láìsí ìlànà ìjápọ̀, póòtù, ọ̀nà, tàbí orúkọ olùmúlò. Àwọn àdírẹ́sì loopback, link-local, multicast, àti àwọn tí a kò pàtó ni a máa kọ̀."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Póòtù: tẹ póòtù TCP kan láti 1 dé 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: poller àkọ́kọ́ nìkan ni ó lè kó àwọn BMC jọ nínú àtẹ̀jáde yìí."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Ẹ̀rọ: yan ẹ̀rọ Cacti kan tàbí kò sí."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Ìwé-ẹ̀rí ìwọlé: yan ìwé-ẹ̀rí ìwọlé tí a fi pamọ́ kan."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Ìfìdí-òdodo TLS: yan ọ̀kan nínú àwọn ìlànà tí a tò sílẹ̀."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Fáìlì Àkójọpọ̀ CA: tẹ ọ̀nà kíkún tí kò ní àwọn àmì ìṣàkóso sínú rẹ̀, tí kò ju àmì 512 lọ."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Ìdènà Kọ́kọ́rọ́ Gbangba: tẹ hàṣì SHA-256 base64 ti kọ́kọ́rọ́ gbangba BMC náà, pẹ̀lú àṣàyàn àkọ́bẹ̀rẹ̀ sha256//."

