msgstr "Izina ry'ukoresha"

#: lib/CredentialsPage.php
msgid "No credentials yet. Create one with a read-only BMC account."
msgstr "Nta myirondoro yo kwinjira iraboneka. Hanga umwe ukoresheje konti ya BMC yo gusoma gusa."

#: lib/CredentialsPage.php
msgid "None stored"
msgstr "Nta na kimwe kibitswe"

#: lib/CredentialsPage.php
