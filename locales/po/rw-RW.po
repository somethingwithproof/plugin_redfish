#: lib/HealthWarnings.php
#, php-format
msgid "The vault key file cannot be used: %s. Stored passwords cannot be read or written until it is fixed."
msgstr "Idosiye y'urufunguzo rw'ububiko ntishobora gukoreshwa: %s. Amagambobanga abitswe ntashobora gusomwa cyangwa kwandikwa kugeza igihe bikemutse."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d took %.0f seconds, more than its budget of %d seconds."
msgstr "Umukusanya uri kuri poller %d yamaze amasegonda %.0f, birenze igihe yagenewe cy'amasegonda %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d ran out of time before every BMC was read; the rest resume on the next run. Add workers or raise the budget."
msgstr "Umukusanya uri kuri poller %d yashiranywe n'igihe mbere y'uko buri BMC isomwa; izisigaye zizakomeza ku ikorwa rikurikira. Ongeramo abakozi (workers) cyangwa wongere igihe cyagenewe."

#: lib/HealthWarnings.php
#, php-format
msgid "The collector on poller %d last ran %s."
msgstr "Umukusanya uri kuri poller %d yaherukaga gukora %s."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: TLS verification is off. Anyone on the path can read its traffic, including the BMC password."
msgstr "%s: igenzura rya TLS rirafunze. Umuntu wese uri mu nzira ashobora gusoma amakuru yayo, harimo n'ijambobanga rya BMC."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: uses Basic authentication because the BMC offers no session service; every request carries the password."
msgstr "%s: ikoresha iyemeza rya Basic kubera ko BMC idatanga serivisi y'isomo (session); buri busabe buba bujyanye ijambobanga."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: a session may have been left open on the BMC; the next run deletes it after logging in."
msgstr "%s: isomo (session) rishobora kuba ryasigaye rifunguye kuri BMC; ikorwa rikurikira rizarisiba nyuma yo kwinjira."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d session logins in a row lost their response, so logins stopped. Check the BMC session list, then use Retry Now."
msgstr "%s: kwinjira mu isomo inshuro %d zikurikiranya kwabuze igisubizo, bityo kwinjira birahagarara. Genzura urutonde rw'amasomo rwa BMC, hanyuma ukoreshe Ongera ugerageze ubu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the BMC rejected the credential. It is not tried again until the credential changes."
msgstr "%s: BMC yanze umwirondoro wo kwinjira. Ntizongera kugeragezwa kugeza igihe umwirondoro uhindukiye."

#: lib/HealthWarnings.php
