#: include/operator.php
msgid "Check collection freshness and the device graphs. Retry releases a collection hold for the next scheduled run; it does not contact the BMC now."
msgstr "Suzuma ubushya bw'ikusanya n'ibishushanyo by'igikoresho. \"Ongera ugerageze\" irekura ihagarikwa ry'ikusanya ku gikorwa giteganyijwe gikurikira; ntihamagara BMC ubu."

#: lib/BmcImport.php
msgid "The file is empty or larger than 1 MiB."
msgstr "Dosiye irimo ubusa cyangwa iruta 1 MiB."

#: lib/BmcImport.php
msgid "The file could not be read."
msgstr "Dosiye ntiyashoboye gusomwa."

#: lib/BmcImport.php
msgid "The file has no header row."
msgstr "Dosiye nta murongo w'umutwe ifite."

#: lib/BmcImport.php
#, php-format
msgid "The file has a column named \"%s\". Import files must not carry secrets; name a stored credential in the credential column instead. Nothing was imported."
msgstr "Dosiye ifite inkingi yitwa \"%s\". Amadosiye yinjizwa ntagomba kugira amabanga; ahubwo vuga izina ry'ibyangombwa byo kwinjira bibitse mu nkingi ya credential. Nta cyinjijwe."

#: lib/BmcImport.php
#, php-format
msgid "The header must name only these columns, each once, including name, address, and credential: %s."
msgstr "Umutwe ugomba kuvuga gusa izi nkingi, buri imwe rimwe, harimo name, address, na credential: %s."

#: lib/BmcImport.php
#, php-format
msgid "The file has more than %d rows."
msgstr "Dosiye ifite imirongo irenga %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: expected %d fields, found %d."
msgstr "Umurongo %d: hateganijwe ibice %d, habonetse %d."

#: lib/BmcImport.php
#, php-format
msgid "Credential: no stored credential is named \"%s\"."
msgstr "Ibyangombwa byo kwinjira: nta byangombwa byo kwinjira bibitse byitwa \"%s\"."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: %s"
msgstr "Umurongo %d: %s"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the address %s port %d is already registered as %s."
msgstr "Umurongo %d: aderesi %s umuyoboro %d bisanzwe byanditswe nka %s."

#: lib/BmcImport.php
#, php-format
msgid "line %d"
msgstr "umurongo %d"

#: lib/BmcImport.php
#, php-format
msgid "Line %d: the name %s is already used."
msgstr "Umurongo wa %d: izina %s rirakoreshwa."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: no Cacti device has ID %d."
msgstr "Umurongo wa %d: nta gikoresho cya Cacti gifite ID %d."

#: lib/BmcImport.php
#, php-format
msgid "Line %d: device %d already has the BMC %s."
msgstr "Umurongo wa %d: igikoresho %d gisanzwe gifite BMC %s."

#: lib/BmcImport.php
#, php-format
msgid "of line %d"
msgstr "y'umurongo wa %d"

#: lib/BmcImport.php
msgid "The file has no BMC rows."
msgstr "Idosiye nta mirongo ya BMC ifite."

#: lib/BmcInput.php redfish_credentials.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Izina: injiza inyuguti kuva kuri 1 kugeza ku 100 nta nyuguti z'igenzura zirimo."

#: lib/BmcInput.php
msgid "Address: enter a host name or an IP address only, without a scheme, port, path, or user name. Loopback, link-local, multicast, and unspecified addresses are refused."
msgstr "Aderesi: andika izina rya mudasobwa (host name) cyangwa aderesi ya IP gusa, utashyizemo porotokole, umuyoboro (port), inzira, cyangwa izina ry'ukoresha. Aderesi za loopback, link-local, multicast, n'izitasobanuwe ntizemerwa."

#: lib/BmcInput.php
msgid "Port: enter a TCP port from 1 to 65535."
msgstr "Umuyoboro (Port): andika umuyoboro wa TCP kuva kuri 1 kugeza kuri 65535."

#: lib/BmcInput.php
msgid "Poller: only the main poller can collect BMCs in this release."
msgstr "Poller: poller nyamukuru yonyine ni yo ishobora gukusanya za BMC muri iyi verisiyo."

#: lib/BmcInput.php
msgid "Device: choose a Cacti device or none."
msgstr "Igikoresho: hitamo igikoresho cya Cacti cyangwa nta na kimwe."

#: lib/BmcInput.php lib/BmcsPage.php
msgid "Credential: choose a stored credential."
msgstr "Umwirondoro wo kwinjira: hitamo umwirondoro wabitswe."

#: lib/BmcInput.php
msgid "TLS Verification: choose one of the listed modes."
msgstr "Igenzura rya TLS: hitamo bumwe mu buryo bwavuzwe."

#: lib/BmcInput.php
msgid "CA Bundle File: enter an absolute path without control characters, at most 512 characters."
msgstr "Idosiye y'ishami rya CA: andika inzira yuzuye itarimo inyuguti zigenzura, itarengeje inyuguti 512."

#: lib/BmcInput.php
msgid "Public Key Pin: enter the base64 SHA-256 hash of the BMC public key, optionally prefixed with sha256//."
msgstr "Pini y'urufunguzo rusange: andika hash ya SHA-256 muri base64 y'urufunguzo rusange rwa BMC, ushobora kubanzirizaho sha256//."

